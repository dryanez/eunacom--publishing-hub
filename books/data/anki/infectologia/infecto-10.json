   "codigos": [
    "1.04.3.006"
   ]
  },
  {
   "id": "c34",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Cotrimoxazol protege además contra toxoplasma si CD4 < {{c1::100/mm³}} con IgG (+).",
   "extra": "",
   "origen": "libro:tabla",
   "fuente": "Libro · Tabla de profilaxis",
   "repaso": false,
   "codigos": [
    "1.04.3.006"
   ]
  },
  {
   "id": "c35",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "La profilaxis con cotrimoxazol se suspende con CD4 > 200 por ≥ {{c1::3 meses}} con TARV.",
