   "origen": "clase:10",
   "fuente": "Clase · CMV y criptococo",
   "repaso": false,
   "codigos": [
    "1.04.4.001"
   ]
  },
  {
   "id": "c33",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Profilaxis con cotrimoxazol forte 1 comp/día si CD4 < {{c1::200/mm³}}.",
   "extra": "",
   "origen": "libro:tabla",
   "fuente": "Libro · Tabla de profilaxis",
