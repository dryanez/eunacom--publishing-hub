   ]
  },
  {
   "id": "c31",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Colitis con dolor y hematoquezia y CD4 < 50: sospechar {{c1::CMV}}, que se trata con ganciclovir.",
   "extra": "",
   "origen": "clase:9",
   "fuente": "Clase · Candidiasis y diarrea",
   "repaso": false,
   "codigos": [
    "1.06.1.012"
   ]
  },
  {
   "id": "c32",
   "modelo": "cloze",
   "tipo": "Trampa",
   "texto": "Antigenemia de CMV positiva: {{c1::infección no es enfermedad}}; la retinitis o colitis requieren clínica o biopsia.",
