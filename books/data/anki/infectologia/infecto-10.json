   ]
  },
  {
   "id": "c37",
   "modelo": "cloze",
   "tipo": "Farmaco",
   "texto": "Con PPD ≥ 5 mm se da profilaxis de TBC con {{c1::isoniazida 300 mg/día + piridoxina}} por 9 meses.",
   "extra": "",
   "origen": "libro:tabla",
   "fuente": "Libro · Tabla de profilaxis",
   "repaso": false,
   "codigos": [
    "1.04.3.006"
   ]
  },
  {
