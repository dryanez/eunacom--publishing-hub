  },
  {
   "id": "c02",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Toxoplasma y criptococo se reactivan con CD4 < {{c1::100/mm³}}.",
   "extra": "",
   "origen": "clase:1",
   "fuente": "Clase · Los CD4 como reloj",
   "repaso": true,
   "codigos": [
    "1.04.1.014"
   ]
  },
  {
   "id": "c03",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "El complejo Mycobacterium avium (MAC) aparece con CD4 < {{c1::50/mm³}}.",
   "extra": "",
   "origen": "clase:1",
   "fuente": "Clase · Los CD4 como reloj",
   "repaso": true,
   "codigos": [
    "1.04.1.014"
   ]
  },
  {
   "id": "c04",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La infección oportunista pulmonar definitoria de SIDA más frecuente es la neumonía por {{c1::Pneumocystis jirovecii}}.",
   "extra": "",
   "origen": "libro:sec:1",
   "fuente": "Libro §1 Pneumocystis",
   "repaso": true,
   "codigos": [
    "1.04.1.014",
    "1.05.1.029"
   ],
   "preguntaReal": [
    "EUNACOM Agosto 2021 · Pregunta 25",
    "EUNACOM Diciembre 2017 · Pregunta 60",
    "EUNACOM Diciembre 2019 · Pregunta 38"
   ]
  },
  {
   "id": "c05",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "P. jirovecii es un hongo atípico que produce un exudado {{c1::espumoso intraalveolar}} rico en fibrina.",
   "extra": "",
   "origen": "clase:2",
   "fuente": "Clase · Un hongo que llena el alvéolo",
   "repaso": false,
   "codigos": [
    "1.04.1.014"
   ]
  },
  {
   "id": "c06",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Clínica de Pneumocystis: disnea subaguda de semanas, tos {{c1::seca}} y fiebre, con desaturación al caminar.",
   "extra": "",
   "origen": "libro:sec:1",
   "fuente": "Libro §1 Pneumocystis",
   "repaso": true,
   "codigos": [
    "1.05.1.029"
   ],
   "preguntaReal": [
    "EUNACOM Agosto 2021 · Pregunta 25",
    "EUNACOM Diciembre 2017 · Pregunta 60",
    "EUNACOM Diciembre 2019 · Pregunta 38"
   ]
  },
  {
   "id": "c07",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La radiografía de Pneumocystis muestra infiltrado intersticial bilateral perihiliar en {{c1::alas de mariposa}}.",
   "extra": "",
   "origen": "clase:3",
   "fuente": "Clase · Cómo se reconoce",
   "repaso": true,
   "codigos": [
    "1.05.1.029"
   ],
   "preguntaReal": [
    "EUNACOM Agosto 2021 · Pregunta 25",
    "EUNACOM Diciembre 2017 · Pregunta 60",
    "EUNACOM Diciembre 2019 · Pregunta 38"
   ]
  },
  {
   "id": "c08",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "En Pneumocystis la LDH sérica está elevada, > {{c1::400–500 UI/L}}.",
   "extra": "",
   "origen": "clase:3",
   "fuente": "Clase · Cómo se reconoce",
   "repaso": false,
   "codigos": [
    "1.05.1.029"
   ]
  },
  {
   "id": "c09",
   "modelo": "cloze",
   "tipo": "Farmaco",
   "texto": "Tratamiento de Pneumocystis: {{c1::cotrimoxazol (TMP-SMX) EV}} en dosis altas.",
   "extra": "",
   "origen": "libro:sec:1",
   "fuente": "Libro §1 Pneumocystis",
   "repaso": true,
   "codigos": [
    "1.05.1.029"
   ],
   "preguntaReal": [
    "EUNACOM Agosto 2021 · Pregunta 25",
    "EUNACOM Diciembre 2017 · Pregunta 60",
    "EUNACOM Diciembre 2019 · Pregunta 38"
   ]
  },
  {
   "id": "c10",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "El cotrimoxazol en dosis altas para Pneumocystis se da por {{c1::21 días}}.",
   "extra": "",
   "origen": "libro:puntos",
   "fuente": "Libro · Puntos clave",
   "repaso": true,
   "codigos": [
    "1.05.1.029"
   ]
  },
  {
   "id": "c11",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "En Pneumocystis se agregan corticoides si PaO2 < {{c1::70 mmHg}} o gradiente A-a ≥ 35 mmHg.",
   "extra": "Reducen la inflamación por lisis del hongo; mortalidad a la mitad.",
   "origen": "libro:puntos",
   "fuente": "Libro · Puntos clave",
   "repaso": true,
   "codigos": [
    "1.05.1.029"
   ],
   "preguntaReal": [
    "EUNACOM Agosto 2021 · Pregunta 25",
    "EUNACOM Diciembre 2017 · Pregunta 60",
    "EUNACOM Diciembre 2019 · Pregunta 38"
   ]
  },
  {
   "id": "c12",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Se agregan corticoides en Pneumocystis si el gradiente A-a es ≥ {{c1::35 mmHg}}.",
   "extra": "",
   "origen": "clase:4",
   "fuente": "Clase · Tratamiento",
   "repaso": false,
   "codigos": [
    "1.05.1.029"
   ]
  },
  {
   "id": "c13",
   "modelo": "cloze",
   "tipo": "Trampa",
   "texto": "Pneumocystis con PaO2 < 70: el error es dar {{c1::solo antibiótico, o el corticoide después}} del cotrimoxazol.",
   "extra": "",
   "origen": "clase:14",
   "fuente": "Clase · Tabla de trampas",
   "repaso": true,
   "codigos": [
    "1.05.1.029"
   ]
  },
  {
   "id": "c14",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La causa número uno de masa cerebral focal en el VIH es la {{c1::toxoplasmosis cerebral}}.",
   "extra": "",
   "origen": "libro:sec:2",
   "fuente": "Libro §2 Toxoplasmosis",
   "repaso": true,
   "codigos": [
    "1.04.1.014"
   ]
  },
  {
   "id": "c15",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La toxoplasmosis cerebral es una reactivación de quistes latentes con CD4 < {{c1::100/mm³}}.",
   "extra": "",
   "origen": "clase:5",
   "fuente": "Clase · La masa cerebral número uno",
   "repaso": false,
   "codigos": [
    "1.04.1.014"
   ]
  },
  {
   "id": "c16",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Toxoplasmosis en TAC/RM: múltiples lesiones con {{c1::realce en anillo}} y edema perilesional.",
   "extra": "",
   "origen": "clase:5",
   "fuente": "Clase · La masa cerebral número uno",
   "repaso": true,
   "codigos": [
    "1.04.1.014"
   ]
  },
  {
   "id": "c17",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La toxoplasmosis cerebral predomina en los {{c1::ganglios basales}} y la unión córtico-subcortical.",
   "extra": "",
   "origen": "clase:5",
   "fuente": "Clase · La masa cerebral número uno",
   "repaso": false,
   "codigos": [
    "1.04.1.014"
   ]
  },
  {
   "id": "c18",
   "modelo": "cloze",
   "tipo": "Farmaco",
   "texto": "Prueba terapéutica antitoxoplasma: {{c1::sulfadiazina + pirimetamina}} + ácido folínico.",
   "extra": "",
   "origen": "libro:puntos",
   "fuente": "Libro · Puntos clave",
   "repaso": true,
   "codigos": [
    "1.04.1.014"
   ]
  },
  {
   "id": "c19",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "La prueba terapéutica antitoxoplasma dura {{c1::10 a 14 días}}.",
   "extra": "",
   "origen": "clase:6",
   "fuente": "Clase · Se trata primero",
   "repaso": true,
   "codigos": [
    "1.04.1.014"
   ]
  },
  {
   "id": "c20",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Lesiones en anillo que no mejoran a los 14 días: sospechar {{c1::linfoma primario del SNC}} (virus Epstein-Barr) y biopsia estereotáxica.",
   "extra": "",
   "origen": "clase:6",
   "fuente": "Clase · Se trata primero",
   "repaso": true,
   "codigos": [
    "1.04.1.014"
   ]
  },
  {
   "id": "c21",
   "modelo": "cloze",
   "tipo": "Trampa",
   "texto": "Lesiones en anillo en ganglios basales en VIH: el error es {{c1::biopsia o radioterapia de entrada}}.",
   "extra": "",
   "origen": "clase:14",
   "fuente": "Clase · Tabla de trampas",
   "repaso": true,
   "codigos": [
    "1.04.1.014"
   ]
  },
  {
   "id": "c22",
   "modelo": "cloze",
   "tipo": "Trampa",
   "texto": "Sin respuesta antitoxoplasma a los 14 días, el error es {{c1::seguir con el mismo tratamiento}}.",
   "extra": "",
   "origen": "clase:14",
   "fuente": "Clase · Tabla de trampas",
   "repaso": false,
   "codigos": [
    "1.04.1.014"
   ]
  },
  {
   "id": "c23",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La meningitis criptocócica cursa con cefalea insidiosa y {{c1::poca o nula rigidez de nuca}}.",
   "extra": "",
   "origen": "clase:7",
   "fuente": "Clase · Cefalea insidiosa",
   "repaso": true,
   "codigos": [
    "1.04.4.004"
   ]
  },
  {
   "id": "c24",
   "modelo": "cloze",
   "tipo": "Trampa",
   "texto": "Cefalea insidiosa con poca rigidez de nuca en VIH: el error es {{c1::descartar meningitis}} por falta de rigidez.",
   "extra": "Se hace punción lumbar.",
   "origen": "clase:14",
   "fuente": "Clase · Tabla de trampas",
   "repaso": true,
   "codigos": [
    "1.04.4.004"
   ]
  },
  {
   "id": "c25",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "En criptococosis meníngea la presión de apertura del LCR es > {{c1::30 cm H2O}}.",
   "extra": "",
   "origen": "clase:7",
   "fuente": "Clase · Cefalea insidiosa",
   "repaso": false,
   "codigos": [
    "1.04.4.004"
   ]
  },
  {
   "id": "c26",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "El diagnóstico de meningitis criptocócica usa {{c1::tinta china}} (levaduras con halo) y antígeno criptocócico (CrAg).",
   "extra": "",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Criptococo",
   "repaso": true,
   "codigos": [
    "1.04.4.004"
   ]
  },
  {
   "id": "c27",
   "modelo": "cloze",
   "tipo": "Farmaco",
   "texto": "Inducción de la meningitis criptocócica: {{c1::anfotericina B liposomal + flucitosina}} por 2 semanas.",
   "extra": "",
   "origen": "clase:7",
   "fuente": "Clase · Cefalea insidiosa",
   "repaso": true,
   "codigos": [
    "1.04.4.004"
   ]
  },
  {
   "id": "c28",
   "modelo": "cloze",
   "tipo": "Farmaco",
   "texto": "Tras la inducción de la criptococosis, se consolida y mantiene con {{c1::fluconazol}} oral.",
   "extra": "",
   "origen": "clase:7",
   "fuente": "Clase · Cefalea insidiosa",
   "repaso": false,
   "codigos": [
    "1.04.4.004"
   ]
  },
  {
   "id": "c29",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La candidiasis {{c1::esofágica}} (odinofagia, disfagia retroesternal) define etapa SIDA.",
   "extra": "",
   "origen": "clase:9",
   "fuente": "Clase · Candidiasis y diarrea",
   "repaso": true,
   "codigos": [
    "1.04.1.005"
   ]
  },
  {
   "id": "c30",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Diarrea acuosa crónica con CD4 < 100–200: buscar Cryptosporidium, Cystoisospora y {{c1::microsporidios}}.",
   "extra": "",
   "origen": "clase:9",
   "fuente": "Clase · Candidiasis y diarrea",
   "repaso": true,
   "codigos": [
    "1.06.1.012"
   ],
   "preguntaReal": [
