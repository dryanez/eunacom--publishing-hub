   "fuente": "Libro · Puntos clave",
   "repaso": false,
   "codigos": [
    "1.05.1.036"
   ]
  },
  {
   "id": "c20",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "GeneXpert es prueba inicial en niños, VIH, contactos de casos {{c1::resistentes}} y personal de salud.",
