{
 "classId": "infecto-11",
 "cards": [
  {
   "id": "c01",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "M. tuberculosis es un bacilo {{c1::ácido-alcohol resistente}} (BAAR) aerobio estricto.",
   "extra": "",
   "origen": "libro:sec:1",
   "fuente": "Libro §1 Patogenia",
   "repaso": false,
   "codigos": [
    "1.05.1.036"
   ]
  },
  {
   "id": "c02",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Tras la infección primaria, la TBC disemina por vía {{c1::linfohematógena}} y puede quedar latente por décadas.",
   "extra": "",
   "origen": "clase:1",
   "fuente": "Clase · Un bacilo que se disemina",
   "repaso": false,
   "codigos": [
    "1.04.1.028"
   ]
  },
  {
   "id": "c03",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Las formas extrapulmonares son el 20–25 % de los casos en inmunocompetentes y más del {{c1::50 %}} en VIH.",
   "extra": "",
   "origen": "clase:1",
   "fuente": "Clase · Un bacilo que se disemina",
   "repaso": true,
   "codigos": [
    "1.04.1.028"
   ]
  },
  {
   "id": "c04",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Pleuresía tuberculosa: derrame {{c1::exudativo unilateral linfocítico}} (linfocitos > 80 %).",
   "extra": "",
   "origen": "clase:2",
   "fuente": "Clase · Pleura y ganglios",
   "repaso": true,
   "codigos": [
    "1.05.1.013"
   ]
  },
  {
   "id": "c05",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "En la pleuresía tuberculosa la ADA está sobre {{c1::40 UI/L}}.",
   "extra": "Con clínica compatible, confirma.",
   "origen": "libro:puntos",
   "fuente": "Libro · Puntos clave",
   "repaso": true,
   "codigos": [
    "1.05.1.013"
   ]
  },
  {
   "id": "c06",
   "modelo": "cloze",
   "tipo": "Trampa",
   "texto": "Derrame linfocítico con ADA > 40: se trata con el {{c1::esquema estándar}} de TBC, sin esperar biopsia.",
   "extra": "",
   "origen": "clase:10",
   "fuente": "Clase · Tabla de trampas",
   "repaso": false,
   "codigos": [
    "1.05.1.013"
   ]
  },
  {
   "id": "c07",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La localización extrapulmonar más frecuente es la {{c1::ganglionar (escrófula)}}.",
   "extra": "",
   "origen": "libro:sec:1",
   "fuente": "Libro §1 Extrapulmonares",
   "repaso": true,
   "codigos": [
    "1.04.1.028"
   ]
  },
  {
   "id": "c08",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La escrófula afecta ganglios {{c1::cervicales}} (supraclaviculares/yugulares): masas indoloras y frías que fistulizan a la piel.",
   "extra": "",
   "origen": "clase:2",
   "fuente": "Clase · Pleura y ganglios",
   "repaso": false,
   "codigos": [
    "1.04.1.028"
   ]
  },
  {
   "id": "c09",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Meningitis tuberculosa: cuadro {{c1::subaguda}} en la base del encéfalo con parálisis de pares craneanos.",
   "extra": "",
   "origen": "clase:3",
   "fuente": "Clase · Meninges y columna",
   "repaso": true,
   "codigos": [
    "1.04.1.028"
   ],
   "preguntaReal": [
    "EUNACOM Julio 2013 · Pregunta 112",
    "EUNACOM Julio 2013 · Pregunta 71"
   ]
  },
  {
   "id": "c10",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "En la meningitis TBC se afectan los pares craneanos {{c1::III y VI}}.",
   "extra": "",
   "origen": "clase:3",
   "fuente": "Clase · Meninges y columna",
   "repaso": false,
   "codigos": [
    "1.04.1.028"
   ],
   "preguntaReal": [
    "EUNACOM Julio 2013 · Pregunta 112",
    "EUNACOM Julio 2013 · Pregunta 71"
   ]
  },
  {
   "id": "c11",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "LCR en meningitis tuberculosa: glucosa {{c1::muy baja}}, proteínas muy altas y pleocitosis linfocítica.",
   "extra": "",
   "origen": "clase:3",
   "fuente": "Clase · Meninges y columna",
   "repaso": true,
   "codigos": [
    "1.04.1.028"
   ],
   "preguntaReal": [
    "EUNACOM Julio 2013 · Pregunta 112",
    "EUNACOM Julio 2013 · Pregunta 71"
   ]
  },
  {
   "id": "c12",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "En meningitis TBC las proteínas del LCR superan {{c1::200–500 mg/dL}}.",
   "extra": "",
   "origen": "clase:3",
   "fuente": "Clase · Meninges y columna",
   "repaso": false,
   "codigos": [
    "1.04.1.028"
   ]
  },
  {
   "id": "c13",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "El mal de Pott es la {{c1::espondilodiscitis}} tuberculosa de columna torácica o lumbar.",
   "extra": "Cifosis angular y riesgo de compresión medular.",
   "origen": "clase:3",
   "fuente": "Clase · Meninges y columna",
   "repaso": true,
   "codigos": [
    "1.04.1.028"
   ],
   "preguntaReal": [
    "EUNACOM Diciembre 2025 · Pregunta 116"
   ]
  },
  {
   "id": "c14",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Para evaluar un mal de Pott el estudio de imagen útil es la {{c1::resonancia magnética}}.",
   "extra": "",
   "origen": "clase:3",
   "fuente": "Clase · Meninges y columna",
   "repaso": false,
   "codigos": [
    "1.04.1.028"
   ],
   "preguntaReal": [
    "EUNACOM Diciembre 2025 · Pregunta 116"
   ]
  },
  {
   "id": "c15",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "La baciloscopía requiere > {{c1::5.000 bacilos/mL}} de muestra.",
   "extra": "",
   "origen": "clase:4",
   "fuente": "Clase · Baciloscopía, cultivo y GeneXpert",
   "repaso": false,
   "codigos": [
    "1.05.1.036"
   ]
  },
  {
   "id": "c16",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "El gold standard diagnóstico de TBC es el {{c1::cultivo}} (Lowenstein-Jensen o MGIT), que permite antibiograma.",
   "extra": "",
   "origen": "clase:4",
   "fuente": "Clase · Baciloscopía, cultivo y GeneXpert",
   "repaso": true,
   "codigos": [
    "1.05.1.036"
   ],
   "preguntaReal": [
    "EUNACOM Enero 2023 · Pregunta 91"
   ]
  },
  {
   "id": "c17",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Baciloscopías negativas con cultivo MGIT positivo en VIH: se {{c1::inicia el tratamiento estándar}} de TBC.",
   "extra": "",
   "origen": "clase:4",
   "fuente": "Clase · Baciloscopía, cultivo y GeneXpert",
