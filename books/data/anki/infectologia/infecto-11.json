   "codigos": [
    "1.05.1.036"
   ]
  },
  {
   "id": "c19",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "GeneXpert da el resultado en menos de {{c1::2 horas}}.",
   "extra": "",
