{
 "classId": "infecto-02",
 "cards": [
  {
   "id": "c01",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Los dos agentes principales de la meningitis bacteriana comunitaria son {{c1::Streptococcus pneumoniae}} y Neisseria meningitidis.",
   "extra": "",
   "origen": "libro:sec:1",
   "fuente": "Libro §1 Presentación",
   "repaso": true,
   "codigos": [
    "1.04.2.006",
    "2.01.2.015"
   ]
  },
  {
   "id": "c02",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Tríada meníngea clásica: fiebre, cefalea y {{c1::rigidez de nuca}}.",
   "extra": "",
   "origen": "libro:sec:1",
   "fuente": "Libro §1 Presentación",
   "repaso": true,
   "imagen": "biblioteca/07_infectologia/infecto-02/02_rigidez_nuca__bates_p906.jpg",
   "codigos": [
    "1.04.2.006",
    "2.01.2.015"
   ]
  },
  {
   "id": "c03",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "La tríada clásica completa está presente en < {{c1::50 %}} de los casos.",
   "extra": "",
   "origen": "clase:2",
   "fuente": "Clase · Cómo llega el paciente",
   "repaso": false,
   "codigos": [
    "1.04.2.006",
    "2.01.2.015"
   ]
  },
  {
   "id": "c04",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La ausencia de los {{c1::3}} elementos de la tríada descarta prácticamente la meningitis.",
   "extra": "",
   "origen": "clase:2",
   "fuente": "Clase · Cómo llega el paciente",
   "repaso": false,
   "codigos": [
    "1.04.2.006",
    "2.01.2.015"
   ]
  },
  {
   "id": "c05",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Los signos meníngeos al examen son {{c1::Kernig y Brudzinski}}.",
   "extra": "Estiran las meninges inflamadas.",
   "origen": "clase:2",
   "fuente": "Clase · Cómo llega el paciente",
   "repaso": false,
   "imagen": "biblioteca/07_infectologia/infecto-02/01_signo_kernig__bates_p795.jpg",
   "codigos": [
    "1.04.2.006",
    "2.01.2.015"
   ]
  },
  {
   "id": "c06",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La inflamación masiva produce edema vasogénico, citotóxico e intersticial, con riesgo de {{c1::herniación e isquemia cerebral}}.",
   "extra": "",
   "origen": "clase:1",
   "fuente": "Clase · Por qué mata rápido",
   "repaso": false,
   "codigos": [
    "1.04.2.006",
    "2.01.2.015"
   ]
  },
  {
   "id": "c07",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Antes de la punción lumbar se pide TAC si hay déficit neurológico {{c1::focal}} (paresia, asimetría facial, afasia).",
   "extra": "",
   "origen": "libro:sec:2",
   "fuente": "Libro §2 Banderas rojas",
   "repaso": true,
   "codigos": [
    "1.04.2.006",
    "1.04.5.002"
   ]
  },
  {
   "id": "c08",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Bandera roja para TAC: crisis convulsiva de reciente inicio, hace < {{c1::1 semana}}.",
   "extra": "",
   "origen": "libro:sec:2",
   "fuente": "Libro §2 Banderas rojas",
   "repaso": false,
   "codigos": [
    "1.04.2.006",
    "1.04.5.002"
   ]
  },
  {
   "id": "c09",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Bandera roja para TAC: compromiso de conciencia con Glasgow < {{c1::10}}.",
   "extra": "",
   "origen": "libro:sec:2",
   "fuente": "Libro §2 Banderas rojas",
   "repaso": true,
   "codigos": [
    "1.04.2.006",
    "1.04.5.002"
   ]
  },
  {
   "id": "c10",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Otras banderas rojas para TAC previo: {{c1::papiledema}} e inmunodepresión severa (VIH con CD4 bajo).",
   "extra": "",
   "origen": "clase:3",
   "fuente": "Clase · TAC antes de la PL",
   "repaso": false,
   "codigos": [
    "1.04.2.006",
    "2.01.2.015"
   ]
  },
  {
   "id": "c11",
   "modelo": "cloze",
   "tipo": "Trampa",
   "texto": "Si hay indicación de TAC, el error es {{c1::esperar la imagen para tratar}}: primero hemocultivos, dexametasona y ATB.",
   "extra": "",
   "origen": "clase:3",
   "fuente": "Clase · TAC antes de la PL",
   "repaso": true,
   "codigos": [
    "1.04.2.006",
    "2.01.2.015"
   ]
  },
  {
   "id": "c12",
   "modelo": "cloze",
   "tipo": "Farmaco",
   "texto": "Dexametasona EV en meningitis: {{c1::10 mg cada 6 h por 4 días}}.",
   "extra": "",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Tratamiento",
   "repaso": true,
   "codigos": [
    "1.04.2.006",
    "2.01.2.015"
   ]
  },
  {
   "id": "c13",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "La dexametasona se da {{c1::15–20 minutos}} antes o junto con la primera dosis de antibiótico.",
   "extra": "Reduce secuelas auditivas y mortalidad en neumococo.",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Tratamiento",
   "repaso": false,
   "codigos": [
    "1.04.2.006",
    "2.01.2.015"
   ]
  },
  {
   "id": "c14",
   "modelo": "cloze",
   "tipo": "Farmaco",
   "texto": "Esquema empírico estándar (3 meses a 50 años): {{c1::ceftriaxona}} 2 g cada 12 h EV + vancomicina.",
   "extra": "",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Tratamiento",
   "repaso": true,
   "preguntaReal": [
    "EUNACOM Julio 2017 · Pregunta 81",
    "EUNACOM Julio 2025 · Pregunta 80"
   ],
   "codigos": [
    "1.04.2.006",
    "2.01.2.015"
   ]
  },
  {
   "id": "c15",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Vancomicina en meningitis: {{c1::15–20 mg/kg}} cada 12 h EV.",
   "extra": "Cubre neumococo resistente.",
   "origen": "clase:4",
   "fuente": "Clase · Tratamiento empírico",
   "repaso": false,
   "codigos": [
    "1.04.2.006",
    "2.01.2.015"
   ]
  },
  {
   "id": "c16",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "En mayores de 50 años, embarazadas e inmunodeprimidos se agrega {{c1::ampicilina}} 2 g cada 4 h EV.",
   "extra": "",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Tratamiento",
   "repaso": true,
   "codigos": [
    "1.04.2.006",
    "2.01.2.015"
   ]
  },
  {
   "id": "c17",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La ampicilina cubre {{c1::Listeria monocytogenes}}, intrínsecamente resistente a cefalosporinas.",
   "extra": "",
   "origen": "clase:4",
   "fuente": "Clase · Tratamiento empírico",
   "repaso": true,
   "codigos": [
    "1.04.2.006",
    "2.01.2.015"
   ]
  },
  {
   "id": "c18",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Ampicilina en meningitis por Listeria: {{c1::2 g cada 4 h}} EV.",
   "extra": "",
   "origen": "clase:4",
   "fuente": "Clase · Tratamiento empírico",
   "repaso": false,
   "codigos": [
    "1.04.2.006",
    "2.01.2.015"
   ]
  },
  {
   "id": "c19",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Meningitis bacteriana en lactante < 3 meses: hospitalizar, PL y ATB EV inmediato con ampicilina + {{c1::cefotaxima}}.",
   "extra": "",
   "origen": "clase:4",
   "fuente": "Clase · Tratamiento empírico",
   "repaso": false,
   "preguntaReal": [
    "EUNACOM Julio 2025 · Pregunta 137"
   ],
   "codigos": [
    "1.04.2.006",
    "2.01.2.015"
   ]
  },
