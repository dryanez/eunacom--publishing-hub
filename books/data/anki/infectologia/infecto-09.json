   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Primoinfección por VIH: fiebre, odinofagia, úlceras orales y {{c1::adenopatías cervicales}} bilaterales.",
   "extra": "",
   "origen": "libro:tabla",
