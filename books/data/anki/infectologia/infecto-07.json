   "origen": "libro:sec:4",
   "fuente": "Libro §4 CVC y Foley",
   "repaso": false,
   "codigos": [
    "1.01.5.003",
    "1.08.5.004"
   ]
  },
  {
   "id": "c36",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Cada día de sonda Foley aumenta {{c1::3–7 %}} el riesgo de ITU asociada.",
