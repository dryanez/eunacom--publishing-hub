   "origen": "libro:sec:4",
   "fuente": "Libro §4 CVC y Foley",
   "repaso": false,
   "codigos": [
    "1.01.5.003",
    "1.08.5.004"
   ]
  },
  {
   "id": "c35",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Sospecha de lesión uretral (trauma pélvico, sangre en el meato): {{c1::no se instala sonda}}; se pide uretrografía.",
