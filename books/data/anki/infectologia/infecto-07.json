   "origen": "libro:sec:4",
   "fuente": "Libro §4 CVC y Foley",
   "repaso": false,
   "codigos": [
    "1.01.5.003",
    "1.08.5.004"
   ]
  },
  {
   "id": "c33",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La sonda Foley no se usa {{c1::por comodidad}}: retención urinaria, diuresis crítica, cirugía.",
   "extra": "",
   "origen": "clase:6",
   "fuente": "Clase · Catéter y sonda",
   "repaso": false,
   "codigos": [
    "1.04.1.015",
    "1.04.3.005"
   ]
  },
  {
   "id": "c34",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "El balón de la Foley se infla con {{c1::10 mL}} de agua destilada, tras ver salir orina.",
