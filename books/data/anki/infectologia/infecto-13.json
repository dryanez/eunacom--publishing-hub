   "origen": "libro:sec:1",
   "fuente": "Libro §1 Uretritis",
   "repaso": false,
   "codigos": [
    "1.04.1.010"
   ]
  },
  {
   "id": "c06",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Uretritis no gonocócica: secreción {{c1::escasa, serosa o mucoide}} (gota matinal), incubación de 1 a 3 semanas.",
