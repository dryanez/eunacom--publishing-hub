   "codigos": [
    "1.04.1.019"
   ]
  },
  {
   "id": "c34",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Mucormicosis: además se corrigen la {{c1::acidosis y la glicemia}} y se reduce la inmunosupresión.",
