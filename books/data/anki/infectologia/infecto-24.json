  {
   "id": "c01",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "En el neutropénico no hay pus ni inflamación: la {{c1::fiebre}} suele ser la única alarma de bacteriemia.",
   "extra": "",
   "origen": "clase:1",
   "fuente": "Clase · ¿Por qué es una emergencia?",
   "repaso": true,
   "codigos": [
    "1.04.1.020",
    "2.01.1.034"
   ]
  },
  {
   "id": "c02",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Patógeno más temido en la neutropenia febril: {{c1::Pseudomonas aeruginosa}}, con shock fulminante en < 12 h.",
   "extra": "",
   "origen": "clase:1",
   "fuente": "Clase · ¿Por qué es una emergencia?",
   "repaso": true,
   "codigos": [
    "1.04.1.020",
    "2.01.1.034"
   ]
  },
  {
   "id": "c03",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Fiebre en neutropenia febril: un registro axilar ≥ {{c1::38,3 °C}}.",
   "extra": "",
   "origen": "clase:2",
   "fuente": "Clase · Definiciones",
   "repaso": true,
   "codigos": [
    "1.04.1.020",
    "2.01.1.034"
   ]
  },
  {
   "id": "c04",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "O ≥ 38,0 °C sostenida por más de {{c1::1 hora}}.",
   "extra": "",
   "origen": "clase:2",
   "fuente": "Clase · Definiciones",
   "repaso": true,
   "codigos": [
    "1.04.1.020",
    "2.01.1.034"
   ]
  },
  {
   "id": "c05",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Neutropenia: RAN < {{c1::500}}/mm³.",
   "extra": "",
   "origen": "clase:2",
   "fuente": "Clase · Definiciones",
   "repaso": true,
   "codigos": [
    "1.04.1.020",
    "2.01.1.034"
   ]
  },
  {
   "id": "c06",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "También es neutropenia un RAN < 1.000 con caída prevista bajo 500 en {{c1::48 h}}.",
   "extra": "",
   "origen": "clase:2",
   "fuente": "Clase · Definiciones",
   "repaso": false,
   "codigos": [
    "1.04.1.020",
    "2.01.1.034"
   ]
  },
  {
   "id": "c07",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "El RAN se calcula como leucocitos × % de neutrófilos, sumando {{c1::segmentados y baciliformes}}.",
   "extra": "",
   "origen": "clase:2",
   "fuente": "Clase · Definiciones",
   "repaso": true,
   "codigos": [
    "1.04.1.020",
    "2.01.1.034"
   ],
   "preguntaReal": [
    "EUNACOM Diciembre 2025 · Pregunta 58"
   ]
  },
  {
   "id": "c08",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Leucocitos 800 con 35% de neutrófilos dan un RAN de {{c1::280/mm³}}: neutropenia febril.",
   "extra": "",
   "origen": "clase:2",
   "fuente": "Clase · Definiciones",
   "repaso": false,
   "codigos": [
    "1.04.1.020",
    "2.01.1.034"
   ]
  },
  {
   "id": "c09",
   "modelo": "cloze",
   "tipo": "Trampa",
   "texto": "Fiebre post-quimioterapia: lo primero es el hemograma para calcular el RAN, no partir por {{c1::imágenes}}.",
   "extra": "",
   "origen": "clase:11",
   "fuente": "Clase · Tabla de trampas",
   "repaso": false,
   "codigos": [
    "1.04.1.020",
    "2.01.1.034"
   ]
  },
  {
   "id": "c10",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Regla de los {{c1::60 minutos}}: antibiótico EV en la primera hora.",
   "extra": "",
   "origen": "clase:3",
   "fuente": "Clase · La regla de los 60 minutos",
   "repaso": true,
   "codigos": [
    "1.04.1.020",
