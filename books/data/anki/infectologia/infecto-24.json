   "codigos": [
    "1.04.1.020",
    "2.01.1.034"
   ]
  },
  {
   "id": "c16",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Bajo riesgo: MASCC ≥ {{c1::21}}; opción ambulatoria seleccionada.",
   "extra": "",
   "origen": "clase:4",
   "fuente": "Clase · Estratificación MASCC",
   "repaso": true,
   "codigos": [
    "1.04.1.020",
    "2.01.1.034"
   ]
  },
  {
   "id": "c17",
   "modelo": "cloze",
   "tipo": "Farmaco",
   "texto": "Neutropenia febril de bajo riesgo: ciprofloxacino + {{c1::amoxicilina-clavulánico}} oral.",
   "extra": "",
   "origen": "clase:4",
   "fuente": "Clase · Estratificación MASCC",
   "repaso": true,
   "codigos": [
    "1.04.1.020",
    "2.01.1.034"
   ]
  },
  {
   "id": "c18",
   "modelo": "cloze",
   "tipo": "Trampa",
   "texto": "La {{c1::ceftriaxona}} no cubre Pseudomonas: no es el antibiótico de elección en neutropenia febril.",
