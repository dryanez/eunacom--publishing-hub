   ]
  },
  {
   "id": "c11",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Antes del antibiótico se toman {{c1::2 hemocultivos}} (periférico y por el catéter).",
   "extra": "",
   "origen": "clase:3",
   "fuente": "Clase · La regla de los 60 minutos",
   "repaso": true,
   "codigos": [
    "1.04.1.020",
    "2.01.1.034"
   ]
  },
  {
   "id": "c12",
   "modelo": "cloze",
   "tipo": "Trampa",
   "texto": "En alto riesgo el error es {{c1::esperar los hemocultivos}} antes de dar el antibiótico.",
   "extra": "",
   "origen": "clase:11",
   "fuente": "Clase · Tabla de trampas",
   "repaso": true,
   "codigos": [
    "1.04.1.020",
    "2.01.1.034"
   ]
  },
  {
   "id": "c13",
   "modelo": "cloze",
   "tipo": "Farmaco",
   "texto": "Neutropenia febril de alto riesgo: {{c1::cefepime}} 2 g cada 8 h EV.",
   "extra": "",
   "origen": "clase:4",
   "fuente": "Clase · Estratificación MASCC",
   "repaso": true,
   "codigos": [
    "1.04.1.020",
