   "origen": "clase:4",
   "fuente": "Clase · Estratificación MASCC",
   "repaso": true,
   "codigos": [
    "1.04.1.020",
    "2.01.1.034"
   ]
  },
  {
   "id": "c19",
   "modelo": "cloze",
   "tipo": "Trampa",
   "texto": "En alto riesgo estable se usa monoterapia antipseudomónica; la vancomicina de entrada es un {{c1::error}}.",
   "extra": "",
   "origen": "clase:5",
   "fuente": "Clase · Vancomicina",
   "repaso": true,
   "codigos": [
    "1.04.1.020",
    "2.01.1.034"
   ]
  },
  {
   "id": "c20",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Se agrega vancomicina si hay shock, infección franca del catéter, mucositis severa o sospecha de {{c1::SAMR}}.",
   "extra": "",
   "origen": "clase:5",
   "fuente": "Clase · Vancomicina",
   "repaso": true,
   "codigos": [
    "1.04.1.020",
    "2.01.1.034"
   ]
  },
  {
   "id": "c21",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Vancomicina en alto riesgo con shock o catéter: {{c1::15-20 mg/kg}} EV, en UCI.",
   "extra": "",
   "origen": "clase:5",
   "fuente": "Clase · Vancomicina",
   "repaso": false,
   "codigos": [
    "1.04.1.020",
    "2.01.1.034"
   ]
  },
  {
   "id": "c22",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Fiebre persistente al día 4.º-7.º con hemocultivos negativos: sospechar {{c1::micosis invasora}} (aspergilosis o candidiasis).",
   "extra": "",
   "origen": "clase:6",
   "fuente": "Clase · Si la fiebre no cede al 4.º-7.º día",
   "repaso": true,
   "codigos": [
    "1.04.1.019"
   ],
   "preguntaReal": [
    "EUNACOM Julio 2016 · Pregunta 73",
    "EUNACOM Julio 2019 · Pregunta 132"
   ]
  },
  {
   "id": "c23",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Neutropenia prolongada que no responde a antibióticos de amplio espectro: la causa fúngica más frecuente es {{c1::Aspergillus}}.",
   "extra": "",
   "origen": "clase:6",
   "fuente": "Clase · Si la fiebre no cede al 4.º-7.º día",
   "repaso": true,
   "codigos": [
    "1.04.1.019"
   ],
   "preguntaReal": [
    "EUNACOM Julio 2016 · Pregunta 73",
    "EUNACOM Julio 2019 · Pregunta 132"
   ]
  },
  {
   "id": "c24",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Ante fiebre persistente al día 4.º-7.º se pide TAC de tórax de alta resolución buscando el signo del {{c1::halo}}.",
   "extra": "",
   "origen": "clase:6",
   "fuente": "Clase · Si la fiebre no cede al 4.º-7.º día",
   "repaso": true,
   "codigos": [
    "1.04.1.019"
   ]
  },
  {
   "id": "c25",
   "modelo": "cloze",
   "tipo": "Farmaco",
   "texto": "Micosis invasora en neutropenia febril: {{c1::voriconazol}} EV o equinocandina (caspofungina).",
   "extra": "",
   "origen": "clase:6",
   "fuente": "Clase · Si la fiebre no cede al 4.º-7.º día",
   "repaso": true,
   "codigos": [
    "1.04.1.019"
   ]
  },
  {
   "id": "c26",
   "modelo": "cloze",
   "tipo": "Trampa",
   "texto": "Fiebre al día 4.º-7.º: el error es {{c1::cambiar o suspender antibióticos}}; el hongo no responde a ellos.",
