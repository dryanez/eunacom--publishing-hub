   ]
  },
  {
   "id": "c14",
   "modelo": "cloze",
   "tipo": "Farmaco",
   "texto": "Alternativa al cefepime: {{c1::piperacilina-tazobactam}} 4,5 g cada 6 h.",
   "extra": "",
   "origen": "clase:4",
   "fuente": "Clase · Estratificación MASCC",
   "repaso": false,
   "codigos": [
    "1.04.1.020",
