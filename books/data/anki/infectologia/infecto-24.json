  },
  {
   "id": "c15",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Alto riesgo: MASCC < {{c1::21}}; se hospitaliza en aislamiento.",
   "extra": "",
   "origen": "clase:4",
   "fuente": "Clase · Estratificación MASCC",
