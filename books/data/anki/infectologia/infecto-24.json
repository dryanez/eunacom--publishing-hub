  },
  {
   "id": "c27",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La mucormicosis es un hongo {{c1::angioinvasor}} que causa necrosis (Rhizopus, Mucor).",
   "extra": "",
   "origen": "clase:7",
   "fuente": "Clase · Mucormicosis",
   "repaso": false,
   "codigos": [
    "1.04.1.019"
   ]
  },
  {
   "id": "c28",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Mucormicosis: cetoacidosis diabética, neutropenia, corticoides, hierro (deferoxamina), trasplante o {{c1::COVID-19}} grave.",
   "extra": "",
   "origen": "clase:7",
   "fuente": "Clase · Mucormicosis",
   "repaso": true,
   "codigos": [
    "1.04.1.019"
   ],
   "preguntaReal": [
    "EUNACOM Diciembre 2018 · Pregunta 124"
   ]
  },
  {
   "id": "c29",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Mucormicosis rinocerebral: dolor facial, secreción sanguinolenta, escara negra en paladar o cornetes, proptosis y {{c1::oftalmoplejía}}.",
   "extra": "",
   "origen": "clase:7",
   "fuente": "Clase · Mucormicosis",
   "repaso": true,
   "codigos": [
    "1.04.1.019"
   ],
   "preguntaReal": [
    "EUNACOM Diciembre 2018 · Pregunta 124"
   ]
  },
  {
   "id": "c30",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Diabético con eritema facial y zona necrótica en el ala nasal: agente {{c1::Mucor}}.",
   "extra": "",
   "origen": "clase:7",
   "fuente": "Clase · Mucormicosis",
   "repaso": true,
   "codigos": [
    "1.04.1.019"
   ],
   "preguntaReal": [
    "EUNACOM Diciembre 2018 · Pregunta 124"
   ]
  },
  {
   "id": "c31",
   "modelo": "cloze",
   "tipo": "Trampa",
   "texto": "Necrosis que empeora con voriconazol: pensar en {{c1::mucormicosis}}, que no cubre.",
   "extra": "",
   "origen": "clase:7",
   "fuente": "Clase · Mucormicosis",
   "repaso": true,
   "codigos": [
    "1.04.1.019"
   ]
  },
  {
   "id": "c32",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Biopsia de mucormicosis: hifas anchas, {{c1::aseptadas}} y ramificadas en ángulo recto.",
   "extra": "",
   "origen": "clase:7",
   "fuente": "Clase · Mucormicosis",
   "repaso": false,
   "codigos": [
    "1.04.1.019"
   ]
  },
  {
   "id": "c33",
   "modelo": "cloze",
   "tipo": "Farmaco",
   "texto": "Mucormicosis: desbridamiento más {{c1::anfotericina B liposomal}} 5-10 mg/kg/día.",
   "extra": "",
   "origen": "clase:7",
   "fuente": "Clase · Mucormicosis",
