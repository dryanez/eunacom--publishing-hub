   ]
  },
  {
   "id": "c09",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Las hemorroides son almohadillas vasculares {{c1::normales}} que contribuyen a la continencia fina.",
   "extra": "",
   "origen": "libro:sec:2",
   "fuente": "Libro §2 Hemorroides",
   "repaso": false,
   "codigos": [
    "4.01.1.016, 4.01.1.017"
   ]
  },
  {
   "id": "c10",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Las hemorroides internas están {{c1::sobre}} la línea dentada y son insensibles al dolor.",
   "extra": "",
   "origen": "libro:sec:2",
   "fuente": "Libro §2 Hemorroides",
   "repaso": false,
   "imagen": "biblioteca/10_cirugia/cirugia-07/01_prolapso-hemorroidal__cto-digestivo_p149.jpg",
   "codigos": [
    "4.01.1.016"
   ]
  },
  {
   "id": "c11",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La hemorroide interna sangra con sangre {{c1::roja rutilante indolora}} al final de la deposición.",
   "extra": "",
   "origen": "libro:sec:2",
   "fuente": "Libro §2 Hemorroides",
   "repaso": false,
   "codigos": [
    "4.01.1.016"
   ]
  },
  {
   "id": "c12",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Hemorroides internas grado {{c1::I}} sangran sin prolapso; grado {{c2::II}} prolapsan y se reducen solas.",
   "extra": "",
   "origen": "libro:sec:2",
   "fuente": "Libro §2 Hemorroides",
   "repaso": false,
   "codigos": [
    "4.01.1.016"
   ]
  },
  {
   "id": "c13",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Grado III prolapsa y requiere {{c1::reducción manual}}; grado IV es prolapso {{c2::permanente irreductible}}.",
   "extra": "",
   "origen": "libro:sec:2",
   "fuente": "Libro §2 Hemorroides",
   "repaso": false,
   "codigos": [
    "4.01.1.016"
   ]
  },
  {
   "id": "c14",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Hemorroides grado I-II: dieta o {{c1::bandas elásticas}}; grado III-IV: {{c2::hemorroidectomía}}.",
   "extra": "",
