  {
   "id": "c17",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Absceso y fístula anorrectal son dos fases de una misma enfermedad {{c1::criptoglandular}}.",
   "extra": "Obstrucción de glándulas anales en las criptas de Morgagni.",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Abscesos",
   "repaso": false,
   "codigos": [
    "4.01.1.017"
   ]
  },
  {
   "id": "c18",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "El absceso más frecuente es el perianal (60%), seguido del {{c1::isquiorrectal}} (30%).",
   "extra": "",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Abscesos",
   "repaso": false,
   "codigos": [
    "4.01.1.017"
   ]
  },
  {
   "id": "c19",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "El dolor del absceso perianal es {{c1::pulsátil y continuo}}, no solo defecatorio.",
