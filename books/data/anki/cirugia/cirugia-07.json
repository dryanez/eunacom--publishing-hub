  {
   "id": "c01",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La fisura anal es un desgarro del anodermo bajo la línea dentada, en más del {{c1::90%}} en la línea media {{c2::posterior}}.",
   "extra": "Es la zona con menos irrigación.",
   "origen": "libro:sec:1",
   "fuente": "Libro §1 Fisura anal",
   "repaso": true,
   "imagen": "biblioteca/10_cirugia/cirugia-07/02_fisura_anal_foto__commons.jpg",
   "codigos": [
    "4.01.1.016",
    "4.01.1.020"
   ]
  },
  {
   "id": "c02",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Dolor anal lacerante «de cristales rotos» que empieza al defecar y dura horas: {{c1::fisura anal}}.",
   "extra": "Rectorragia escasa en el papel.",
   "origen": "libro:sec:1",
   "fuente": "Libro §1 Fisura anal",
   "repaso": true,
   "preguntaReal": [
    "EUNACOM Julio 2017 · Pregunta 54"
   ],
   "codigos": [
    "4.01.1.016",
    "4.01.1.020"
   ]
  },
  {
   "id": "c03",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La fisura se mantiene por un círculo de dolor, hipertonía e {{c1::isquemia}} del esfínter anal interno.",
   "extra": "",
   "origen": "libro:sec:1",
   "fuente": "Libro §1 Fisura anal",
   "repaso": false,
   "codigos": [
    "4.01.1.016",
    "4.01.1.020"
   ]
  },
  {
   "id": "c04",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "La fisura crónica dura más de {{c1::6-8 semanas}}.",
   "extra": "",
   "origen": "libro:sec:1",
   "fuente": "Libro §1 Fisura anal",
   "repaso": false,
   "codigos": [
    "4.01.1.016",
    "4.01.1.020"
   ]
  },
  {
   "id": "c05",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La tríada de Brodie: úlcera con fibras del esfínter, {{c1::plicoma (papila hipertrófica)}} y {{c2::hemorroide centinela}}.",
   "extra": "Fisura crónica.",
   "origen": "libro:sec:1",
   "fuente": "Libro §1 Fisura anal",
   "repaso": true,
   "codigos": [
    "4.01.1.016",
    "4.01.1.020"
   ]
  },
  {
   "id": "c06",
   "modelo": "cloze",
   "tipo": "Farmaco",
   "texto": "Primera línea de la fisura anal: fibra, agua, baños de asiento y {{c1::diltiazem tópico al 2%}}.",
   "extra": "Alternativa: nitroglicerina 0.2%.",
   "origen": "libro:puntos",
   "fuente": "Libro · puntos clave",
   "repaso": true,
   "codigos": [
    "4.01.1.016",
    "4.01.1.020"
