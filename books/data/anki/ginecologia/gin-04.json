      "id": "c27",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Miomectomía histeroscópica: de elección en submucosos FIGO 0 y 1 menores de {{c1::4-5 cm}}.",
      "extra": "",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 Quirúrgico",
      "repaso": false,
      "codigos": [
        "3.01.1.021"
      ]
    },
    {
      "id": "c28",
      "modelo": "cloze",
      "tipo": "Algoritmo",
      "texto": "Mioma sintomático, nulípara, que desea preservar el útero: {{c1::miomectomía}}.",
      "extra": "",
