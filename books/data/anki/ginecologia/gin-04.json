      ]
    },
    {
      "id": "c25",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Sangrado con endometrio grueso en postmenopáusica con mioma: el error es {{c1::atribuirlo al mioma}}; se biopsia el endometrio.",
      "extra": "",
      "origen": "clase:10",
      "fuente": "Clase · Tabla de trampas",
      "repaso": false,
      "codigos": [
        "3.01.1.021"
      ]
    },
    {
