      "tipo": "Algoritmo",
      "texto": "Mioma submucoso sintomático FIGO 0-1 que desea fertilidad: {{c1::miomectomía histeroscópica}}.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · puntos clave",
