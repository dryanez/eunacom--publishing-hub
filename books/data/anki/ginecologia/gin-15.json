    },
    {
      "id": "c25",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Masa anexial con criterios IOTA benignos: control ecográfico en {{c1::6 a 12 semanas}}.",
      "extra": "Error: cirugía o marcadores de entrada.",
      "origen": "clase:12",
      "fuente": "Clase · Tabla de trampas",
      "codigos": [
        "3.01.1.028",
        "3.01.4.005"
      ],
      "repaso": true
    },
    {
      "id": "c26",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Quiste simple < 5 cm en mujer en edad fértil: control con ecografía transvaginal en {{c1::6 a 8 semanas}} en fase folicular.",
      "extra": "",
      "origen": "clase:17",
