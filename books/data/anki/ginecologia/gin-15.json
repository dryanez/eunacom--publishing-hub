      "id": "c24",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Signo ecográfico de malignidad con flujo Doppler: vascularización {{c1::central}} intralesional.",
      "extra": "",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla IOTA",
      "codigos": [
        "3.01.1.028",
        "3.01.4.005"
      ],
