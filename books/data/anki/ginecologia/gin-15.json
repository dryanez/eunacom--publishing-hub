    },
    {
      "id": "c23",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Signos de malignidad IOTA: papilas sólidas intracísticas y septos gruesos, ambos > {{c1::3 mm}}.",
      "extra": "Además ascitis y flujo Doppler central.",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 IOTA",
      "codigos": [
        "3.01.1.028",
        "3.01.4.005"
      ],
