  "cards": [
    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Infertilidad: {{c1::12 meses}} de búsqueda sin lograr embarazo en mujer menor de 35 años.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · puntos clave",
      "repaso": true,
      "codigos": [
        "3.01.1.020"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "En mujer de 35 años o más el estudio se inicia a los {{c1::6 meses}}.",
      "extra": "Declive acelerado de la reserva ovárica.",
      "origen": "libro:puntos",
      "fuente": "Libro · puntos clave",
      "repaso": true,
      "codigos": [
        "3.01.1.020"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Mujer de 35 años o más: el error es esperar los {{c1::12 meses}} habituales.",
      "extra": "",
      "origen": "clase:10",
      "fuente": "Clase · Trampas",
      "repaso": false,
      "codigos": [
        "3.01.1.020"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La infertilidad se estudia siempre en {{c1::pareja}}, aunque alguno tenga hijos previos.",
      "extra": "",
      "origen": "clase:15",
      "fuente": "Clase · Reglas de oro",
      "repaso": false,
      "codigos": [
        "3.01.1.020"
      ],
      "preguntaReal": [
        "EUNACOM Julio 2019 · Pregunta 109"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Factor masculino: causa de {{c1::35%}} de la infertilidad de pareja (libro); factor tuboperitoneal 30%.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · puntos clave",
      "repaso": false,
      "codigos": [
        "3.01.1.020",
        "4.03.1.017"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Causa anovulatoria más frecuente de infertilidad: {{c1::SOP}}.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Distribución",
      "repaso": false,
      "codigos": [
        "3.01.1.020"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Infertilidad sin causa aparente (ISCA): cuando el estudio básico completo resulta {{c1::normal}}.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Distribución",
      "repaso": false,
      "codigos": [
        "3.01.1.020"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El estudio básico inicial tiene cuatro pilares: masculino, ovulatorio, {{c1::tuboperitoneal}} y uterino.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Cuatro pilares",
      "repaso": true,
      "codigos": [
        "3.01.1.020"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Algoritmo",
      "texto": "Primer examen en el estudio de infertilidad de la pareja: {{c1::espermiograma}}.",
      "extra": "Antes que cualquier examen de ella.",
      "origen": "clase:12",
      "fuente": "Clase · Quiz Dic 2017",
      "repaso": true,
      "codigos": [
        "3.01.1.020",
        "4.03.1.017"
      ],
      "preguntaReal": [
        "EUNACOM Diciembre 2017 · Pregunta 75",
        "EUNACOM Julio 2017 · Pregunta 43"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Primera consulta de la pareja: el error es empezar solo con {{c1::exámenes de ella}}.",
      "extra": "",
      "origen": "clase:10",
      "fuente": "Clase · Trampas",
      "repaso": false,
      "codigos": [
        "3.01.1.020"
      ]
    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Espermiograma: abstinencia previa de {{c1::3 a 5 días}}.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · puntos clave",
      "repaso": true,
      "codigos": [
        "3.01.1.020",
        "4.03.1.017"
      ]
    },
    {
      "id": "c12",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Espermiograma normal: concentración ≥ {{c1::15 a 16 millones/mL}}.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Espermiograma",
      "repaso": false,
      "codigos": [
        "4.03.1.017"
      ]
    },
    {
      "id": "c13",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Espermiograma normal: motilidad progresiva ≥ {{c1::30 a 32%}}.",
      "extra": "Menor: astenozoospermia.",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Espermiograma",
      "repaso": false,
      "codigos": [
        "4.03.1.017"
      ]
    },
    {
      "id": "c14",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Espermiograma normal: morfología normal (Kruger) ≥ {{c1::4%}}.",
      "extra": "Menor: teratozoospermia.",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Espermiograma",
      "repaso": false,
      "codigos": [
        "4.03.1.017"
      ]
    },
    {
      "id": "c15",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Espermiograma normal: volumen ≥ {{c1::1.4 a 1.5 mL}}.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Espermiograma",
      "repaso": false,
      "codigos": [
        "4.03.1.017"
      ]
    },
    {
      "id": "c16",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Espermiograma alterado: se {{c1::repite}} en una segunda muestra antes de diagnosticar infertilidad masculina.",
      "extra": "El libro indica 4-12 semanas en una parte y 1-3 meses en otra.",
      "origen": "clase:10",
      "fuente": "Clase · Trampas",
      "repaso": true,
      "codigos": [
        "4.03.1.017"
      ]
    },
    {
      "id": "c17",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Progesterona en fase lútea media (día 21) > {{c1::3 a 5 ng/mL}} confirma ovulación.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Factor ovulatorio",
      "repaso": false,
      "codigos": [
        "3.01.1.020"
      ]
    },
    {
      "id": "c18",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Marcador más fiable de reserva ovárica: {{c1::hormona antimülleriana (AMH)}}.",
      "extra": "Se mide cualquier día del ciclo.",
      "origen": "libro:puntos",
      "fuente": "Libro · puntos clave",
      "repaso": true,
      "codigos": [
        "3.01.1.020"
      ]
    },
    {
      "id": "c19",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "AMH < {{c1::0.5-1.0 ng/mL}} indica baja reserva ovárica.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Reserva ovárica",
      "repaso": false,
      "codigos": [
        "3.01.1.020"
      ]
    },
    {
      "id": "c20",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "FSH día 3 > {{c1::10-12 UI/L}} predice pobre respuesta ovárica.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Reserva ovárica",
      "repaso": false,
      "codigos": [
        "3.01.1.020",
        "1.03.4.009"
      ]
    },
    {
      "id": "c21",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Recuento de folículos antrales < {{c1::5 a 7}} indica baja reserva.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Reserva ovárica",
      "repaso": false,
      "codigos": [
        "3.01.1.020"
      ]
    },
    {
      "id": "c22",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El factor tuboperitoneal se estudia con {{c1::histerosalpingografía}}, que evalúa la cavidad y la permeabilidad tubárica.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 HSG",
      "repaso": true,
      "codigos": [
        "3.01.1.020",
        "3.01.4.001"
      ],
      "preguntaReal": [
        "EUNACOM Agosto 2021 · Pregunta 146",
        "EUNACOM Julio 2019 · Pregunta 109"
      ]
    },
    {
      "id": "c23",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Prueba de Cotte positiva: paso libre del contraste al peritoneo = trompa {{c1::permeable}}.",
