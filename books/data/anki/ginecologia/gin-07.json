      "origen": "clase:5",
      "fuente": "Clase · Pilar tres y cuatro",
      "repaso": true,
      "codigos": [
        "3.01.4.001"
      ]
    },
    {
      "id": "c24",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La HSG se realiza en la {{c1::primera mitad}} del ciclo.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 HSG",
      "repaso": false,
      "codigos": [
        "3.01.4.001"
      ]
    },
    {
      "id": "c25",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Factor uterino: ecografía transvaginal y, si hay defectos de llene en la HSG, {{c1::histeroscopía}}.",
