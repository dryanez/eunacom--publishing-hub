      "origen": "clase:5",
      "fuente": "Clase · Pilar tres y cuatro",
      "repaso": false,
      "codigos": [
        "3.01.1.020",
        "3.01.4.001"
      ]
    },
    {
      "id": "c26",
      "modelo": "cloze",
      "tipo": "Algoritmo",
      "texto": "Inseminación intrauterina exige al menos {{c1::una trompa permeable}} y REM adecuado.",
