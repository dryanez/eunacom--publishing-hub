      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La dismenorrea de la endometriosis es progresiva y {{c1::no cede con AINEs}} habituales.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Tríada",
      "repaso": false,
      "codigos": [
        "3.01.1.015",
        "3.01.1.014"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Dispareunia profunda de la endometriosis: por tracción de ligamentos {{c1::uterosacros}} y tabique rectovaginal.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Tríada",
      "repaso": false,
      "codigos": [
        "3.01.1.015"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Infertilidad afecta al {{c1::30-50%}} de las pacientes con endometriosis.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Tríada",
      "repaso": false,
      "codigos": [
        "3.01.1.015"
      ]
    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Examen físico de la endometriosis: útero en {{c1::retroversión fija}} y nódulos dolorosos en el Douglas y uterosacros.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Tríada",
      "repaso": true,
      "codigos": [
        "3.01.1.015"
      ]
    },
    {
      "id": "c12",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Ecografía del endometrioma: quiste con ecos finos homogéneos en {{c1::vidrio esmerilado}}.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · puntos clave",
