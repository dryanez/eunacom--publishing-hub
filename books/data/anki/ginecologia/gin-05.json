    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Endometriosis en tabique rectovaginal o recto-sigmoides causa {{c1::disquecia}} cíclica.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Localizaciones",
      "repaso": false,
      "codigos": [
        "3.01.1.015"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Endometriosis en vejiga o uréteres: disuria cíclica y {{c1::hematuria catamenial}}.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Localizaciones",
      "repaso": false,
      "codigos": [
        "3.01.1.015"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Endometriosis en pleura o diafragma: {{c1::neumotórax catamenial}}.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Localizaciones",
      "repaso": false,
      "codigos": [
        "3.01.1.015"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Tríada de la endometriosis: dismenorrea progresiva, {{c1::dispareunia profunda}} e {{c2::infertilidad}}.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · puntos clave",
      "repaso": true,
      "codigos": [
        "3.01.1.015"
