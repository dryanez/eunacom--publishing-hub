      "id": "c03",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Localización más frecuente de la endometriosis: {{c1::ovarios}} (endometrioma o 'quiste de chocolate').",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · puntos clave",
