    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Teoría más aceptada de la endometriosis: {{c1::menstruación retrógrada}} (Sampson).",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · puntos clave",
      "repaso": true,
      "codigos": [
        "3.01.1.015"
