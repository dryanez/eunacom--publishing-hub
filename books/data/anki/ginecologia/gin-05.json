      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Endometriosis: tejido endometrial funcional {{c1::fuera de la cavidad uterina}}.",
      "extra": "Enfermedad inflamatoria crónica estrógeno-dependiente.",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Fisiopatología",
      "repaso": false,
