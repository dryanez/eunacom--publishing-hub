  "cards": [
    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "GES",
      "texto": "El cáncer cervicouterino está cubierto por el {{c1::GES N° 3}} (tamizaje, diagnóstico, tratamiento y seguimiento).",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · puntos clave",
      "codigos": [
        "3.01.1.013"
      ],
      "repaso": true
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El cáncer cervicouterino se debe a infección persistente por genotipos oncogénicos del {{c1::VPH}}, sobre todo 16 y 18.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · puntos clave",
      "codigos": [
        "3.01.1.013"
      ],
      "repaso": true
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "VPH 16 se asocia al carcinoma epidermoide; el VPH 18 al {{c1::adenocarcinoma endocervical}}.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 VPH",
      "codigos": [
        "3.01.1.013"
      ],
      "repaso": false
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La oncoproteína E6 degrada a {{c1::p53}}; la E7 inactiva a {{c2::pRb}}.",
      "extra": "Bloquean la apoptosis y generan inestabilidad genómica.",
      "origen": "libro:puntos",
      "fuente": "Libro · puntos clave",
      "codigos": [
        "3.01.1.013"
      ],
      "repaso": true
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La vacuna nonavalente contra VPH es gratuita en escolares de {{c1::4.º y 5.º básico}}.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Tamizaje",
      "codigos": [
        "3.01.1.013"
      ],
      "repaso": false
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "GES",
      "texto": "Tamizaje GES: PAP cada {{c1::3 años}} en mujeres de 25 a 64 años.",
      "extra": "Tras dos exámenes anuales consecutivos negativos.",
      "origen": "libro:puntos",
      "fuente": "Libro · puntos clave",
      "codigos": [
        "3.01.1.013",
        "3.01.3.013"
      ],
      "repaso": true
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Test de ADN-VPH como tamizaje primario desde los {{c1::30 años}}, cada 5 años si es negativo.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Tamizaje",
      "codigos": [
        "3.01.3.013"
      ],
      "repaso": false
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "ASC-US significa células escamosas atípicas de {{c1::significado indeterminado}}; ASC-H, no se puede descartar lesión de alto grado.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Bethesda",
      "codigos": [
        "3.01.1.016"
      ],
      "repaso": false
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "LIEBG (L-SIL) equivale a {{c1::NIE I}}; LIEAG (H-SIL) equivale a NIE II y NIE III.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Bethesda",
      "codigos": [
        "3.01.1.016"
      ],
      "repaso": true
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "La LIEBG regresiona sola en más del {{c1::80%}} dentro de 2 años.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Bethesda",
      "codigos": [
        "3.01.1.016"
      ],
      "repaso": false,
      "preguntaReal": [
        "EUNACOM Julio 2015 · Pregunta 159"
      ],
