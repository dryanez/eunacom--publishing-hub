    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "LIEAG (NIE II-III) tiene alto riesgo de {{c1::progresar a cáncer invasor}}.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Bethesda",
      "codigos": [
        "3.01.1.016"
      ],
      "repaso": false,
      "imagen": "biblioteca/13_ginecologia/gin-13/02_colposcopia_hsil__williams-gyn_p665.jpg"
    },
    {
      "id": "c12",
      "modelo": "cloze",
      "tipo": "GES",
      "texto": "PAP con LIEAG, ASC-H o AGC: colposcopía y biopsia en la UPC en menos de {{c1::30 días}}.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Derivación",
      "codigos": [
        "3.01.1.016"
      ],
      "repaso": true,
