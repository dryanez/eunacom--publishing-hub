      "tipo": "Farmaco",
      "texto": "Antifibrinolítico no hormonal de elección si busca embarazo: {{c1::ácido tranexámico}} oral.",
      "extra": "Reduce la pérdida 40-50%.",
      "origen": "clase:7",
