      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Hiperplasia sin atipia: primera elección el {{c1::DIU de levonorgestrel 52 mg}}.",
      "extra": "",
      "origen": "libro:sec:4",
      "fuente": "Libro §4 Hiperplasia",
