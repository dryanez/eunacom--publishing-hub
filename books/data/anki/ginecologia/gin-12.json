      ]
    },
    {
      "id": "c26",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Estrógeno tópico vaginal: fase inicial diaria por 2 semanas y mantención {{c1::2 o 3 veces por semana}}.",
      "extra": "",
      "origen": "clase:14",
      "fuente": "Clase · Quiz Perfil V3",
      "codigos": [
