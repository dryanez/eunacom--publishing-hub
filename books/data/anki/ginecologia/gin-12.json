    },
    {
      "id": "c27",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Dispareunia por atrofia en la persona mayor: {{c1::lubricantes, hidratantes}} y estrógenos vaginales locales.",
      "extra": "",
