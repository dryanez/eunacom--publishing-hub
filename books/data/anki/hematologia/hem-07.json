      "id": "c18",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El síndrome de Evans es AHAI más {{c1::trombocitopenia inmune}}.",
      "extra": "",
      "origen": "clase:5",
      "fuente": "Clase · Clínica",
      "repaso": false,
      "codigos": [
        "1.08.1.003"
      ]
    },
