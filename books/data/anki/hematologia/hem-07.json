  "cards": [
    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Los cuatro pilares de la hemólisis: IRC > 2 %, LDH alta, bilirrubina {{c1::indirecta}} alta y haptoglobina baja.",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · Pilares",
      "repaso": true,
      "codigos": [
        "1.08.4.010"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "En hemólisis la bilirrubina indirecta suele estar entre {{c1::2 y 5 mg/dL}}.",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · Pilares",
      "repaso": false,
      "codigos": [
        "1.08.4.010"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "En hemólisis la haptoglobina cae a < {{c1::10 mg/dL}}.",
      "extra": "Se consume al unir hemoglobina libre.",
      "origen": "clase:1",
      "fuente": "Clase · Pilares",
      "repaso": true,
      "codigos": [
        "1.08.4.010"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "En hemólisis el VCM puede estar algo alto porque los {{c1::reticulocitos}} son células grandes.",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · Pilares",
      "repaso": false,
      "codigos": [
        "1.08.4.010"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "La AHAI por anticuerpos calientes es el {{c1::80 a 90 %}} de las AHAI; las crioaglutininas, 10 a 15 %.",
      "extra": "",
      "origen": "clase:12",
      "fuente": "Clase · Tabla de trampas",
      "repaso": false,
      "codigos": [
        "1.08.1.003"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "AHAI caliente: autoanticuerpo {{c1::IgG}} con máxima afinidad a 37 °C.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Anticuerpos calientes",
      "repaso": true,
      "codigos": [
        "1.08.1.003"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "En AHAI caliente la hemólisis es {{c1::extravascular en el bazo}}, por macrófagos con receptores Fc-gamma.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Anticuerpos calientes",
      "repaso": false,
      "codigos": [
        "1.08.1.003"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El frotis de AHAI caliente muestra {{c1::microesferocitos}}.",
      "extra": "Pierden membrana, no volumen.",
      "origen": "clase:12",
      "fuente": "Clase · Tabla de trampas",
      "repaso": false,
      "imagen": "biblioteca/06_hematologia/hem-07/01_esferocitos__amir-hemato_p34.jpg",
      "codigos": [
        "1.08.1.003"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "AHAI caliente puede ser idiopática o secundaria a {{c1::LES, LLC}} o fármacos como metildopa y cefalosporinas.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Fisiopatología",
      "repaso": false,
      "codigos": [
        "1.08.1.003"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Crioaglutininas: autoanticuerpo {{c1::IgM}} que se une a 0–4 °C en las acras y fija complemento.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Crioaglutininas",
      "repaso": true,
      "codigos": [
        "1.08.1.003"
      ]
    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Las crioaglutininas se asocian a {{c1::Mycoplasma}}, VEB y linfoma B.",
      "extra": "",
      "origen": "clase:12",
      "fuente": "Clase · Tabla de trampas",
      "repaso": true,
      "codigos": [
        "1.08.1.003"
      ]
    },
    {
      "id": "c12",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Las crioaglutininas dan acrocianosis, livedo reticularis y {{c1::Raynaud}} con el frío.",
      "extra": "",
      "origen": "clase:5",
      "fuente": "Clase · Clínica",
      "repaso": false,
      "imagen": "biblioteca/06_hematologia/hem-07/01_raynaud-palidez-cianosis__amir-reuma_p98.jpg",
      "codigos": [
        "1.08.1.003"
      ]
    },
    {
      "id": "c13",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El frotis de crioaglutininas muestra {{c1::autoaglutinación}} de glóbulos rojos.",
      "extra": "Aparece al enfriarse la muestra.",
      "origen": "clase:12",
      "fuente": "Clase · Tabla de trampas",
      "repaso": false,
      "imagen": "biblioteca/06_hematologia/hem-07/atlas_123_autoaglutinacion_por_crioaglut.jpg",
      "codigos": [
        "1.08.1.003"
      ]
    },
    {
      "id": "c14",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La prueba confirmatoria de AHAI es el {{c1::Coombs directo}}.",
      "extra": "Detecta anticuerpo o complemento ya fijado in vivo.",
      "origen": "clase:4",
      "fuente": "Clase · Coombs",
      "repaso": true,
      "imagen": "biblioteca/06_hematologia/hem-07/S1_coombs__propio.svg",
