        "1.08.4.010"
      ]
    },
    {
      "id": "c17",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La ictericia de la hemólisis es {{c1::flavínica}} (amarillo pálido) y no hay coluria verdadera.",
      "extra": "La bilirrubina indirecta no filtra por el glomérulo.",
      "origen": "clase:5",
      "fuente": "Clase · Clínica",
      "repaso": false,
      "imagen": "biblioteca/06_hematologia/hem-07/02_ictericia_escleral__commons.jpg",
