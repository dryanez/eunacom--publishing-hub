      ]
    },
    {
      "id": "c15",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Coombs directo en AHAI caliente: positivo para {{c1::IgG}} (± C3d).",
      "extra": "",
      "origen": "clase:4",
      "fuente": "Clase · Coombs",
