      "id": "c20",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Crisis hemolítica con descompensación: metilprednisolona {{c1::1 g EV}} por 3 días.",
      "extra": "",
      "origen": "clase:7",
      "fuente": "Clase · Tratamiento",
      "repaso": true,
      "codigos": [
        "1.08.1.003"
