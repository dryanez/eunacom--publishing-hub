      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La hemostasia secundaria (factores) da sangrado {{c1::profundo y retardado}}: hematomas musculares y hemartrosis.",
