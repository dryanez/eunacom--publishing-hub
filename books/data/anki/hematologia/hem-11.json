      "codigos": [
        "4.01.4.013"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "El factor VII tiene la vida media más corta, {{c1::4–6 h}}, por eso el TP es lo primero en alterarse.",
