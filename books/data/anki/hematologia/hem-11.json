      "fuente": "Clase · Fisiología",
      "repaso": false,
      "codigos": [
        "1.08.4.007"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "In vivo el iniciador real de la coagulación es el complejo factor tisular + {{c1::VIIa}}.",
