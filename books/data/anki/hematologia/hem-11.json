      "fuente": "Clase · TP e INR",
      "repaso": true,
      "codigos": [
        "4.01.4.013"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El TP evalúa la vía {{c1::extrínseca}} y común (VII, X, V, II y fibrinógeno).",
