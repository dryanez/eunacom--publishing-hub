      "codigos": [
        "1.08.4.005"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El fibrinógeno une las plaquetas a través del receptor {{c1::GP IIb/IIIa}}.",
      "extra": "Su déficit es la tromboastenia de Glanzmann.",
