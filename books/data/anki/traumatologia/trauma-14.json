   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Enfermedad de Perthes: {{c1::5-10 años}}, talla baja y actividad intensa; cabeza femoral plana y densa.",
   "extra": "Necrosis avascular de la cabeza femoral.",
   "origen": "libro:tabla",
   "fuente": "Libro · tabla cadera dolorosa",
   "repaso": true,
