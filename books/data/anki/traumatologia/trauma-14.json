   ]
  },
  {
   "id": "c18",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Se deriva el pie plano {{c1::rígido}}, doloroso o unilateral; se sospecha coalición tarsiana o astrágalo vertical.",
   "extra": "",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Pie plano",
