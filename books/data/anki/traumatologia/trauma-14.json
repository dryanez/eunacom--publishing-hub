   "codigos": [
    "4.02.1.009"
   ]
  },
  {
   "id": "c16",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "El pie plano flexible es fisiológico: el arco aparece de {{c1::puntillas}}; no requiere plantillas.",
