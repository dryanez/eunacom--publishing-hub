   ]
  },
  {
   "id": "c19",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "El pie {{c1::cavo}} tiene arco aumentado; se busca causa neurológica (Charcot-Marie-Tooth o disrafismo).",
