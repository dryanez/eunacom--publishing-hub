  },
  {
   "id": "c11",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Sinovitis transitoria: {{c1::2-4 años}}, infección viral previa y radiografía normal; paracetamol y reposo.",
   "extra": "Sin fiebre, buen estado general.",
   "origen": "libro:tabla",
   "fuente": "Libro · tabla cadera dolorosa",
