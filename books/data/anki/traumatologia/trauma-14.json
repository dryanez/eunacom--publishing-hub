   ]
  },
  {
   "id": "c14",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "En la sinovitis transitoria, si hay duda con artritis séptica se hace {{c1::punción articular}}: el líquido es normal.",
   "extra": "",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Sinovitis",
   "repaso": false,
   "codigos": [
    "4.02.1.009"
   ]
