  },
  {
   "id": "c21",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La fisis es el eslabón más débil del hueso inmaduro; Salter-Harris {{c1::II}} (fisis y metáfisis) es la más frecuente, ~75%.",
   "extra": "",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Salter-Harris",
   "repaso": false,
   "imagen": "biblioteca/18_traumatologia/trauma-14/21_salter-harris__sherman_p764.jpg",
   "codigos": [
    "4.02.2.002"
   ]
  },
  {
   "id": "c22",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Las lesiones Salter-Harris {{c1::III, IV y V}} comprometen el crecimiento (detención, deformidad angular, dismetría).",
   "extra": "",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Salter-Harris",
   "repaso": false,
   "codigos": [
    "4.02.2.002"
   ]
  },
  {
   "id": "c23",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Dolor sobre la fisis con radiografía normal en un niño: se trata como {{c1::fractura}} (tipo I).",
   "extra": "",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Salter-Harris",
   "repaso": false,
   "codigos": [
    "4.02.2.002"
   ]
  },
  {
   "id": "c24",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Salter-Harris I y II se inmovilizan con yeso {{c1::3-4 semanas}}; III y IV requieren reducción anatómica quirúrgica.",
   "extra": "",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Salter-Harris",
   "repaso": false,
   "codigos": [
    "4.02.2.002"
   ]
  },
  {
   "id": "c25",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La escoliosis idiopática del adolescente afecta a niñas de 10-14 años, con curva torácica derecha y Cobb > {{c1::10°}}.",
   "extra": "",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Columna",
   "repaso": false,
   "codigos": [
    "2.01.1.094"
   ]
  },
  {
   "id": "c26",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Se pide RM en escoliosis con dolor, curva torácica {{c1::izquierda}}, déficit neurológico o inicio antes de los 10 años.",
   "extra": "",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Columna",
   "repaso": false,
   "codigos": [
    "2.01.1.094"
   ]
  },
  {
   "id": "c27",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "La enfermedad de Scheuermann es una cifosis torácica rígida > {{c1::45°}} con acuñamiento de 3 o más vértebras.",
