   "id": "c15",
   "modelo": "cloze",
   "tipo": "Trampa",
   "texto": "Cojera con fiebre en el niño: pensar en {{c1::artritis séptica}} y puncionar.",
   "extra": "",
   "origen": "clase:12",
   "fuente": "Clase · Tabla de trampas",
