      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Toxíndrome opioide: coma, depresión respiratoria y {{c1::miosis puntiforme}}.",
      "extra": "",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla toxíndromes",
      "repaso": true,
