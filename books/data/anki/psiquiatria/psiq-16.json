      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Toxíndrome anticolinérgico: {{c1::midriasis arreactiva}}, piel seca y roja, taquicardia e hipertermia.",
      "extra": "",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla toxíndromes",
      "repaso": false,
