    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La clave decisiva para diferenciar los trastornos psicóticos en las viñetas es la {{c1::cronología}}.",
      "extra": "",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 Diferencial",
      "repaso": true,
      "codigos": [
        "5.01.1.010"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Trastorno psicótico breve: duración de al menos {{c1::1 día}} pero menos de {{c2::1 mes}}.",
      "extra": "",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla diferencial",
      "repaso": false,
      "codigos": [
        "5.01.1.010"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "En el trastorno psicótico breve hay retorno {{c1::completo (ad integrum)}} al nivel de funcionamiento previo.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Psicótico breve",
      "repaso": true,
      "codigos": [
        "5.01.1.010"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El trastorno psicótico breve suele aparecer tras un {{c1::estresor grave}} o en el posparto.",
      "extra": "Antes llamada psicosis reactiva breve.",
      "origen": "clase:2",
      "fuente": "Clase · Psicótico breve",
      "repaso": false,
      "codigos": [
        "5.01.1.010"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El trastorno psicótico breve exige al menos un síntoma: delirios, alucinaciones, lenguaje desorganizado o {{c1::comportamiento muy desorganizado o catatónico}}.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Psicótico breve",
      "repaso": false,
      "codigos": [
        "5.01.1.010"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Manejo del psicótico breve: contención protegida y {{c1::antipsicótico en dosis baja por tiempo limitado}}.",
      "extra": "Semanas a pocos meses; pronóstico excelente.",
      "origen": "clase:2",
      "fuente": "Clase · Manejo",
      "repaso": false,
      "codigos": [
        "5.01.1.010"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Trastorno esquizofreniforme: clínica idéntica a esquizofrenia con duración de {{c1::1 a 6 meses}}.",
      "extra": "",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla diferencial",
      "repaso": false,
      "codigos": [
        "5.01.1.010"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Si los síntomas del esquizofreniforme superan los {{c1::6 meses}}, se reclasifica como esquizofrenia.",
      "extra": "",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 Diferencial",
      "repaso": true,
      "codigos": [
        "5.01.1.010"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Del trastorno esquizofreniforme, entre {{c1::60-80%}} progresa a esquizofrenia.",
      "extra": "Pronóstico reservado.",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla diferencial",
      "repaso": false,
      "codigos": [
        "5.01.1.010"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Esquizofrenia: duración de {{c1::6 meses}} o más, con síntomas negativos y deterioro global.",
      "extra": "",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla diferencial",
      "repaso": false,
      "codigos": [
        "5.01.1.010"
      ]
    },
