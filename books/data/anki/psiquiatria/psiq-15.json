      "id": "c30",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "AUDIT tiene {{c1::10}} preguntas y clasifica el riesgo de consumo en APS.",
      "extra": "Menos de 8 bajo riesgo; 8 a 15 intervención breve; más de 16 derivar.",
      "origen": "clase:10",
      "fuente": "Clase · Tamizaje",
      "repaso": false,
      "codigos": [
        "5.01.5.001",
        "1.10.2.004"
      ]
    },
    {
      "id": "c31",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Etapas de Prochaska: precontemplación, contemplación, preparación, acción y {{c1::mantenimiento}}.",
      "extra": "Se adapta la intervención a la etapa, sin confrontar.",
      "origen": "libro:sec:4",
      "fuente": "Libro §4 Entrevista motivacional",
      "repaso": false,
      "codigos": [
        "5.01.1.012"
      ]
    },
    {
      "id": "c32",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Naltrexona (antagonista opioide mu) reduce el {{c1::craving}}.",
      "extra": "Contraindicada con opioides o falla hepática aguda.",
