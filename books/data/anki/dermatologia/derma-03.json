      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Metronidazol tópico en rosácea: {{c1::0.75% o 1%}} en gel o crema.",
      "extra": "",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 Manejo",
      "repaso": false,
      "codigos": [
        "6.01.1.026"
      ]
