      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Ivermectina tópica en rosácea: concentración {{c1::1%}}.",
      "extra": "Antiparasitario frente a Demodex y antiinflamatorio.",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 Manejo",
      "repaso": false,
      "codigos": [
        "6.01.1.026"
      ]
