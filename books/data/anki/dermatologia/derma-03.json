{
  "classId": "derma-03",
  "cards": [
    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Regla de oro: la rosácea {{c1::NUNCA tiene comedones}}; si hay comedones es acné.",
      "extra": "Pápulas, pústulas y eritema pueden ser idénticos al acné.",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "codigos": [
        "6.01.1.026"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Ante eritema facial con pápulas, el error es {{c1::diagnosticar acné del adulto sin buscar comedones}}.",
      "extra": "",
      "origen": "clase:6",
      "fuente": "Clase · Tabla de trampas",
      "repaso": false,
      "codigos": [
        "6.01.1.026"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La rosácea combina disregulación vascular, aumento de catelicidina {{c1::LL-37}} y colonización por Demodex folliculorum.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Fisiopatología",
      "repaso": false,
      "codigos": [
        "6.01.1.026"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El ácaro asociado a rosácea es {{c1::Demodex folliculorum}}.",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · Por qué se enrojece",
      "repaso": false,
      "codigos": [
        "6.01.1.026"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Desencadenantes de flushing en rosácea: sol, calor, {{c1::alcohol}}, picantes y estrés.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Desencadenantes",
      "repaso": true,
      "codigos": [
        "6.01.1.026"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Subtipo 1 de rosácea: eritematotelangiectásica = {{c1::eritema fijo centrofacial}}, flushing y telangiectasias finas.",
      "extra": "Ardor o quemazón.",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Subtipos",
      "repaso": false,
      "codigos": [
        "6.01.1.026"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Subtipo 2 de rosácea: {{c1::pápulo-pustulosa}}, sin comedones, típica en mujeres de 30 a 50 años.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Subtipos",
      "repaso": true,
      "imagen": "biblioteca/11_dermatologia/derma-03/01_rosacea_alt1__amir-derma_p84.jpg",
      "codigos": [
        "6.01.1.026"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Subtipo 3 de rosácea: fimatosa, cuyo prototipo es el {{c1::rinofima}} en varones.",
      "extra": "Hipertrofia sebácea y fibrosis.",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Subtipos",
      "repaso": false,
      "imagen": "biblioteca/11_dermatologia/derma-03/02_rinofima__amir-orl_p41.jpg",
      "codigos": [
        "6.01.1.026"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Subtipo 4 de rosácea: {{c1::ocular}} (blefaritis, arenilla, chalazión recurrente), hasta en 50% de los pacientes.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Subtipos",
      "repaso": false,
      "codigos": [
        "6.01.1.026"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Medida general en toda rosácea: fotoprotector de amplio espectro FPS {{c1::50+}} diario.",
      "extra": "",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 Manejo",
      "repaso": false,
      "codigos": [
        "6.01.1.026"
      ]
    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Flushing y eritema vascular de la rosácea: {{c1::brimonidina}} tópica (agonista alfa-2) o láser vascular/IPL.",
      "extra": "Vasoconstricción temporal.",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 Manejo",
      "repaso": true,
      "codigos": [
        "6.01.1.026"
      ]
    },
    {
      "id": "c12",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Rosácea pápulo-pustulosa leve: primera línea tópica = {{c1::metronidazol o ivermectina}}.",
      "extra": "",
      "origen": "clase:4",
      "fuente": "Clase · Manejo por subtipo",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Diciembre 2018 · Pregunta 61"
