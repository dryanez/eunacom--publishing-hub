      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Contacto irritativa: lesión confinada a la zona de contacto con síntoma cardinal de {{c1::ardor y quemazón}}.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Irritativa",
      "repaso": false,
      "codigos": [
        "6.01.1.007"
