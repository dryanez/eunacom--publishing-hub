    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Dermatitis seborreica del adulto: escamas {{c1::grasosas, untuosas y amarillentas}} en zonas de alta densidad sebácea.",
      "extra": "Cuero cabelludo, surcos nasogenianos, entrecejo, esternal.",
