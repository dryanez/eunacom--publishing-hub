    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Dermatitis de contacto irritativa: representa el {{c1::80%}} de las dermatitis de contacto.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Irritativa",
