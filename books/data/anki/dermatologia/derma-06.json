        "6.01.1.004",
        "2.01.1.107"
      ]
    },
    {
      "id": "c22",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Impetiginización del atópico: antibiótico tópico ({{c1::mupirocina}}) u oral (cefadroxilo).",
      "extra": "",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 Complicaciones",
