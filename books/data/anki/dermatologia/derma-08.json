      "codigos": [
        "6.01.1.030",
        "6.01.2.016"
      ]
    },
    {
      "id": "c21",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Urticaria crónica espontánea (80%): mediada por autoanticuerpos {{c1::IgG}} contra el receptor FcεRI o la IgE.",
      "extra": "",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 Clasificación",
      "repaso": false,
      "codigos": [
        "6.01.1.030",
        "6.01.2.016"
