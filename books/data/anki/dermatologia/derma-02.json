    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La lesión elemental obligatoria que define al acné vulgar es el {{c1::comedón}}.",
      "extra": "Tapón queratínico del ostium folicular.",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "codigos": [
        "6.01.1.001",
        "2.01.1.104"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Pilar 1 del acné: {{c1::hiperqueratinización folicular}} del infundíbulo, que forma el comedón.",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · Cuatro pilares",
      "repaso": false,
      "codigos": [
        "6.01.1.001",
        "2.01.1.104"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Pilar 2 del acné: hipersecreción sebácea estimulada por {{c1::andrógenos}} en la pubertad.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Fisiopatología",
      "repaso": false,
      "codigos": [
        "6.01.1.001",
        "2.01.1.104"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Pilar 3 del acné: proliferación de {{c1::Cutibacterium acnes}} (antes Propionibacterium acnes).",
      "extra": "Degrada triglicéridos a ácidos grasos libres proinflamatorios.",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Fisiopatología",
      "repaso": false,
      "codigos": [
        "6.01.1.001",
        "2.01.1.104"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Comedón abierto = «punto negro», por {{c1::oxidación de melanina y queratina}}; el cerrado es el «punto blanco».",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Clasificación",
      "repaso": false,
      "codigos": [
        "6.01.1.001",
        "2.01.1.104"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El acné {{c1::comedoniano}} es la forma no inflamatoria: solo comedones abiertos y cerrados.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Formas clínicas",
      "repaso": false,
      "codigos": [
        "6.01.1.001",
        "2.01.1.104"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El acné nódulo-quístico tiene alto riesgo de cicatrices atróficas «{{c1::en picahielo}}» o queloideas.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Clasificación",
      "repaso": false,
      "codigos": [
        "6.01.1.001",
        "2.01.1.104"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Acné comedoniano: tratamiento de elección = {{c1::retinoide tópico}} (adapaleno, tretinoína), aplicado de noche.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Escalamiento",
      "repaso": true,
      "codigos": [
        "6.01.1.001",
        "2.01.1.104"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Adapaleno para acné comedoniano: concentración {{c1::0.1%}} en gel nocturno.",
      "extra": "",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla acné",
      "repaso": false,
      "codigos": [
        "6.01.1.001",
        "2.01.1.104"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "El peróxido de benzoilo es queratolítico y bactericida y {{c1::no genera resistencia}} bacteriana.",
