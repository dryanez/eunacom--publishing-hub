{
  "classId": "derma-17",
  "cards": [
    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El tumor epitelial benigno más frecuente del adulto mayor es la queratosis {{c1::seborreica}}.",
      "extra": "Placa verrugosa «pegada» (stuck-on), café a negra.",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Queratosis seborreica",
      "repaso": true,
      "codigos": [
        "6.01.1.028"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La queratosis seborreica {{c1::no malignizan}} y no requiere tratamiento; se biopsia si cambia, sangra o hay duda.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Queratosis seborreica",
      "repaso": false,
      "codigos": [
        "6.01.1.028"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La aparición brusca de muchas queratosis seborreicas con prurito es el signo de {{c1::Leser-Trélat}}.",
      "extra": "Sugiere neoplasia interna, sobre todo digestiva.",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Queratosis seborreica",
      "repaso": true,
      "codigos": [
        "6.01.1.028"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El quiste epidérmico es un nódulo móvil con {{c1::punctum}} central y contenido de queratina.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Quistes",
      "repaso": true,
      "codigos": [
        "6.01.1.028"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Tratamiento del quiste epidérmico: extirpar la {{c1::pared completa}} fuera de la fase inflamatoria; si queda, recidiva.",
      "extra": "",
      "origen": "clase:14",
      "fuente": "Clase · Tabla de trampas",
      "repaso": true,
      "codigos": [
        "6.01.1.028"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Un quiste epidérmico inflamado se extirpa {{c1::4 a 6 semanas}} después.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Quistes",
      "repaso": false,
      "codigos": [
        "6.01.1.028"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El tumor benigno de partes blandas más frecuente es el {{c1::lipoma}}: nódulo subcutáneo blando, móvil e indoloro.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Lipoma",
      "repaso": false,
      "codigos": [
        "6.01.1.028"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Sospechar liposarcoma si el nódulo mide más de {{c1::5 cm}}, es profundo, firme, doloroso o crece rápido.",
      "extra": "Se pide resonancia y biopsia.",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Lipoma",
      "repaso": true,
      "codigos": [
        "6.01.1.028"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Dermatofibroma: nódulo firme en piernas de mujeres jóvenes con signo del {{c1::hoyuelo}} al comprimirlo.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Dermatofibroma",
      "repaso": false,
      "codigos": [
        "6.01.1.028"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El queloide {{c1::sobrepasa}} los bordes de la herida, aparece meses después y no regresa.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Diciembre 2025 · Pregunta 83"
      ],
      "codigos": [
        "6.01.1.028"
      ]
    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La cicatriz hipertrófica {{c1::no sobrepasa}} los bordes de la herida y tiende a regresar en 1 a 2 años.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "codigos": [
        "6.01.1.028"
      ]
    },
    {
      "id": "c12",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Nódulo en el sitio de una perforación de la oreja que crece: {{c1::queloide}}.",
      "extra": "Más frecuente en fototipos oscuros, esternón, hombros y lóbulo.",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Cicatrices",
      "repaso": false,
      "preguntaReal": [
        "EUNACOM Diciembre 2018 · Pregunta 64"
      ],
      "codigos": [
        "6.01.1.028"
      ]
    },
    {
      "id": "c13",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Primera línea del queloide: {{c1::triamcinolona}} intralesional.",
      "extra": "La cirugía sola recidiva en más de la mitad.",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla lesiones",
      "repaso": true,
      "codigos": [
        "6.01.1.028"
      ]
    },
    {
      "id": "c14",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El hemangioma infantil es el tumor vascular benigno más frecuente de la infancia y es GLUT-1 {{c1::positivo}}.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Hemangioma",
      "repaso": true,
      "codigos": [
        "6.01.1.013"
      ]
    },
    {
      "id": "c15",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El hemangioma infantil {{c1::no está al nacer}}: aparece semanas después, crece 3 a 5 meses y luego involuciona.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Julio 2015 · Pregunta 90"
      ],
      "codigos": [
        "6.01.1.013",
        "2.01.1.111"
      ]
    },
    {
      "id": "c16",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El hemangioma superficial es una placa rojo brillante «en {{c1::fresa}}»; el profundo, un nódulo azulado.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Hemangioma",
      "repaso": false,
      "codigos": [
        "6.01.1.013"
      ]
    },
    {
      "id": "c17",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La complicación más frecuente del hemangioma infantil es la {{c1::ulceración}}.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Complicaciones",
      "repaso": false,
      "codigos": [
        "6.01.1.013"
      ]
    },
    {
      "id": "c18",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El hemangioma periorbitario puede causar {{c1::ambliopía}} y astigmatismo.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Complicaciones",
      "repaso": false,
      "preguntaReal": [
        "EUNACOM Agosto 2021 · Pregunta 83",
        "EUNACOM Diciembre 2017 · Pregunta 87"
      ],
      "codigos": [
        "6.01.1.013"
      ]
    },
    {
      "id": "c19",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Con {{c1::5 o más}} hemangiomas cutáneos se pide ecografía abdominal para descartar compromiso hepático.",
      "extra": "También se mide TSH.",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Julio 2024 · Pregunta 125",
        "EUNACOM Julio 2024 · Pregunta 126",
        "EUNACOM Enero 2023 · Pregunta 19"
      ],
      "codigos": [
        "6.01.1.013"
      ]
    },
    {
      "id": "c20",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Un hemangioma segmentario facial grande hace sospechar síndrome {{c1::PHACE}}.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Complicaciones",
      "repaso": false,
      "codigos": [
        "6.01.1.013"
      ]
    },
    {
      "id": "c21",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Hemangioma lumbosacro en la línea media: descartar {{c1::disrafismo espinal}}.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Complicaciones",
      "repaso": false,
      "codigos": [
        "6.01.1.013"
      ]
    },
    {
      "id": "c22",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Un hemangioma pequeño sin riesgo funcional se {{c1::observa}} con fotografías seriadas y control mensual.",
      "extra": "",
      "origen": "clase:8",
      "fuente": "Clase · Tratamiento",
      "repaso": false,
      "codigos": [
        "6.01.1.013"
      ]
    },
    {
      "id": "c23",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Primera línea del hemangioma con riesgo funcional, ulcerado o periorbitario: {{c1::propranolol}} oral.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Agosto 2021 · Pregunta 83",
        "EUNACOM Diciembre 2017 · Pregunta 87"
      ],
      "codigos": [
        "6.01.1.013"
      ]
    },
    {
      "id": "c24",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Propranolol en hemangioma: {{c1::2 a 3 mg/kg/día}} por 6 a 12 meses.",
      "extra": "Suspenderlo antes produce rebote.",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "codigos": [
        "6.01.1.013"
      ]
    },
    {
      "id": "c25",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Propranolol se contraindica en asma, bradicardia y {{c1::bloqueo AV}}; se suspende si hay ayuno o vómitos (hipoglicemia).",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Tratamiento",
      "repaso": false,
      "codigos": [
        "6.01.1.013"
      ]
    },
    {
      "id": "c26",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Las malformaciones vasculares están presentes {{c1::al nacer}}, nunca involucionan y son GLUT-1 negativas.",
      "extra": "",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 Malformaciones",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Julio 2015 · Pregunta 90"
      ],
      "codigos": [
        "2.01.1.111"
      ]
    },
    {
      "id": "c27",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La mancha salmón (nevus simplex) {{c1::no requiere estudio ni tratamiento}}.",
      "extra": "Frente y párpados desaparecen en 1 a 2 años.",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla lesiones",
      "repaso": true,
      "codigos": [
        "2.01.1.111"
      ]
    },
    {
      "id": "c28",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La mancha en vino de Oporto no desaparece y su tratamiento es el {{c1::láser de colorante pulsado}}.",
      "extra": "",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 Malformaciones",
      "repaso": true,
      "codigos": [
        "2.01.1.111"
      ]
    },
    {
      "id": "c29",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Mancha en vino de Oporto en {{c1::V1}} (frente y párpado superior): sospechar síndrome de Sturge-Weber.",
      "extra": "Convulsiones y glaucoma; RM con contraste.",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "codigos": [
        "2.01.1.111"
      ]
    },
    {
      "id": "c30",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Malformación capilar, venosa e hipertrofia de un miembro: síndrome de {{c1::Klippel-Trénaunay}}.",
      "extra": "Riesgo de trombosis y embolia pulmonar.",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 Síndromes",
      "repaso": false,
      "codigos": [
        "2.01.1.111"
      ]
    },
    {
      "id": "c31",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Granuloma umbilical (lesión rosada húmeda tras caída del cordón): se puede cauterizar con {{c1::nitrato de plata}}.",
      "extra": "",
      "origen": "pregunta_real",
      "fuente": "Pregunta real Ago 2021 · 91",
      "repaso": false,
      "preguntaReal": [
        "EUNACOM Agosto 2021 · Pregunta 91"
      ],
      "codigos": [
        "6.01.1.028"
      ]
    },
