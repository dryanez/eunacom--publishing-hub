      ]
    },
    {
      "id": "c21",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "DM2 con IC con FEVI reducida sobre metformina: segundo fármaco {{c1::iSGLT2}} (empagliflozina o dapagliflozina).",
      "extra": "",
      "origen": "clase:10",
      "fuente": "Clase · Quiz caso clínico",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c22",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "En IC la {{c1::pioglitazona}} está contraindicada porque retiene líquido.",
      "extra": "",
      "origen": "clase:10",
      "fuente": "Clase · Quiz caso clínico",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c23",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Coronariopatía con HbA1c 8,2 % bajo metformina: se inicia {{c1::empagliflozina}}.",
      "extra": "También agonistas GLP-1.",
      "origen": "clase:11",
