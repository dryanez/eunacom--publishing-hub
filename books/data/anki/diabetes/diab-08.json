{
  "classId": "diab-08",
  "cards": [
    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Los iSGLT2 inhiben el cotransportador sodio-glucosa 2 en el túbulo {{c1::contorneado proximal}}.",
      "extra": "Causan glucosuria y natriuresis osmótica.",
      "origen": "clase:1",
      "fuente": "Clase · Gliflozinas",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Los iSGLT2 eliminan unos {{c1::60 a 80 g}} de glucosa al día por la orina.",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · Gliflozinas",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Los iSGLT2 bajan la HbA1c {{c1::0,6 a 0,8 %}}, el peso 2–3 kg y la PA 4–6 mmHg.",
      "extra": "Sin hipoglicemia.",
      "origen": "clase:1",
      "fuente": "Clase · Gliflozinas",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Beneficio mayor de los iSGLT2: menos hospitalizaciones por {{c1::insuficiencia cardíaca}} y freno de la caída de la VFG en ERC con albuminuria.",
      "extra": "Reducción > 30 %.",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 iSGLT2",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "El efecto adverso más frecuente de los iSGLT2 son las {{c1::micosis genitales}} (candidiasis vulvovaginal y balanitis).",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Efectos adversos iSGLT2",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "El efecto adverso grave de los iSGLT2 es la {{c1::cetoacidosis euglicémica}} (glicemia < 200–250 mg/dL).",
      "extra": "Gatillada por cirugía o ayuno; no descartar CAD por la glicemia.",
      "origen": "clase:2",
      "fuente": "Clase · Efectos adversos iSGLT2",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Con iSGLT2 y cirugía o ayuno prolongado, el error es {{c1::descartar cetoacidosis porque la glicemia es normal}}.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Efectos adversos iSGLT2",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Los iSGLT2 producen depleción de volumen e {{c1::hipotensión ortostática}} en ancianos.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Efectos adversos iSGLT2",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Los agonistas GLP-1 son liraglutida, semaglutida y {{c1::dulaglutida}}.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 GLP-1",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Los GLP-1 aumentan la insulina {{c1::glucosa-dependiente}}, suprimen el glucagón y enlentecen el vaciamiento gástrico.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Incretinas",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Los GLP-1 bajan la HbA1c {{c1::1,0 a 1,8 %}} y el peso 5 a 15 %.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Incretinas",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c12",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Los GLP-1 reducen IAM, ACV y muerte CV, según los estudios {{c1::LEADER y SUSTAIN-6}}.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Incretinas",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c13",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Liraglutida es subcutánea {{c1::diaria}}; semaglutida es subcutánea {{c2::semanal}} u oral diaria.",
      "extra": "",
      "origen": "clase:4",
      "fuente": "Clase · GLP-1 cómo se usan",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c14",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Los GLP-1 causan náuseas, vómitos y diarrea al inicio: se {{c1::titulan lentamente}}.",
      "extra": "",
      "origen": "clase:4",
      "fuente": "Clase · GLP-1 cómo se usan",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c15",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Los GLP-1 están contraindicados en antecedente personal o familiar de {{c1::carcinoma medular de tiroides o NEM 2}}.",
      "extra": "",
      "origen": "clase:4",
      "fuente": "Clase · GLP-1 cómo se usan",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c16",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Las gliptinas son sitagliptina, vildagliptina y {{c1::linagliptina}}; inhiben la enzima DPP-4.",
      "extra": "",
      "origen": "clase:5",
      "fuente": "Clase · Gliptinas",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c17",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Las gliptinas bajan la HbA1c {{c1::0,5 a 0,7 %}}, con peso neutro y sin hipoglicemia.",
      "extra": "",
      "origen": "clase:5",
      "fuente": "Clase · Gliptinas",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c18",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Efecto adverso raro de las gliptinas: {{c1::pancreatitis aguda}}.",
      "extra": "",
      "origen": "clase:5",
      "fuente": "Clase · Gliptinas",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c19",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "La {{c1::linagliptina}} es de eliminación biliar y no requiere ajuste en ningún grado de falla renal.",
      "extra": "De elección en hemodiálisis.",
      "origen": "clase:5",
      "fuente": "Clase · Gliptinas",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.3.003"
      ]
    },
    {
      "id": "c20",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Anciano con infarto reciente y diarrea por metformina: cambiar a {{c1::sitagliptina}} (sin hipoglicemia).",
      "extra": "",
      "origen": "clase:12",
      "fuente": "Clase · Quiz Dic 2018",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Diciembre 2018 · Pregunta 107"
      ],
      "codigos": [
        "1.02.1.005",
