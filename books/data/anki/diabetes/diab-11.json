      ]
    },
    {
      "id": "c27",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "La insulina abierta dura a temperatura ambiente hasta {{c1::28–30 días}}.",
      "extra": "",
      "origen": "clase:6",
      "fuente": "Clase · Conservación",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
