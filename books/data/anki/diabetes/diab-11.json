        "1.02.1.005"
      ]
    },
    {
      "id": "c21",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Inicio de insulina en APS: NPH al acostarse a {{c1::10 UI}} o 0,1–0,2 UI/kg, manteniendo la metformina.",
      "extra": "",
      "origen": "clase:16",
      "fuente": "Clase · Reglas de oro",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c22",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Anciano de 82 años con ayuno 355 y HbA1c 9,5 % con metformina: {{c1::insulina NPH}}.",
      "extra": "",
      "origen": "clase:13",
      "fuente": "Clase · Quiz Dic 2022",
      "repaso": false,
      "preguntaReal": [
        "EUNACOM Diciembre 2022 · Pregunta 149"
      ],
      "codigos": [
