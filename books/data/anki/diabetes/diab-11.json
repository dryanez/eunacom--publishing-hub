{
  "classId": "diab-11",
  "cards": [
    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Las insulinas basales controlan el {{c1::ayuno y entre comidas}}; las prandiales controlan el postprandial de esa comida.",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · Basal y prandial",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "NPH: inicio 1–2 h, pico {{c1::4–10 h}}, duración 12 a 18 horas.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Insulinas basales",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El pico de la NPH es la principal causa de {{c1::hipoglicemia nocturna}}.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Insulinas basales",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Glargina y degludec no tienen pico («perfil {{c1::plano}}») y dan mucha menos hipoglicemia nocturna.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Insulinas basales",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Glargina U100 y detemir duran {{c1::20–24 horas}}; degludec y glargina U300 más de 24 horas.",
      "extra": "Una vez al día.",
      "origen": "clase:9",
      "fuente": "Clase · Tabla de perfiles",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Degludec y glargina U300 duran hasta {{c1::42 horas}}, con horario flexible.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Perfiles",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Cristalina: inicio {{c1::30–60 min}}, pico 2–3 h, duración 6 a 8 horas.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Insulinas prandiales",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "La cristalina se inyecta {{c1::30 minutos}} antes de comer.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Insulinas prandiales",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "La {{c1::cristalina}} es la única insulina que se usa por vía endovenosa (bomba de infusión).",
      "extra": "Cetoacidosis, perioperatorio, UCI.",
      "origen": "clase:3",
      "fuente": "Clase · Insulinas prandiales",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Ultrarrápidas (lispro, aspart, glulisina): inicio {{c1::10–15 min}} y duración 3 a 5 horas.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Insulinas prandiales",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Las ultrarrápidas se inyectan {{c1::justo antes de comer}} o incluso inmediatamente después.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Insulinas prandiales",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c12",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "NPH con la cena causa hipoglicemia a las 3 AM; la solución es pasarla a {{c1::22:00–23:00 h (al acostarse)}}.",
      "extra": "El pico se desplaza hacia las 6–8 AM.",
      "origen": "clase:4",
      "fuente": "Clase · NPH cena vs acostarse",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c13",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "NPH con la cena (20:00 h): pico a las {{c1::2–4 AM}}, coincide con la glicemia más baja.",
      "extra": "",
      "origen": "clase:4",
      "fuente": "Clase · NPH cena vs acostarse",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c14",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "En DM2 se inicia insulina con HbA1c ≥ {{c1::9–10 %}} o ayuno > 250–300 mg/dL.",
      "extra": "",
      "origen": "clase:5",
      "fuente": "Clase · ¿Cuándo se inicia insulina?",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Diciembre 2018 · Pregunta 17",
        "EUNACOM Enero 2023 · Pregunta 151",
        "EUNACOM Enero 2023 · Pregunta 150"
      ],
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c15",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Obeso con polidipsia, baja de peso y HbA1c > 9 %: se indica {{c1::insulina}} aunque sea obeso.",
      "extra": "",
      "origen": "clase:11",
      "fuente": "Clase · Quiz Dic 2018",
      "repaso": false,
      "preguntaReal": [
        "EUNACOM Diciembre 2018 · Pregunta 17"
      ],
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c16",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Falla secundaria: con {{c1::2 o 3}} orales a dosis óptimas persiste sobre la meta tras 3 meses.",
      "extra": "",
      "origen": "clase:5",
      "fuente": "Clase · ¿Cuándo se inicia insulina?",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c17",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Falla de metformina 2000 mg más glibenclamida 15 mg con HbA1c 8,8 %: {{c1::iniciar insulina}} y no subir orales.",
      "extra": "",
      "origen": "clase:12",
      "fuente": "Clase · Quiz Julio 2013",
      "repaso": false,
      "preguntaReal": [
        "EUNACOM Julio 2013 · Pregunta 125"
      ],
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c18",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Otras indicaciones de insulina en DM2: VFG < {{c1::30}}, falla hepática grave, embarazo y hospitalización aguda.",
      "extra": "",
      "origen": "clase:5",
      "fuente": "Clase · ¿Cuándo se inicia insulina?",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c19",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Corticoides en dosis altas (prednisona 40 mg/día) con postprandiales de 280: se {{c1::inicia insulina}}.",
      "extra": "",
      "origen": "clase:14",
      "fuente": "Clase · Quiz Julio 2025",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c20",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Corticoides con glicemias prealmuerzo y precena de 230 y 295 mg/dL: tratamiento con {{c1::insulina}}.",
      "extra": "",
      "origen": "libro:caso",
      "fuente": "Pregunta real Julio 2015",
      "repaso": false,
      "preguntaReal": [
        "EUNACOM Julio 2015 · Pregunta 16"
      ],
      "codigos": [
