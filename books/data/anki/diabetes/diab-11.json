      "id": "c25",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "En DM1 una sola insulina basal es insuficiente y la {{c1::metformina}} no sirve.",
      "extra": "",
      "origen": "clase:15",
      "fuente": "Clase · Quiz Julio 2015",
      "repaso": false,
