    {
      "id": "c26",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "La insulina no abierta se conserva a {{c1::2–8 °C}} y nunca se congela.",
      "extra": "",
      "origen": "clase:6",
      "fuente": "Clase · Conservación",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
