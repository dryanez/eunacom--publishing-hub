        "1.02.1.004"
      ]
    },
    {
      "id": "c30",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Adulto mayor con infarto reciente y diarrea por metformina: reemplazar por {{c1::sitagliptina}}.",
      "extra": "Se prefiere sobre la glibenclamida por fragilidad.",
      "origen": "libro:caso",
      "fuente": "Pregunta real Diciembre 2018",
      "repaso": false,
