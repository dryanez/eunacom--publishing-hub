        "1.02.4.017"
      ]
    },
    {
      "id": "c29",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "NPH nocturna con glicemia de 65 mg/dL a las 3 AM y ayuno alto: Somogyi, se {{c1::reduce la NPH}}.",
