    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El efecto Somogyi es hiperglicemia de {{c1::rebote}} tras una hipoglicemia inadvertida de madrugada.",
      "extra": "Por exceso de insulina basal nocturna.",
      "origen": "clase:3",
      "fuente": "Clase · Somogyi",
      "repaso": true,
      "codigos": [
        "1.02.2.006",
        "1.02.1.005"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "En Somogyi el organismo libera {{c1::glucagón, adrenalina, cortisol y GH}}, que inducen glucogenólisis y gluconeogénesis.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Somogyi",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Pistas de Somogyi: pesadillas, {{c1::sudor nocturno}} y cefalea matinal.",
