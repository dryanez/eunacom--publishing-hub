        "1.02.1.005"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "En el ambulatorio no se sube más de {{c1::4 UI}} por ajuste.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Ajustar la basal",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
