    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "En APS el esquema basal es metformina más {{c1::NPH al acostarse}} (22:00–23:00 h).",
      "extra": "La metformina limita el peso y ahorra insulina.",
      "origen": "clase:1",
      "fuente": "Clase · Esquema basal",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Dosis inicial de NPH bedtime: {{c1::10 UI}} o 0,1–0,2 UI/kg.",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · Esquema basal",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Si se dispone de análogos prolongados (glargina o degludec) se dan {{c1::una vez al día}}, a la misma hora.",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · Esquema basal",
      "repaso": false,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "El ayuno se promedia cada {{c1::3 a 7 días}} para titular la basal.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Ajustar la basal",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Ayuno de 131–180 mg/dL: subir la basal {{c1::2 UI}}.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Ajustar la basal",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Ayuno > 180 mg/dL: subir la basal {{c1::4 UI}}.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Ajustar la basal",
      "repaso": true,
      "codigos": [
        "1.02.1.005",
        "1.02.1.004"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Glicemia < 70 mg/dL o hipoglicemia: bajar la dosis responsable {{c1::10–20 % (2 a 4 UI)}}.",
