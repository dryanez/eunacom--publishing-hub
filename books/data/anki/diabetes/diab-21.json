      ]
    },
    {
      "id": "c22",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "En DM2 el fondo de ojo se hace {{c1::al diagnóstico}} y luego una vez al año.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Tamizaje",
