{
  "classId": "diab-21",
  "cards": [
    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La retinopatía diabética es la principal causa de {{c1::ceguera}} irreversible en adultos en edad laboral.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "¿Por qué? del tema",
      "repaso": false,
      "codigos": [
        "1.02.1.015",
        "6.02.1.023"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La alteración inicial de la retinopatía diabética es la pérdida de {{c1::pericitos}}, que rompe la barrera hematorretiniana.",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · Del capilar al neovaso",
      "repaso": false,
      "codigos": [
        "1.02.1.015",
        "6.02.1.023"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La lesión más precoz de la retinopatía diabética son los {{c1::microaneurismas}}.",
      "extra": "Puntos rojos de bordes netos, temporales a la fóvea.",
      "origen": "foto",
      "fuente": "Libro §1 Lesión más precoz",
      "repaso": true,
      "imagen": "biblioteca/04_diabetes/diab-21/02_microaneurismas__kanski_p537.jpg",
      "codigos": [
        "1.02.1.015",
        "6.02.1.023"
      ]
    },
    {
      "id": "i01",
      "modelo": "imagen",
      "tipo": "Imagen",
      "imagen": "biblioteca/04_diabetes/diab-21/02_microaneurismas__kanski_p537.jpg",
      "pregunta": "¿Qué muestra y qué haces?",
      "diagnostico": "Microaneurismas: retinopatía no proliferativa leve",
      "clave": "Puntos rojos pequeños de bordes netos en el polo posterior",
      "conducta": "Control estricto de HbA1c y PA; fondo de ojo anual",
      "fuente": "Kanski's Clinical Ophthalmology, 8.ª ed., p. 537",
      "repaso": true,
      "codigos": [
        "1.02.1.015",
        "6.02.1.023"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Ante la pregunta por la lesión más precoz al fondo de ojo, el error es responder {{c1::exudados duros o neovasos}}.",
      "extra": "Es el microaneurisma.",
      "origen": "clase:9",
      "fuente": "Clase · Tabla de trampas",
      "repaso": false,
      "codigos": [
        "1.02.5.003"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Los exudados duros son depósitos lipoproteicos amarillentos que traducen {{c1::fuga vascular}}.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Clasificación",
      "repaso": false,
      "codigos": [
        "1.02.1.015",
        "6.02.1.023"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Los exudados algodonosos son {{c1::microinfartos}} de la capa de fibras nerviosas por isquemia capilar.",
      "extra": "",
      "origen": "foto",
      "fuente": "Libro §2 Clasificación",
      "repaso": true,
      "imagen": "biblioteca/04_diabetes/diab-21/03_exudados-algodonosos__commons.jpg",
      "codigos": [
        "1.02.1.015"
      ]
    },
    {
      "id": "i02",
      "modelo": "imagen",
      "tipo": "Imagen",
      "imagen": "biblioteca/04_diabetes/diab-21/03_exudados-algodonosos__commons.jpg",
      "pregunta": "¿Qué muestra y qué haces?",
      "diagnostico": "Exudados algodonosos de la retinopatía diabética",
      "clave": "Manchas blancas de bordes borrosos rodeadas de hemorragias",
      "conducta": "Son isquemia (no fuga): vigilar progresión a proliferativa; control metabólico y PA",
      "fuente": "Wikimedia Commons, CC BY-SA 4.0",
      "repaso": false,
      "codigos": [
        "1.02.1.015",
        "6.02.1.023"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "El exudado algodonoso se confunde con la fuga lipídica, pero es {{c1::un microinfarto por isquemia}}.",
      "extra": "",
      "origen": "clase:9",
      "fuente": "Clase · Tabla de trampas",
      "repaso": false,
      "codigos": [
        "1.02.1.015"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La retinopatía no proliferativa severa sigue la regla {{c1::4-2-1}}.",
      "extra": "Hemorragias en 4 cuadrantes, venas arrosariadas en 2 e IRMA en 1.",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Clasificación",
      "repaso": false,
      "codigos": [
        "1.02.1.015",
        "6.02.1.023"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La retinopatía proliferativa se define por la presencia de {{c1::neovasos}} en la papila o la retina periférica.",
      "extra": "Aunque haya muchas hemorragias, sin neovasos no es proliferativa.",
      "origen": "clase:3",
      "fuente": "Clase · No proliferativa vs proliferativa",
      "repaso": true,
      "codigos": [
        "1.02.1.015",
        "6.02.1.023"
      ]
    },
    {
      "id": "i03",
      "modelo": "imagen",
      "tipo": "Imagen",
      "imagen": "biblioteca/04_diabetes/diab-21/04_neovasos__kanski_p542.jpg",
      "pregunta": "¿Qué muestra y qué haces?",
      "diagnostico": "Retinopatía diabética proliferativa: neovasos en la papila",
      "clave": "Vasos finos y frágiles sobre el disco óptico",
      "conducta": "Derivación prioritaria GES a oftalmología para panfotocoagulación con láser de argón",
      "fuente": "Kanski's Clinical Ophthalmology, 8.ª ed., p. 542",
      "repaso": true,
      "codigos": [
        "1.02.1.015",
        "6.02.1.023"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Los neovasos son estimulados por el factor de crecimiento vascular endotelial ({{c1::VEGF}}) liberado por la retina isquémica.",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · Del capilar al neovaso",
      "repaso": false,
      "codigos": [
        "1.02.1.015"
      ]
    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Pérdida visual súbita, indolora y con rojo pupilar abolido en un diabético: {{c1::hemorragia vítrea}}.",
      "extra": "Rotura de neovasos de una retinopatía proliferativa.",
      "origen": "foto",
      "fuente": "Libro · Puntos clave",
      "repaso": false,
      "imagen": "biblioteca/04_diabetes/diab-21/01_retinopatia-diabetica__cto-oftalmo_p68.jpg",
      "preguntaReal": [
        "EUNACOM Julio 2017 · Pregunta 177",
        "EUNACOM Agosto 2021 · Pregunta 157"
      ],
      "codigos": [
        "1.02.1.015",
        "6.02.1.023"
      ]
    },
    {
      "id": "c12",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Pérdida visual súbita, indolora y sin rojo pupilar: el error es pensar en {{c1::edema macular o catarata}}.",
      "extra": "",
      "origen": "clase:9",
      "fuente": "Clase · Tabla de trampas",
      "repaso": false,
      "codigos": [
        "1.02.1.015"
      ]
    },
    {
      "id": "c13",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Disminución progresiva de la agudeza visual con opacidad en el rojo pupilar en un diabético: {{c1::catarata}}.",
      "extra": "La hemorragia vítrea es súbita y abole el rojo pupilar.",
      "origen": "clase:13",
      "fuente": "Clase · Quiz Diciembre 2019",
      "repaso": false,
      "preguntaReal": [
        "EUNACOM Diciembre 2019 · Pregunta 33"
      ],
      "codigos": [
        "1.02.1.015",
        "6.02.1.023"
      ]
    },
    {
      "id": "c14",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La fibrosis de los neovasos produce {{c1::desprendimiento de retina traccional}} y glaucoma neovascular (rubeosis iridis).",
      "extra": "",
      "origen": "clase:4",
      "fuente": "Clase · Qué hacen los neovasos",
      "repaso": false,
      "codigos": [
        "1.02.1.015"
      ]
    },
    {
      "id": "c15",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La causa más frecuente de baja visual moderada en DM2 es el {{c1::edema macular diabético}}, no la hemorragia vítrea.",
      "extra": "",
      "origen": "foto",
      "fuente": "Libro §3 Edema macular",
      "repaso": true,
      "imagen": "biblioteca/04_diabetes/diab-21/01_retinopatia-diabetica_alt1__cto-oftalmo_p108.jpg",
      "codigos": [
        "1.02.1.015",
        "6.02.1.023"
      ]
    },
    {
      "id": "c16",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Edema macular central: {{c1::anti-VEGF intravítreo}} (ranibizumab, aflibercept) como primera línea.",
      "extra": "",
      "origen": "clase:5",
      "fuente": "Clase · Láser y anti-VEGF",
      "repaso": true,
      "codigos": [
        "1.02.1.015"
      ]
    },
    {
      "id": "c17",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "En edema macular central, el error es usar {{c1::láser panretinal}} como primera línea.",
      "extra": "",
      "origen": "clase:9",
      "fuente": "Clase · Tabla de trampas",
      "repaso": false,
      "codigos": [
        "1.02.1.015"
      ]
    },
    {
      "id": "c18",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Retinopatía proliferativa: {{c1::panfotocoagulación con láser de argón}}.",
      "extra": "Reduce el VEGF y hace regresar los neovasos.",
      "origen": "clase:5",
      "fuente": "Clase · Láser y anti-VEGF",
      "repaso": true,
      "codigos": [
        "1.02.1.015",
        "6.02.1.023"
      ]
    },
    {
      "id": "c19",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Con neovasos en el disco y visión conservada, el error es {{c1::solo control metabólico y fondo de ojo anual}}.",
      "extra": "Corresponde derivación prioritaria y láser.",
      "origen": "clase:9",
      "fuente": "Clase · Tabla de trampas",
      "repaso": false,
      "codigos": [
        "1.02.5.003"
      ]
    },
    {
      "id": "c20",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El láser también se usa en la retinopatía no proliferativa {{c1::muy severa}}.",
      "extra": "",
      "origen": "clase:5",
      "fuente": "Clase · Láser y anti-VEGF",
      "repaso": false,
      "codigos": [
        "1.02.1.015",
        "6.02.1.023"
      ]
    },
    {
      "id": "c21",
      "modelo": "cloze",
      "tipo": "GES",
      "texto": "Derivación GES de la retinopatía proliferativa: urgente a oftalmología, con plazo de {{c1::30-60 días}}.",
      "extra": "",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla RDNP vs RDP",
      "repaso": false,
