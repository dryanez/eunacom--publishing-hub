      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Ayuno 112 mg/dL en el control inicial del embarazo: {{c1::repetir la glicemia de ayuno}}.",
      "extra": "",
      "origen": "algoritmo",
