      ]
    },
    {
      "id": "c23",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Hipoglicemias con glibenclamida 20 mg más metformina y HbA1c 8,1 %: {{c1::reemplazar la glibenclamida por sitagliptina}}.",
      "extra": "No basta con suspenderla ni agregar colación.",
