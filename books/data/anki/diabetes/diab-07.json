      "id": "c25",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La acidosis láctica por metformina tiene lactato > {{c1::5 mmol/L}} y pH < {{c2::7,35}} con anión gap alto.",
      "extra": "",
      "origen": "clase:7",
      "fuente": "Clase · Acidosis láctica",
      "repaso": true,
      "codigos": [
        "1.02.2.001",
        "1.02.1.005"
      ]
    },
    {
      "id": "c26",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La acidosis láctica por metformina se distingue de la cetoacidosis por {{c1::cetonas negativas}} y glicemia casi normal.",
      "extra": "",
      "origen": "clase:7",
      "fuente": "Clase · Acidosis láctica",
      "repaso": true,
      "codigos": [
        "1.02.2.001",
        "1.02.1.005"
      ]
