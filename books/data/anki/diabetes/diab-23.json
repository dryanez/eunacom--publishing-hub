    {
      "id": "c29",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Antes de rotular una dislipidemia como primaria se corrigen las causas secundarias: {{c1::hipotiroidismo, síndrome nefrótico, colestasis}} y fármacos.",
      "extra": "Tiazidas, betabloqueadores, corticoides, anticonceptivos.",
      "origen": "clase:7",
      "fuente": "Clase · Prevenir dislipidemias",
      "repaso": true,
      "codigos": [
        "1.02.3.007",
        "1.02.1.007"
      ]
    },
    {
      "id": "c30",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Con triglicéridos sobre {{c1::400 mg/dL}} la fórmula de Friedewald no es válida; se mide LDL directo o colesterol no HDL.",
      "extra": "LDL = CT − HDL − TG/5.",
      "origen": "clase:18",
      "fuente": "Clase · Quiz perfil lipídico",
      "repaso": false,
      "codigos": [
        "1.02.4.021",
        "2.01.4.019"
      ]
    },
    {
      "id": "c31",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "En niños con LDL ≥ {{c1::190 mg/dL}} persistente tras 6 meses de dieta: sospechar hipercolesterolemia familiar e iniciar estatina en dosis baja.",
      "extra": "",
      "origen": "clase:19",
      "fuente": "Clase · Quiz niño",
      "repaso": false,
      "codigos": [
        "1.02.1.007"
      ]
    },
    {
      "id": "c32",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "En un niño de 5 años con padre con IAM precoz, se solicita {{c1::perfil lipídico en ayunas}}.",
      "extra": "Tamizaje selectivo desde los 2 años.",
      "origen": "clase:20",
      "fuente": "Clase · Quiz niño",
      "repaso": false,
      "codigos": [
        "1.02.4.021",
        "2.01.4.019"
      ]
    },
    {
      "id": "c33",
      "modelo": "cloze",
      "tipo": "GES",
      "texto": "La dislipidemia del diabético se asocia a la prevención secundaria cardiovascular y a HTA/DM, que son garantías {{c1::GES}}.",
      "extra": "",
