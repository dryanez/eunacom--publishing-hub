      "pista": "RN de riesgo: ¿qué decide el manejo?"
    },
    {
      "id": "o02",
      "nodo": "r.0.0",
      "pista": "Sin síntomas, glicemia 35 a 44: ¿qué haces?"
    },
    {
      "id": "o03",
      "nodo": "r.0.1",
      "pista": "Con síntomas o < 35: ¿qué administras?"
    },
    {
      "id": "o04",
      "nodo": "r.0.1.0",
      "pista": "Después del bolo: ¿qué indicas?"
    }
  ]
}