      "fuente": "Libro §1 EG",
      "repaso": false,
      "codigos": [
        "2.01.1.123"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El método de Capurro B se usa desde las {{c1::29 semanas}} y evalúa 5 signos somáticos.",
      "extra": "Oreja, mama, pezón, piel, pliegues plantares.",
      "origen": "foto",
      "fuente": "Libro · Puntos clave",
      "repaso": false,
      "codigos": [
        "2.01.1.128"
      ],
      "imagen": "biblioteca/15_pediatria/ped-16/01_test_capurro__usuario.jpg"
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Capurro: EG = (puntaje + {{c1::204}}) / 7.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Capurro",
      "repaso": true,
      "codigos": [
        "2.01.1.128"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "En prematuros extremos el método de elección para estimar EG es el {{c1::New Ballard}}.",
      "extra": "Evalúa signos somáticos y neuromusculares.",
      "origen": "clase:2",
      "fuente": "Clase · Ballard",
      "repaso": false,
      "codigos": [
        "2.01.1.128"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Las curvas de crecimiento intrauterino usadas en Chile son las de {{c1::Alarcón-Pittaluga}}.",
