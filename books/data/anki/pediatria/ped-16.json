        "2.01.1.128"
      ]
    },
    {
      "id": "c13",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Un RN de 35 semanas con peso en el percentil 92 es {{c1::pretérmino GEG}}.",
