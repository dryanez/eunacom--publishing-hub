      "origen": "libro:sec:3",
      "fuente": "Libro §3 GEG",
      "repaso": false,
      "codigos": [
        "2.01.1.128"
      ]
    },
    {
      "id": "c19",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "PEG asimétrico: {{c1::insuficiencia placentaria tardía}} (preeclampsia, hipertensión) con cabeza preservada.",
