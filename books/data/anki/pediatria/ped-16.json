      "codigos": [
        "2.01.1.128"
      ]
    },
    {
      "id": "c14",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Complicación cardinal del PEG: {{c1::hipoglicemia}} por escasa reserva de glucógeno hepático.",
      "extra": "",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 PEG",
