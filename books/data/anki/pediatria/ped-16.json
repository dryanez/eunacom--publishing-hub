      "codigos": [
        "2.01.1.123"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Prematuro tardío: {{c1::34 a 36 semanas + 6 días}}.",
      "extra": "Son el 70% de la prematurez; riesgo de hipotermia, dificultad respiratoria e hiperbilirrubinemia.",
