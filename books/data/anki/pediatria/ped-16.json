      "origen": "libro:sec:3",
      "fuente": "Libro §3 PEG",
      "repaso": false,
      "codigos": [
        "2.01.1.128"
      ]
    },
    {
      "id": "c16",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La hipoxia intrauterina crónica del PEG aumenta la eritropoyetina y produce {{c1::policitemia (poliglobulia)}}.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · PEG",
      "repaso": false,
      "codigos": [
        "2.01.1.128"
      ]
    },
    {
      "id": "c17",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El GEG hijo de madre diabética hace hipoglicemia por {{c1::hiperinsulinismo fetal}}.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · GEG",
      "repaso": true,
      "codigos": [
        "2.01.1.128"
      ]
    },
    {
      "id": "c18",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El GEG tiene riesgo de trauma obstétrico: {{c1::distocia de hombros}}, fractura de clavícula y parálisis braquial.",
