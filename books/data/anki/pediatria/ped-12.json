    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Ante un lactante con vómitos, lo primero es mirar si el vómito es {{c1::bilioso}}.",
      "extra": "Verde es urgencia quirúrgica hasta descartarla.",
      "origen": "clase:1",
      "fuente": "Clase · Bilioso y edad",
      "repaso": true,
      "codigos": [
        "2.01.1.046",
        "2.01.2.019"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Todo vómito bilioso del recién nacido es {{c1::vólvulo por malrotación}} hasta demostrar lo contrario.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · puntos clave",
      "repaso": true,
      "codigos": [
        "2.01.2.019",
        "2.01.2.001"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Vómito bilioso en el recién nacido: manejo inicial con régimen cero, SNG, hidratación EV y {{c1::cirugía de urgencia}}.",
      "extra": "Puede necrosar el intestino en horas.",
      "origen": "clase:15",
      "fuente": "Clase · Quiz Perfil V3",
      "repaso": true,
      "codigos": [
        "2.01.2.019"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Reflujo fisiológico ('regurgitador feliz'): regurgitación sin dolor, con {{c1::buena ganancia de peso}}, en menores de 6 meses.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Regurgitador feliz",
      "repaso": true,
      "codigos": [
        "2.01.1.046"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "El reflujo fisiológico afecta a más del {{c1::50%}} de los menores de 6 meses.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 RGE",
      "repaso": false,
      "codigos": [
        "2.01.1.046"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Manejo del RGE fisiológico: tranquilizar, posición {{c1::erguida 20-30 minutos}} tras las tomas y fraccionar tomas.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 RGE",
      "repaso": true,
      "codigos": [
        "2.01.1.046"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "En el reflujo fisiológico están contraindicados los {{c1::inhibidores de bomba de protones y procinéticos}}.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Regurgitador feliz",
      "repaso": true,
      "codigos": [
        "2.01.1.046"
      ],
      "preguntaReal": [
        "EUNACOM Julio 2015 · Pregunta 147"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El reflujo fisiológico remite espontáneamente al {{c1::año}} de vida.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 RGE",
      "repaso": false,
      "codigos": [
        "2.01.1.046"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "ERGE del lactante: esofagitis, rechazo alimentario, mala ganancia de peso o {{c1::síntomas respiratorios recurrentes}}.",
      "extra": "Se estudia y se prueba con omeprazol/esomeprazol.",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 ERGE",
      "repaso": false,
      "codigos": [
        "2.01.1.046"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El síndrome de Sandifer son posturas distónicas paroxísticas del {{c1::cuello}} asociadas a reflujo.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 ERGE",
      "repaso": false,
      "codigos": [
        "2.01.1.046"
      ]
    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La EHP afecta predominantemente a varones {{c1::primogénitos}} (4:1).",
