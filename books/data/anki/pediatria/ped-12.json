      "fuente": "Libro §2 EHP",
      "repaso": false,
      "codigos": [
        "2.01.1.046"
      ]
    },
    {
      "id": "c12",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La EHP se presenta entre las {{c1::2 y 8 semanas}} de vida, con pico a las 3-5 semanas.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 EHP",
