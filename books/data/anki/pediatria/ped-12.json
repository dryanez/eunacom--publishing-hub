      "tipo": "Concepto",
      "texto": "Vómito de la EHP: postprandial, {{c1::en proyectil y no bilioso}}.",
      "extra": "La obstrucción es pre-ampular.",
      "origen": "clase:3",
      "fuente": "Clase · EHP",
