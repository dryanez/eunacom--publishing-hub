      ]
    },
    {
      "id": "c40",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Coqueluche: hemograma con linfocitosis {{c1::> 20.000/mm³}}; mal pronóstico sobre 50.000.",
      "extra": "",
      "origen": "clase:8",
      "fuente": "Clase · Coqueluche",
      "repaso": false,
      "codigos": [
        "2.01.1.006"
      ],
      "preguntaReal": [
        "EUNACOM Julio 2016 · Pregunta 151"
      ]
    },
    {
      "id": "c41",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Diagnóstico de coqueluche en las primeras 3 a 4 semanas: {{c1::PCR en aspirado nasofaríngeo}}.",
      "extra": "",
      "origen": "clase:8",
      "fuente": "Clase · Coqueluche",
      "repaso": true,
      "codigos": [
        "2.01.1.006"
      ],
      "preguntaReal": [
        "EUNACOM Julio 2013 · Pregunta 151"
      ]
    },
    {
      "id": "c42",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Recién nacido con apneas y madre con tos paroxística emetizante: tratar con {{c1::azitromicina}}.",
      "extra": "Se evita la eritromicina en menores de 1 mes por estenosis hipertrófica del píloro.",
      "origen": "clase:21",
