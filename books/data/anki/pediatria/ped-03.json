      "id": "c38",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "En el adulto mayor el PNI incluye influenza anual y neumocócica polisacárida {{c1::23-valente}} a los 65 años.",
      "extra": "",
      "origen": "clase:6",
      "fuente": "Clase · Adulto mayor y cocooning",
