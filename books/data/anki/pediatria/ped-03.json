    },
    {
      "id": "c27",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La inyección IM en el lactante se hace en el {{c1::vasto lateral}} a {{c2::90°}}.",
      "extra": "Nunca en el glúteo: riesgo del ciático y peor respuesta a hepatitis B.",
      "origen": "clase:4",
      "fuente": "Clase · Técnica de vacunación",
      "repaso": true,
      "codigos": [
        "4.01.5.020"
      ]
    },
    {
      "id": "c28",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "En el niño que camina y en el adulto, el sitio IM es el {{c1::deltoides}}.",
      "extra": "",
      "origen": "libro:sec:4",
      "fuente": "Libro §4 Técnica",
      "repaso": false,
      "codigos": [
        "4.01.5.020"
      ]
    },
    {
      "id": "c29",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "La vía subcutánea se aplica a {{c1::45°}} con aguja de 16 mm, formando un pliegue de piel.",
      "extra": "Para tresvírica y varicela.",
      "origen": "libro:sec:4",
      "fuente": "Libro §4 Técnica",
      "repaso": true,
      "codigos": [
        "4.01.5.020"
      ]
    },
    {
      "id": "c30",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La BCG es intradérmica en el deltoides {{c1::derecho}} y forma un habón de 5 mm; no se frota ni se cubre.",
      "extra": "",
      "origen": "clase:4",
      "fuente": "Clase · Técnica de vacunación",
      "repaso": false,
      "codigos": [
        "4.01.5.020",
        "1.04.3.013"
      ]
    },
    {
      "id": "c31",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "La cadena de frío se mantiene entre {{c1::2 y 8 °C}}.",
      "extra": "",
      "origen": "libro:sec:4",
      "fuente": "Libro §4 Seguridad",
      "repaso": false,
      "codigos": [
        "4.01.5.020"
      ]
    },
    {
      "id": "c32",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Anafilaxia posvacunal: adrenalina IM {{c1::0,01 mg/kg}} en el vasto lateral.",
      "extra": "",
      "origen": "clase:4",
      "fuente": "Clase · Seguridad",
      "repaso": true,
      "codigos": [
        "4.01.5.020"
      ]
    },
    {
      "id": "c33",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Tras vacunar, se observa al paciente durante {{c1::15 a 30 minutos}} y se notifican los ESAVI.",
      "extra": "",
      "origen": "clase:4",
      "fuente": "Clase · Seguridad",
      "repaso": true,
      "codigos": [
        "4.01.5.020"
      ]
    },
    {
      "id": "c34",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Hijo de madre HBsAg positiva: el error es esperar los 2 meses; se da {{c1::vacuna más inmunoglobulina en las primeras 12 horas}}.",
      "extra": "",
      "origen": "clase:9",
      "fuente": "Clase · Tabla de trampas",
      "repaso": true,
      "codigos": [
        "1.06.3.001"
      ]
    },
    {
      "id": "c35",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "En el adulto de riesgo, la hepatitis B se vacuna en esquema de {{c1::0, 1 y 6 meses}}.",
      "extra": "",
      "origen": "libro:sec:5",
      "fuente": "Libro §5 Hepatitis",
      "repaso": false,
      "codigos": [
        "1.06.3.001"
      ]
