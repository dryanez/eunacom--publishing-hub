      "id": "c23",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "La fiebre que aparece 7 a 10 días después de las vacunas se atribuye a la {{c1::tresvírica}} (virus vivo).",
      "extra": "El componente inactivado da fiebre inmediata o al día siguiente.",
      "origen": "clase:9",
      "fuente": "Clase · Tabla de trampas",
      "repaso": false,
      "codigos": [
        "2.01.3.006"
      ],
