        "EUNACOM Julio 2017 · Pregunta 103"
      ]
    },
    {
      "id": "c24",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Convulsión o hipotonía horas después de la vacuna: reacción a la pertusis {{c1::celular}}; se cambia por acelular.",
      "extra": "Hoy se usa el componente acelular.",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Hexavalente acelular",
      "repaso": false,
      "codigos": [
        "2.01.3.006",
