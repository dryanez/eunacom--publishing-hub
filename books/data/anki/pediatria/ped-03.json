      "id": "c26",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La vacuna {{c1::rotavirus}} es la que se recomienda fuera del PNI a un lactante de 2 meses.",
      "extra": "",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 Vacunas vivas",
