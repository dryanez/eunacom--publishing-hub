      ]
    },
    {
      "id": "c22",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "El prematuro se vacuna por edad {{c1::cronológica}}, no corregida.",
      "extra": "La única excepción es el peso mínimo para la BCG.",
      "origen": "clase:9",
      "fuente": "Clase · Tabla de trampas",
      "repaso": true,
      "codigos": [
        "2.01.3.006"
      ],
      "preguntaReal": [
        "EUNACOM Agosto 2021 · Pregunta 151",
        "EUNACOM Diciembre 2018 · Pregunta 164"
      ]
    },
