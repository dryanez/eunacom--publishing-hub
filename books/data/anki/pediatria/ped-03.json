  "cards": [
    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Al recién nacido se le administran {{c1::BCG y hepatitis B}}.",
      "extra": "",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla Calendario PNI",
      "repaso": true,
      "codigos": [
        "2.01.3.006",
        "1.04.3.013"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La BCG previene las formas graves de TBC: {{c1::meníngea y miliar}}.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Calendario",
      "repaso": false,
      "codigos": [
        "1.04.3.013"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "La BCG está contraindicada si el recién nacido pesa {{c1::< 2.000 g}} o tiene inmunodeficiencia conocida.",
      "extra": "El prematuro espera a alcanzar el peso mínimo.",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Calendario",
      "repaso": false,
      "codigos": [
        "1.04.3.013",
        "2.01.3.006"
      ],
      "preguntaReal": [
        "EUNACOM Agosto 2021 · Pregunta 151"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "A los 2, 4 y 6 meses se administra la vacuna {{c1::hexavalente}} (DTPa-Hib-HB-VIP) intramuscular.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "codigos": [
        "2.01.3.006",
        "1.04.3.013"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La hexavalente reemplazó a la polio oral viva: el componente de polio es {{c1::VIP inyectable}}.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Calendario",
      "repaso": true,
      "codigos": [
        "1.04.3.013"
      ],
      "preguntaReal": [
        "EUNACOM Julio 2025 · Pregunta 55"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La neumocócica conjugada se administra a los 2, 4 y {{c1::12}} meses.",
      "extra": "El refuerzo de los 12 meses.",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla Calendario PNI",
      "repaso": false,
      "codigos": [
        "2.01.3.006",
        "1.04.3.013"
      ],
      "preguntaReal": [
        "EUNACOM Diciembre 2018 · Pregunta 164"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "A los 12 meses se administran {{c1::tresvírica, meningocócica ACWY y refuerzo de neumocócica}}.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "codigos": [
        "2.01.3.006",
        "1.04.3.013"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "A los 18 meses se administran {{c1::hexavalente (4.ª dosis), hepatitis A y varicela}}.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": false,
      "codigos": [
        "2.01.3.006",
        "1.04.3.013",
        "1.06.3.001"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La meningocócica conjugada del PNI protege contra los serogrupos A, C, W-135 e {{c1::Y}}.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Calendario",
      "repaso": true,
      "codigos": [
        "1.04.3.013"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "La 2.ª dosis de varicela se indica a los {{c1::36 meses}}.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Vacunación escolar",
      "repaso": false,
      "codigos": [
        "1.04.3.013"
      ]
    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "En 1.° básico se administra la 2.ª dosis de {{c1::tresvírica}} más dTpa.",
      "extra": "",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla Calendario PNI",
      "repaso": false,
      "codigos": [
        "2.01.3.006",
        "1.04.3.013"
      ]
    },
    {
      "id": "c12",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La vacuna VPH (Gardasil 9) se da en {{c1::4.° y 5.° básico}} a niñas y niños.",
      "extra": "",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla Calendario PNI",
      "repaso": false,
      "codigos": [
        "1.04.3.013"
      ]
    },
    {
      "id": "c13",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El refuerzo de dTpa se da en {{c1::8.° básico}}.",
      "extra": "",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla Calendario PNI",
      "repaso": true,
      "codigos": [
        "1.04.3.013"
      ]
    },
    {
      "id": "c14",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Nirsevimab es un {{c1::anticuerpo monoclonal}} contra el VRS, no una vacuna.",
      "extra": "Inmunización pasiva en menores de 6 meses.",
      "origen": "clase:2",
      "fuente": "Clase · Vivas vs inactivadas",
      "repaso": true,
      "codigos": [
        "1.04.3.013",
        "2.01.3.006"
      ]
    },
    {
      "id": "c15",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Las vacunas vivas atenuadas del PNI son {{c1::BCG, tresvírica y varicela}}.",
      "extra": "Contraindicadas en inmunosupresión grave y embarazo.",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "codigos": [
        "1.04.3.013",
        "2.01.3.006"
      ],
      "preguntaReal": [
        "EUNACOM Julio 2025 · Pregunta 55"
      ]
    },
    {
      "id": "c16",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Las vacunas inactivadas (hexavalente, neumocócica, meningocócica) son {{c1::seguras}} en el inmunosuprimido.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Vivas vs inactivadas",
      "repaso": false,
      "codigos": [
        "1.04.3.013"
      ]
    },
    {
      "id": "c17",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Niño con corticoides sistémicos en dosis inmunosupresoras: está contraindicada la {{c1::tresvírica}}, no las inactivadas.",
      "extra": "",
      "origen": "clase:10",
      "fuente": "Clase · Quiz EUNACOM Diciembre 2025 P131",
      "repaso": true,
      "codigos": [
        "2.01.3.006",
        "1.04.3.013"
      ],
      "preguntaReal": [
        "EUNACOM Diciembre 2025 · Pregunta 131"
      ]
    },
    {
      "id": "c18",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Ante corticoides en dosis alta, el error es suspender todo el esquema; se suspenden {{c1::solo las vivas}}.",
      "extra": "",
      "origen": "clase:9",
      "fuente": "Clase · Tabla de trampas",
      "repaso": true,
      "codigos": [
        "2.01.3.006"
      ]
    },
    {
      "id": "c19",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Un resfrío o fiebre baja (< 38.5°C) {{c1::no contraindica}} la vacunación.",
      "extra": "Diferir genera oportunidades perdidas.",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 Falsas contraindicaciones",
      "repaso": true,
      "codigos": [
        "2.01.3.006"
      ]
    },
    {
      "id": "c20",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "El tratamiento antibiótico en curso {{c1::no contraindica}} ninguna vacuna.",
      "extra": "",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 Falsas contraindicaciones",
      "repaso": false,
      "codigos": [
        "2.01.3.006"
      ]
    },
    {
      "id": "c21",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Ante alergia al huevo, la tresvírica y la influenza se vacunan {{c1::sin pruebas cutáneas ni cambios}}.",
      "extra": "El error es pedir test cutáneo o posponer.",
      "origen": "clase:9",
      "fuente": "Clase · Tabla de trampas",
      "repaso": true,
      "codigos": [
        "2.01.3.006"
      ],
