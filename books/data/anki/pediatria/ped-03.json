      "id": "c37",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Exposición a hepatitis B en no vacunado: vacuna más inmunoglobulina, idealmente en {{c1::24 a 48 horas}}.",
      "extra": "",
      "origen": "clase:5",
      "fuente": "Clase · Post-exposición",
