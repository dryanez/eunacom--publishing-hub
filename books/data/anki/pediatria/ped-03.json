      ]
    },
    {
      "id": "c25",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Antecedente de invaginación intestinal contraindica la vacuna {{c1::rotavirus oral}}.",
      "extra": "Es una vacuna extra PNI.",
      "origen": "clase:10",
      "fuente": "Clase · Quiz vacunas",
      "repaso": true,
      "codigos": [
        "2.01.3.006"
