    {
      "id": "c36",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Hepatitis B en adultos: la respuesta se confirma con anti-HBs {{c1::≥ 10 mUI/mL}}.",
      "extra": "",
      "origen": "libro:sec:5",
      "fuente": "Libro §5 Hepatitis",
      "repaso": false,
      "codigos": [
        "1.06.3.001"
      ]
