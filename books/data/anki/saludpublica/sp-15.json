    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Pirámide poblacional de base ancha y cúspide estrecha: {{c1::expansiva}}.",
      "extra": "Natalidad y mortalidad altas; población joven.",
