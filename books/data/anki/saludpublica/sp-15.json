      "fuente": "Libro · puntos clave",
      "repaso": true,
      "codigos": [
        "7.01.3.007"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La pirámide en forma de campana, con lados casi verticales, es la {{c1::estacionaria}}.",
