  "cards": [
    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "La tormenta tiroidea tiene una mortalidad histórica de {{c1::10 a 30%}} sin tratamiento precoz.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "¿Por qué?",
      "repaso": false,
      "codigos": [
        "1.03.2.001"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La tormenta tiroidea se distingue del hipertiroidismo no complicado por la {{c1::falla multiorgánica}}, no por el nivel de T4L o T3.",
      "extra": "",
      "origen": "clase:19",
      "fuente": "Clase · Reglas de oro",
      "repaso": true,
      "codigos": [
        "1.03.2.001"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Desencadenantes de la tormenta: {{c1::infecciones}}, cirugía sin preparación y abandono brusco de tionamidas.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Los gatillos",
      "repaso": true,
      "codigos": [
        "1.03.2.001"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Otros gatillos de la tormenta: contraste yodado o radioyodo sin cobertura, trauma, cetoacidosis, hipoglicemia y {{c1::parto}}.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Los gatillos",
      "repaso": false,
      "codigos": [
        "1.03.2.001"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La tormenta tiroidea sube la hormona libre porque caen las proteínas transportadoras y hay más receptores {{c1::beta}}.",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · ¿Qué convierte un hipertiroidismo en tormenta?",
      "repaso": false,
      "codigos": [
        "1.03.2.001"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "El diagnóstico de tormenta es {{c1::100% clínico}}; el error es esperar la T4L para tratar.",
      "extra": "",
      "origen": "clase:13",
      "fuente": "Clase · Tabla de trampas",
      "repaso": false,
      "codigos": [
        "1.03.2.001"
      ]
    },
    {
