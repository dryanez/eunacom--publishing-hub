      "fuente": "Libro · Puntos clave",
      "repaso": false,
      "codigos": [
        "1.03.1.003"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Bocio multinodular tóxico y adenoma tóxico: son de adultos mayores, rara vez con oftalmopatía y con TRAb {{c1::negativos}}.",
