      "fuente": "Libro §1 Etiología",
      "repaso": false,
      "codigos": [
        "1.03.1.003"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Hipertiroidismo apático del adulto mayor: {{c1::fibrilación auricular de novo}} o insuficiencia cardíaca refractaria, sin síntomas floridos.",
