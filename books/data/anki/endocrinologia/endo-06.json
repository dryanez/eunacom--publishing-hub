    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Graves es la causa más común de hipertiroidismo en menores de {{c1::50}} años.",
      "extra": "Es mediada por TRAb estimulantes del receptor de TSH.",
