      "id": "c01",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "En el embarazo la hCG estimula débilmente el receptor de TSH y los estrógenos {{c1::duplican la TBG}}.",
      "extra": "Por eso los rangos normales de TSH de no embarazadas no aplican.",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Fisiología materna",
      "repaso": false,
      "codigos": [
        "1.03.1.002",
        "2.01.1.075"
      ]
    },
