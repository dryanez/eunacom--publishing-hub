    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La tiroiditis de De Quervain es la causa más común de {{c1::tiroides dolorosa}}.",
      "extra": "Post-viral, autolimitada, en mujeres de 30 a 50 años.",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "codigos": [
        "1.03.1.005"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "De Quervain suele aparecer {{c1::1 a 3 semanas}} después de una infección respiratoria alta.",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · De Quervain",
      "repaso": false,
      "codigos": [
        "1.03.1.005"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Clínica de De Quervain: dolor cervical anterior intenso que irradia a {{c1::mandíbula y oídos}}, con tiroides dolorosa y caliente.",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · De Quervain",
      "repaso": true,
      "codigos": [
        "1.03.1.005"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "En De Quervain la VHS es muy elevada, sobre {{c1::60 a 100 mm/h}}.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Cómo se confirma",
      "repaso": true,
      "codigos": [
        "1.03.1.005"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "En De Quervain la captación de yodo a las 24 horas es casi nula, menor de {{c1::1 a 2%}}.",
      "extra": "Tiroides \"en blanco\"; en Graves la captación está aumentada.",
      "origen": "foto",
      "fuente": "Clase · Cómo se confirma",
      "repaso": false,
      "imagen": "biblioteca/05_endocrinologia/endo-05/02_gammagrafia_en_blanco__openi.jpg",
      "codigos": [
        "1.03.1.005"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Captación de yodo nula indica {{c1::destrucción}} folicular; captación alta indica Graves.",
      "extra": "",
      "origen": "foto",
      "fuente": "Clase · Reglas de oro",
      "repaso": false,
      "imagen": "biblioteca/05_endocrinologia/endo-05/04_cintigramas_panel_graves_vs_blanco__commons.jpg",
      "codigos": [
        "1.03.1.005"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "En De Quervain la fase inicial es una tirotoxicosis con TSH {{c1::baja}} y T4L alta, por liberación de hormona ya fabricada.",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · De Quervain",
      "repaso": false,
      "codigos": [
        "1.03.1.005"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "En una tiroiditis destructiva el error es dar {{c1::tiamazol}}: no hay síntesis que bloquear.",
      "extra": "Solo se usa en amiodarona tipo 1.",
      "origen": "clase:16",
      "fuente": "Clase · Reglas de oro",
      "repaso": true,
      "codigos": [
        "1.03.1.003",
        "1.03.1.005"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Primera línea en De Quervain: {{c1::AINE}} (ibuprofeno o naproxeno) en casos leves a moderados.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Tratamiento",
      "repaso": true,
