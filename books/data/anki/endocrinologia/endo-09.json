{
  "classId": "endo-09",
  "cards": [
    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Solo {{c1::5–10%}} de los nódulos tiroideos son malignos, sobre todo carcinoma papilar.",
      "extra": "Hasta 50–60% de las mujeres tienen nódulos por ecografía.",
      "origen": "clase:1",
      "fuente": "Clase · El problema",
      "repaso": false,
      "codigos": [
        "1.03.1.021",
        "1.03.4.001"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Factores de alto riesgo de malignidad: radioterapia de cuello en la infancia, familiar con {{c1::carcinoma medular o NEM 2}}, crecimiento rápido y disfonía.",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · El problema",
      "repaso": true,
      "codigos": [
        "1.03.1.021"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Ante un nódulo de 1 cm o sospechoso, el primer examen obligatorio es la {{c1::TSH}}.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": false,
      "codigos": [
        "1.03.1.021"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Nódulo con TSH suprimida (< 0,4): el siguiente paso es el {{c1::cintigrama tiroideo}}.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Antes que cualquier imagen: la TSH",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Julio 2019 · Pregunta 167"
      ],
      "codigos": [
        "1.03.1.021"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "El nódulo caliente tiene riesgo de malignidad menor de {{c1::1%}} y no se punciona.",
      "extra": "",
      "origen": "foto",
      "fuente": "Clase · Antes que cualquier imagen: la TSH",
      "repaso": false,
      "imagen": "biblioteca/05_endocrinologia/endo-09/03_gammagrafia-nodulo-caliente__amir-endocrino_p44.jpg",
      "codigos": [
        "1.03.1.021"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Nódulo con TSH menor de 0,4: el error es hacer {{c1::PAAF de entrada}}.",
      "extra": "",
      "origen": "clase:11",
      "fuente": "Clase · Tabla de trampas",
      "repaso": false,
      "codigos": [
        "1.03.1.021"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Nódulo con TSH normal o elevada: el examen siguiente es la {{c1::ecografía con TI-RADS}}.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Antes que cualquier imagen: la TSH",
      "repaso": false,
      "preguntaReal": [
        "EUNACOM Julio 2024 · Pregunta 65",
        "EUNACOM Diciembre 2019 · Pregunta 51",
        "EUNACOM Agosto 2021 · Pregunta 17",
        "EUNACOM Julio 2016 · Pregunta 25"
      ],
      "codigos": [
        "1.03.1.021",
        "1.03.4.001"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Con TSH normal o alta el error es pedir {{c1::cintigrama}}; nunca se pide con TSH normal.",
      "extra": "",
      "origen": "clase:11",
      "fuente": "Clase · Tabla de trampas",
      "repaso": true,
      "codigos": [
        "1.03.1.021"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "ACR TI-RADS puntúa 5 características: composición, {{c1::ecogenicidad, forma, márgenes y focos ecogénicos}}.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 ACR TI-RADS",
      "repaso": false,
      "codigos": [
        "1.03.1.021",
        "1.03.4.001"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Signos de alta sospecha: sólido, {{c1::marcadamente hipoecogénico}}, más alto que ancho, márgenes irregulares y microcalcificaciones.",
      "extra": "",
      "origen": "foto",
      "fuente": "Clase · Lo que hace sospechoso a un nódulo",
      "repaso": false,
      "imagen": "biblioteca/05_endocrinologia/endo-09/04_nodulo_ti-rads_5__rumack_p738.jpg",
      "codigos": [
        "1.03.1.021",
        "1.03.4.001"
      ]
    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Las microcalcificaciones sospechosas miden menos de {{c1::1 mm}}, sin sombra acústica (cuerpos de psamoma).",
      "extra": "",
      "origen": "foto",
      "fuente": "Clase · Lo que hace sospechoso a un nódulo",
      "repaso": false,
      "imagen": "biblioteca/05_endocrinologia/endo-09/01_nodulo-con-criterios-de-malignidad-eco-d__amir-endocrino_p46.jpg",
      "codigos": [
        "1.03.1.021",
        "1.03.4.001"
      ]
    },
    {
      "id": "c12",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Forma sospechosa: {{c1::más alto que ancho}} (eje anteroposterior mayor que el transversal).",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Lo que hace sospechoso a un nódulo",
      "repaso": false,
      "codigos": [
        "1.03.1.021"
      ]
    },
    {
      "id": "c13",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Signos de benignidad: aspecto {{c1::espongiforme}} (más del 50% en microquistes), quiste simple anecoico o halo fino.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Lo que hace sospechoso a un nódulo",
      "repaso": false,
      "codigos": [
        "1.03.1.021"
      ]
    },
    {
      "id": "c14",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "TR1 y TR2: PAAF en {{c1::ningún tamaño}}.",
      "extra": "",
      "origen": "clase:4",
      "fuente": "Clase · El umbral depende del TI-RADS",
      "repaso": true,
      "codigos": [
        "1.03.1.021",
