      ]
    },
    {
      "id": "c22",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Hipoglicemia en niño con status: dextrosa al 10 % {{c1::2–5 mL/kg}} EV.",
      "extra": "",
      "origen": "clase:7",
      "fuente": "Clase · Pediatría",
      "repaso": false,
      "codigos": [
        "2.01.2.027"
      ]
    },
