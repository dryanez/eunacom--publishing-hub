      ]
    },
    {
      "id": "c23",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Insomnio crónico: ≥ {{c1::3}} noches por semana durante 3 meses; tratar con higiene del sueño y terapia cognitivo-conductual.",
      "extra": "",
      "origen": "clase:6",
