    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La fragilidad es la pérdida de {{c1::reserva homeostática}} ante estresores menores; es dinámica y reversible.",
      "extra": "No es lo mismo que edad o discapacidad.",
      "origen": "clase:1",
      "fuente": "Clase · ¿Qué es ser frágil?",
      "repaso": false,
      "codigos": [
        "1.07.1.008"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El fenotipo de {{c1::Fried}} define fragilidad con 5 criterios.",
      "extra": "Peso, agotamiento, debilidad, marcha lenta, baja actividad.",
      "origen": "clase:2",
      "fuente": "Clase · Fenotipo de Fried",
      "repaso": true,
      "codigos": [
        "1.07.1.008"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Fried, pérdida de peso: ≥ {{c1::4,5 kg}} o ≥ 5 % del peso en un año.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Fenotipo de Fried",
      "repaso": false,
      "codigos": [
        "1.07.1.008"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Fried, debilidad: prensión < {{c1::27 kg}} en hombres y < 16 kg en mujeres.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Fenotipo de Fried",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Julio 2025 · Pregunta 143"
      ],
      "codigos": [
        "1.07.1.008"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Fried, marcha lenta: velocidad < {{c1::0,8 m/s}} (más de 5 s en 4 metros).",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Fenotipo de Fried",
      "repaso": false,
      "codigos": [
        "1.07.1.008"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Fried: {{c1::1 a 2}} criterios es prefrágil; 3 o más es frágil; 0 es robusto.",
      "extra": "El prefrágil es la mejor fase para prevenir.",
      "origen": "clase:2",
      "fuente": "Clase · Fenotipo de Fried",
      "repaso": true,
      "codigos": [
        "1.07.1.008"
      ]
    },
