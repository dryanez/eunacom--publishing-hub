        "1.10.4.005"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Mioclonías matinales al despertar, ausencias y convulsión tras privación de sueño: {{c1::epilepsia mioclónica juvenil}}.",
      "extra": "",
      "origen": "clase:15",
