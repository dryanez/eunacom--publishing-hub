      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Ausencia típica: desconexión de {{c1::5 a 15 segundos}} sin caída ni confusión postictal.",
      "extra": "",
      "origen": "clase:4",
      "fuente": "Clase · ILAE",
      "repaso": false,
      "codigos": [
        "1.10.1.007",
        "1.10.4.005"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "EEG de la ausencia típica: punta-onda generalizada a {{c1::3 Hz}} (patognomónico).",
      "extra": "",
      "origen": "clase:4",
      "fuente": "Clase · ILAE",
      "repaso": true,
