    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Definición ILAE de epilepsia: {{c1::2 crisis no provocadas}} separadas por más de 24 h, o 1 con alto riesgo de recurrencia.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Definición",
      "repaso": true,
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Una crisis única es epilepsia si el riesgo de recurrencia a 10 años es > {{c1::60 %}} (EEG epileptiforme o lesión).",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Definición",
      "repaso": false,
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "GES",
      "texto": "GES N° 28: epilepsia no refractaria en ≥ 15 años; especialista y EEG en ≤ {{c1::30 días}}, con tratamiento garantizado.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · GES",
      "repaso": false,
      "codigos": [
        "1.10.1.007",
        "1.10.4.005"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Crisis focal con conciencia preservada (antigua focal simple): el paciente {{c1::interactúa y recuerda}}.",
      "extra": "Clonías focales, marcha jacksoniana o auras.",
      "origen": "clase:3",
      "fuente": "Clase · ILAE",
      "repaso": false,
      "codigos": [
        "1.10.1.007",
        "1.10.4.005"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Signo focal al inicio que termina en convulsión de 4 extremidades: crisis {{c1::focal a tónico-clónica bilateral}}, no generalizada primaria.",
      "extra": "",
      "origen": "clase:12",
      "fuente": "EUNACOM Enero 2023 · Pregunta 143",
      "repaso": true,
      "preguntaReal": [
