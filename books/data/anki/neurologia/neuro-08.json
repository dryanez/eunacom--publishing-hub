      ],
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Examen neurofisiológico de elección en epilepsia: {{c1::EEG}}.",
      "extra": "",
      "origen": "clase:5",
      "fuente": "Clase · Diagnóstico",
      "repaso": false,
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "EEG normal con clínica sugerente: repetir con {{c1::privación de sueño}} o video-EEG; no descartar epilepsia.",
      "extra": "Es normal en la mitad de los epilépticos.",
      "origen": "clase:12",
      "fuente": "Clase · Trampas",
      "repaso": true,
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Ácido valproico: el más potente en crisis {{c1::generalizadas}} (tónico-clónicas, mioclonías, ausencias).",
      "extra": "",
      "origen": "clase:6",
      "fuente": "Clase · Fármacos",
      "repaso": false,
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c12",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Ácido valproico en el embarazo: defectos del tubo neural en {{c1::1–2 %}}, además de cardiopatías, autismo y bajo CI.",
      "extra": "",
      "origen": "clase:6",
      "fuente": "Clase · Fármacos",
      "repaso": false,
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c13",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Mujer en edad fértil con epilepsia generalizada: error {{c1::mantener o iniciar valproato}}.",
      "extra": "",
      "origen": "clase:12",
      "fuente": "Clase · Trampas",
      "repaso": true,
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c14",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Epilepsia en mujer fértil o embarazo: {{c1::lamotrigina o levetiracetam}} en monoterapia.",
      "extra": "",
      "origen": "clase:8",
      "fuente": "Clase · Selección",
      "repaso": false,
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c15",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Ácido fólico en mujer fértil con epilepsia: {{c1::5 mg/día}}, desde 3 meses antes de concebir.",
      "extra": "",
      "origen": "clase:13",
      "fuente": "Quiz caso clínico",
      "repaso": true,
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c16",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Carbamazepina: clásico de las crisis {{c1::focales}}; tóxica con Stevens-Johnson, hiponatremia y agranulocitosis.",
      "extra": "",
      "origen": "clase:6",
      "fuente": "Clase · Fármacos",
      "repaso": false,
      "imagen": "biblioteca/09_neurologia/neuro-08/02_stevens-johnson-mucosas__fitzpatrick_p390.jpg",
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c17",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Carbamazepina es inductor enzimático: baja niveles de anticonceptivos, {{c1::warfarina}} y estatinas.",
      "extra": "",
      "origen": "clase:6",
      "fuente": "Clase · Fármacos",
      "repaso": false,
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c18",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Toxicidad crónica de la fenitoína: hiperplasia {{c1::gingival}}, hirsutismo y ataxia.",
      "extra": "",
      "origen": "clase:6",
      "fuente": "Clase · Fármacos",
      "repaso": false,
      "imagen": "_verificadas/149_neuro_Epilepsia_y_fármacos__knoopepub_p174_1.jpg",
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c19",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Lamotrigina: titular lento (inicio {{c1::25 mg/día}}, subir cada 2 semanas) por riesgo de rash y Stevens-Johnson.",
      "extra": "",
      "origen": "clase:7",
      "fuente": "Clase · Fármacos",
      "repaso": true,
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c20",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Lamotrigina junto a valproato: {{c1::reducir a la mitad}} la dosis de lamotrigina.",
      "extra": "El valproato duplica su vida media.",
      "origen": "clase:12",
      "fuente": "Clase · Trampas",
      "repaso": false,
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c21",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Levetiracetam actúa sobre la proteína {{c1::SV2A}}; sin interacciones con citocromo P450.",
      "extra": "",
      "origen": "clase:7",
      "fuente": "Clase · Fármacos",
      "repaso": false,
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c22",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Efecto adverso típico del levetiracetam: {{c1::irritabilidad, agresividad}} y síntomas psiquiátricos.",
      "extra": "",
      "origen": "clase:7",
      "fuente": "Clase · Fármacos",
      "repaso": true,
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c23",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Crisis focal: lamotrigina, levetiracetam o {{c1::carbamazepina}}; la fenitoína quedó relegada.",
      "extra": "",
      "origen": "clase:8",
      "fuente": "Clase · Selección",
      "repaso": false,
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c24",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Adulto mayor o polimedicado: {{c1::levetiracetam}} en dosis bajas; evitar carbamazepina y fenitoína.",
      "extra": "",
      "origen": "clase:12",
      "fuente": "Clase · Trampas",
      "repaso": false,
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c25",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Monitorizar niveles plasmáticos de rutina solo de {{c1::fenitoína}}; lamotrigina en embarazo (caen en 2.º y 3.er trimestre).",
      "extra": "",
      "origen": "clase:9",
      "fuente": "Clase · Seguimiento",
      "repaso": false,
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c26",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Epilepsia refractaria: falla de {{c1::2}} FAE bien elegidos, tolerados y en dosis plenas; derivar a centro de epilepsia.",
      "extra": "Cirugía resectiva o estimulador vagal.",
      "origen": "clase:9",
      "fuente": "Clase · Seguimiento",
      "repaso": true,
      "codigos": [
        "1.10.1.007"
      ]
    },
    {
      "id": "c27",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Crisis pese a 2 fármacos bien usados: derivar; el error es agregar un tercero {{c1::indefinidamente}}.",
      "extra": "",
      "origen": "clase:12",
      "fuente": "Clase · Trampas",
      "repaso": false,
      "codigos": [
        "1.10.1.007"
      ]
    },
