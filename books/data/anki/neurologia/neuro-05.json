      "id": "c20",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Cefalea progresiva con vómitos matinales y convulsión en usuaria de ACO: {{c1::trombosis venosa cerebral}}.",
      "extra": "",
