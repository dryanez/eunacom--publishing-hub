      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "TVC: más de {{c1::75–80 %}} son mujeres de 20 a 45 años.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Factores de riesgo",
      "repaso": false,
      "codigos": [
        "1.10.2.007"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Factores más preguntados de TVC: anticonceptivos orales, embarazo y {{c1::puerperio}}.",
      "extra": "Máximo riesgo en las 6 semanas posparto.",
      "origen": "clase:2",
      "fuente": "Clase · Factores de riesgo",
      "repaso": true,
