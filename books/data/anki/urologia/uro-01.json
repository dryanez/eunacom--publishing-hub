 "occlusion": [
  {
   "id": "o01",
   "nodo": "r.0",
   "pista": "Cólico con fiebre, monorreno o anuria: ¿conducta?",
   "codigos": [
    "4.03.2.001",
    "1.09.2.001"
   ]
  },
  {
   "id": "o02",
   "nodo": "r.1.0",
   "pista": "Cálculo < 5 mm: ¿manejo?",
   "codigos": [
    "4.03.2.001",
    "1.09.2.001"
   ]
  },
  {
