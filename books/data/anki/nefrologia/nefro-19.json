{
  "classId": "nefro-19",
  "cards": [
    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La anemia de la ERC se debe a déficit de {{c1::eritropoyetina}} de las células peritubulares.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "codigos": [
        "1.09.1.004",
        "1.09.1.015"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Anemia de la ERC: {{c1::normocítica, normocrómica}} y arregenerativa.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Anemia renal",
      "repaso": false,
      "codigos": [
        "1.09.1.004",
        "1.09.1.015"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Antes de dar EPO en la anemia de la ERC hay que {{c1::reponer el hierro}}.",
      "extra": "EPO con ferropenia es ineficaz (resistencia a EPO).",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Anemia",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Julio 2020 · Reconstrucción oficial"
      ],
      "codigos": [
        "1.09.1.004"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Meta de hierro antes de EPO: saturación de transferrina > {{c1::20 %}}.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Primero hierro",
      "repaso": true,
      "codigos": [
        "1.09.1.004",
        "1.09.1.015"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Meta de hierro antes de EPO: ferritina > {{c1::100 ng/mL}}, y > {{c2::200}} en hemodiálisis.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Primero hierro",
      "repaso": true,
      "codigos": [
        "1.09.1.004",
        "1.09.1.015"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Hemodializada con Hb 8,8, IST 14 % y ferritina 65: {{c1::hierro EV}} hasta las metas, antes de la EPO.",
      "extra": "",
      "origen": "clase:14",
      "fuente": "Clase · Quiz caso",
      "repaso": false,
      "preguntaReal": [
        "EUNACOM Julio 2020 · Reconstrucción oficial"
      ],
      "codigos": [
        "1.09.1.004",
        "1.09.1.015"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Meta de Hb con EPO: {{c1::10,0–11,5 g/dL}} (máximo 12).",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Anemia",
      "repaso": true,
      "codigos": [
        "1.09.1.004"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Nunca normalizar la Hb con EPO sobre {{c1::13 g/dL}}: más ACV, infarto y trombosis de la FAV.",
      "extra": "Estudios TREAT y CHOIR.",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Anemia",
      "repaso": true,
      "codigos": [
        "1.09.1.004"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "En CKD-MBD, la retención de {{c1::fósforo}} sube el FGF-23 y baja el calcio iónico.",
      "extra": "",
      "origen": "clase:4",
      "fuente": "Clase · Por qué sube la PTH",
      "repaso": false,
      "codigos": [
        "1.09.1.015",
        "1.09.1.004"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El déficit de {{c1::1-alfa-hidroxilasa}} impide formar calcitriol (1,25-dihidroxivitamina D).",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 CKD-MBD",
      "repaso": true,
      "codigos": [
        "1.09.1.015"
      ]
    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Hiperfosfatemia + falta de calcitriol + hipocalcemia = hiperparatiroidismo {{c1::secundario}}.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "codigos": [
        "1.09.1.015",
        "1.09.1.004"
      ]
    },
    {
      "id": "c12",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El hiperparatiroidismo secundario produce {{c1::osteítis fibrosa quística}}, dolor óseo y prurito urémico.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 CKD-MBD",
      "repaso": false,
      "imagen": "_web/324_nefro_Complicaciones_de_la_ERC__Commons_2.jpg",
      "codigos": [
        "1.09.1.015"
      ]
    },
    {
      "id": "c13",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Calcificación de la túnica media arterial y úlceras necróticas cutáneas en ERC: {{c1::calcifilaxis}}.",
      "extra": "Arteriolopatía urémica calcificante.",
      "origen": "foto",
      "fuente": "Atlas EUNACOM 2026 · Calcifilaxis",
      "repaso": false,
      "imagen": "biblioteca/07_nefrologia/nefro-19/atlas_323_calcifilaxis_arteriolopatia_ur.jpg",
      "codigos": [
        "1.09.1.015",
        "1.09.1.004"
      ]
    },
    {
      "id": "c14",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "PTH elevada en ERC G3–G4 con calcio y fósforo normales: primer examen es {{c1::25-OH-vitamina D}}.",
      "extra": "",
      "origen": "clase:5",
      "fuente": "Clase · PTH alta",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Diciembre 2019 · Pregunta 140"
      ],
      "codigos": [
        "1.09.1.015",
        "1.09.1.004"
      ]
    },
    {
      "id": "c15",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Si la 25-OH-vitamina D es < 30 ng/mL se repone con {{c1::colecalciferol}} (vitamina D3).",
      "extra": "",
      "origen": "clase:5",
      "fuente": "Clase · PTH alta",
      "repaso": true,
      "codigos": [
        "1.09.1.004",
        "1.09.1.015"
      ]
    },
    {
      "id": "c16",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "PTH alta en G3–G4: el error es dar {{c1::calcitriol de entrada}} sin medir 25-OH-vitamina D.",
      "extra": "",
      "origen": "clase:5",
      "fuente": "Clase · PTH alta",
      "repaso": false,
      "codigos": [
        "1.09.1.015",
        "1.09.1.004"
      ]
    },
    {
      "id": "c17",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Si la PTH sigue alta: {{c1::calcitriol, paricalcitol o cinacalcet}}.",
      "extra": "Cinacalcet es calcimimético.",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 CKD-MBD",
      "repaso": false,
      "codigos": [
        "1.09.1.015"
      ]
    },
    {
      "id": "c18",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Meta de PTH intacta en G5D: {{c1::2 a 9 veces}} el límite superior normal (150–600 pg/mL).",
      "extra": "",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla CKD-MBD",
      "repaso": true,
      "codigos": [
        "1.09.1.015",
        "1.09.1.004"
      ]
    },
    {
      "id": "c19",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Meta de fósforo en G3–G4: {{c1::2,5 a 4,5 mg/dL}}.",
      "extra": "",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla CKD-MBD",
      "repaso": false,
      "codigos": [
        "1.09.1.015",
        "1.09.1.004"
      ]
    },
    {
      "id": "c20",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Meta de 25-OH-vitamina D: > {{c1::30 ng/mL}}.",
      "extra": "",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla CKD-MBD",
      "repaso": false,
      "codigos": [
        "1.09.1.015",
        "1.09.1.004"
      ]
    },
    {
      "id": "c21",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Los quelantes de fósforo se toman {{c1::con las comidas}}.",
      "extra": "Atrapan el fósforo de la dieta.",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "codigos": [
        "1.09.1.015",
        "1.09.1.004"
      ]
    },
    {
      "id": "c22",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Hiperfosfatemia con hipocalcemia: quelante cálcico ({{c1::carbonato o acetato de calcio}}).",
      "extra": "",
      "origen": "clase:6",
      "fuente": "Clase · Controlar el fósforo",
      "repaso": false,
      "codigos": [
        "1.09.1.015",
        "1.09.1.004"
      ]
    },
    {
      "id": "c23",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Hiperfosfatemia con hipercalcemia o calcificaciones vasculares: {{c1::sevelamer}}.",
      "extra": "Quelante sin calcio.",
      "origen": "clase:6",
      "fuente": "Clase · Controlar el fósforo",
      "repaso": true,
      "codigos": [
        "1.09.1.015",
        "1.09.1.004"
      ]
    },
    {
      "id": "c24",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La acidosis de la ERC aparece con TFG < {{c1::30 mL/min}} (G4–G5) por menor excreción de amonio.",
      "extra": "",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 Acidosis",
      "repaso": false,
      "codigos": [
        "1.09.1.001",
        "1.09.3.003"
      ]
    },
    {
      "id": "c25",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "En G3–G4 la acidosis de la ERC es hiperclorémica con anion gap {{c1::normal}}; en G5 el anion gap es elevado.",
      "extra": "",
      "origen": "clase:7",
      "fuente": "Clase · Acidosis metabólica",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Julio 2024 · Pregunta 6"
      ],
      "codigos": [
        "1.09.1.001",
        "1.09.1.015"
      ]
    },
    {
      "id": "c26",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Bicarbonato 16 con anion gap 10 en ERC G3b: causa es {{c1::menor producción de bicarbonato}} (amoniogénesis).",
      "extra": "",
      "origen": "clase:16",
      "fuente": "Clase · Quiz Jul. 2024",
      "repaso": false,
      "preguntaReal": [
        "EUNACOM Julio 2024 · Pregunta 6"
      ],
      "codigos": [
        "1.09.1.001",
        "1.09.1.015"
      ]
    },
    {
      "id": "c27",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Bicarbonato < 22 mEq/L sostenido: bicarbonato de sodio oral {{c1::0,5–1 mEq/kg/día}}, meta 22–26.",
      "extra": "Vigilar edema e HTA por sodio.",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 Acidosis",
      "repaso": true,
      "codigos": [
        "1.09.1.001",
        "1.09.3.003"
      ]
    },
    {
      "id": "c28",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Hiperkalemia en ERC se agrava con IECA/ARA-II, espironolactona, AINE, betabloqueadores, trimetoprim y {{c1::heparina}}.",
      "extra": "",
      "origen": "clase:8",
      "fuente": "Clase · Hiperkalemia",
      "repaso": false,
      "codigos": [
        "1.09.1.001",
        "1.09.1.015"
      ]
    },
    {
      "id": "c29",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Los captadores de potasio (patiromer, ciclosilicato de sodio y zirconio) permiten mantener el {{c1::IECA/ARA-II}}.",
      "extra": "",
      "origen": "clase:8",
      "fuente": "Clase · Hiperkalemia",
      "repaso": false,
      "codigos": [
        "1.09.1.001",
        "1.09.1.015"
      ]
    },
    {
      "id": "c30",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Hiperkalemia con K ≥ {{c1::6,5 mEq/L}} o cambios en el ECG es urgencia: gluconato de calcio, insulina con glucosa, salbutamol.",
      "extra": "",
      "origen": "clase:8",
      "fuente": "Clase · Hiperkalemia",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Julio 2019 · Pregunta 150"
      ],
      "codigos": [
        "1.09.1.001",
        "1.09.1.015"
      ]
    },
    {
      "id": "c31",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Proteínas en ERC G3–G5 no dializada: {{c1::0,6–0,8 g/kg/día}}; en hemodiálisis {{c2::1,0–1,2}}.",
      "extra": "",
      "origen": "clase:9",
      "fuente": "Clase · Desnutrición",
      "repaso": true,
      "codigos": [
        "1.09.3.003",
        "1.09.1.001"
      ]
    },
    {
      "id": "c32",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Desnutrido en ERC: el error es {{c1::restringir proteínas}}.",
      "extra": "Corregir acidosis, anemia, depresión y dosis de diálisis.",
      "origen": "clase:9",
      "fuente": "Clase · Desnutrición",
      "repaso": false,
      "codigos": [
        "1.09.1.004",
        "1.09.1.015"
      ]
    },
    {
      "id": "c33",
      "modelo": "cloze",
      "tipo": "GES",
      "texto": "El GES N° 1 cubre medicamentos e insumos para anemia y CKD-MBD en etapas {{c1::4–5}}.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Perfil GES del tema",
      "repaso": false,
      "codigos": [
        "1.09.1.004",
