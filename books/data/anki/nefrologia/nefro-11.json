      "codigos": [
        "1.09.1.002"
      ]
    },
    {
      "id": "c13",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Intoxicación por salicilatos: acidosis metabólica con {{c1::alcalosis respiratoria}} precoz.",
