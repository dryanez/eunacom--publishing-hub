    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Acidosis metabólica: caída primaria del {{c1::bicarbonato}}, con hiperventilación compensadora (respiración de Kussmaul).",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · ¿Qué es?",
      "repaso": true,
      "codigos": [
        "1.09.1.002",
        "1.09.4.008"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Acidemia: pH < {{c1::7.35}}; el componente metabólico primario es HCO3 < 22 mEq/L.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Leer los gases",
      "repaso": false,
      "codigos": [
        "1.09.1.002",
        "1.09.4.008"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Fórmula de Winter: pCO2 esperada = {{c1::1.5 × HCO3 + 8 ± 2}}.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · puntos clave",
      "repaso": true,
      "codigos": [
        "1.09.1.002",
        "1.09.4.008"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Con HCO3 10 mEq/L, la pCO2 esperada es {{c1::23 mmHg}} (rango 21 a 25).",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Winter en la práctica",
      "repaso": true,
      "codigos": [
        "1.09.1.002",
        "1.09.4.008"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "pCO2 medida mayor que la de Winter: acidosis {{c1::respiratoria}} agregada.",
      "extra": "El pulmón se está cansando.",
      "origen": "clase:3",
      "fuente": "Clase · Winter en la práctica",
      "repaso": true,
      "codigos": [
        "1.09.1.002",
        "1.09.4.008"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "pCO2 medida menor que la de Winter: alcalosis {{c1::respiratoria}} agregada.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Winter en la práctica",
      "repaso": false,
      "codigos": [
        "1.09.1.002",
        "1.09.4.008"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Anion gap = Na − (Cl + HCO3); normal {{c1::8 a 12 mEq/L}}.",
      "extra": "Lo forman sobre todo las cargas negativas de la albúmina.",
      "origen": "clase:4",
      "fuente": "Clase · Anion gap",
      "repaso": true,
      "codigos": [
        "1.09.1.002",
        "1.09.4.008"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Corrección del AG por albúmina: sumar {{c1::2.5 mEq/L}} por cada 1 g/dL bajo 4.0.",
      "extra": "",
      "origen": "clase:4",
      "fuente": "Clase · Anion gap",
      "repaso": true,
      "codigos": [
        "1.09.1.002",
        "1.09.4.008"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Sin corregir por albúmina, se esconde un AG alto que {{c1::parece normal}}.",
      "extra": "Frecuente en críticos, nefróticos y cirróticos.",
