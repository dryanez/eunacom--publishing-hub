      "fuente": "Clase · Tabla de trampas",
      "repaso": true,
      "codigos": [
        "1.09.1.002",
        "1.09.4.008"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Acidosis con AG elevado (> 12): se {{c1::agregó un ácido}}, con cloro normal.",
      "extra": "AG normal: se perdió bicarbonato (hiperclorémica).",
