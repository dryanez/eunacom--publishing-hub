      "fuente": "Clase · MUDPILES",
      "repaso": true,
      "codigos": [
        "1.09.1.002",
        "1.09.4.008"
      ]
    },
    {
      "id": "c12",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Cetoacidosis: diabética, {{c1::alcohólica}} y por ayuno prolongado.",
