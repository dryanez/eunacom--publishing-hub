      "fuente": "Clase · Reglas de oro",
      "repaso": true,
      "codigos": [
        "1.09.1.002",
        "1.09.4.008"
      ]
    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "MUDPILES/KUSSMAUL: cetoacidosis, uremia, acidosis {{c1::láctica}}, salicilatos, metanol y etilenglicol.",
