    {
      "id": "c26",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Emergencia hipertensiva: PA habitualmente ≥ {{c1::180/120 mmHg}} con daño agudo de órgano blanco.",
      "extra": "",
      "origen": "libro:sec:3",
      "fuente": "Libro §3 Emergencia",
      "repaso": true,
      "codigos": [
        "2.01.2.007",
        "1.09.1.021"
      ]
    },
    {
      "id": "c27",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Hipertensión severa sin daño de órgano es {{c1::urgencia}}: antihipertensivo oral y control ambulatorio.",
      "extra": "",
      "origen": "clase:6",
      "fuente": "Clase · Emergencia hipertensiva",
      "repaso": false,
      "codigos": [
        "2.01.2.007",
        "1.09.1.021"
      ]
    },
    {
      "id": "c28",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Emergencia hipertensiva: fármacos IV titulables en unidad crítica, como {{c1::nitroprusiato, labetalol o nicardipino}}.",
      "extra": "Nitroglicerina si hay SCA o edema pulmonar.",
      "origen": "clase:6",
      "fuente": "Clase · Emergencia hipertensiva",
      "repaso": false,
      "codigos": [
        "2.01.2.007",
        "1.09.1.021"
      ]
    },
    {
      "id": "c29",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Nitroprusiato en insuficiencia renal o uso prolongado: vigilar {{c1::intoxicación por tiocianato}}.",
      "extra": "",
      "origen": "clase:6",
      "fuente": "Clase · Emergencia hipertensiva",
      "repaso": false,
      "codigos": [
        "2.01.2.007",
        "1.09.1.021"
      ]
    },
    {
      "id": "c30",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "En la emergencia hipertensiva nunca se usa {{c1::nifedipino sublingual}}.",
      "extra": "Baja la presión de forma brusca e impredecible.",
      "origen": "clase:6",
      "fuente": "Clase · Emergencia hipertensiva",
      "repaso": true,
      "codigos": [
        "2.01.2.007",
        "1.09.1.021"
      ]
    },
    {
      "id": "c31",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Emergencia hipertensiva: bajar la PAM no más de {{c1::25 %}} en la primera hora.",
      "extra": "Luego 160/100 en 2–6 horas y normalizar en 24–48 horas.",
      "origen": "clase:6",
      "fuente": "Clase · Emergencia hipertensiva",
      "repaso": true,
      "codigos": [
        "2.01.2.007",
        "1.09.1.021"
      ]
    },
    {
      "id": "c32",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Disección aórtica: bajar la PAS a < {{c1::120 mmHg}} en 20 minutos, con betabloqueo previo.",
      "extra": "",
      "origen": "clase:6",
      "fuente": "Clase · Emergencia hipertensiva",
      "repaso": false,
      "codigos": [
        "2.01.2.007",
