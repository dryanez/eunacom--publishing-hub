      "fuente": "Clase · Emergencia hipertensiva",
      "repaso": false,
      "codigos": [
        "2.01.2.007",
        "1.09.1.021"
      ]
    },
    {
      "id": "c34",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Adulto mayor nefrótico con equimosis periorbitaria espontánea y VHS muy elevada: {{c1::amiloidosis primaria (AL)}}.",
