      ]
    },
    {
      "id": "c33",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "ACV isquémico: tratar la PA solo si > {{c1::220/120}} (o < 185/110 si se planea trombólisis).",
      "extra": "",
