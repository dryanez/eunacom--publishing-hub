      ]
    },
    {
      "id": "c34",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Falla renal de reciente diagnóstico (IRA vs IRC): examen inicial es la {{c1::ecografía renal}}.",
      "extra": "Riñones pequeños y sin diferenciación corticomedular indican cronicidad.",
