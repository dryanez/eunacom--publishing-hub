    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El síndrome nefrótico es una lesión del {{c1::podocito}} que rompe la barrera de filtración.",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · Todo parte en el podocito",
      "repaso": false,
      "codigos": [
        "1.09.1.022",
        "1.09.4.015"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Edema nefrótico: blando, con fóvea, matinal en {{c1::párpados y cara}} y vespertino en {{c2::piernas}}.",
      "extra": "Baja la presión oncótica por la hipoalbuminemia.",
      "origen": "clase:2",
      "fuente": "Clase · Diagnóstico",
      "repaso": false,
      "imagen": "biblioteca/03_nefrologia/nefro-13/01_edema_fovea__bates_p559.jpg",
      "preguntaReal": [
        "EUNACOM Julio 2016 · Pregunta 121"
      ],
      "codigos": [
        "1.09.2.003",
        "1.09.1.022"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Dislipidemia del nefrótico: colesterol total sobre {{c1::350–400 mg/dL}}.",
      "extra": "El hígado hiperproduce VLDL/LDL.",
      "origen": "clase:2",
      "fuente": "Clase · Diagnóstico",
      "repaso": false,
      "codigos": [
        "1.09.1.022",
        "1.09.4.015"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La lipiduria del nefrótico muestra cuerpos ovales grasos con {{c1::cruz de Malta}} bajo luz polarizada.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Criterios",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Diciembre 2022 · Reconstrucción oficial"
      ],
      "codigos": [
        "1.09.1.022",
        "2.01.1.069"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Nefrótico puro: sin {{c1::hematuria}}, sin hipertensión y sin cilindros hemáticos.",
      "extra": "Si hay hematuria dismórfica, piensa en cuadro nefrítico.",
      "origen": "clase:2",
      "fuente": "Clase · Diagnóstico",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Julio 2025 · Pregunta 10",
        "EUNACOM Julio 2016 · Pregunta 121",
        "EUNACOM Julio 2015 · Pregunta 66"
      ],
      "codigos": [
        "1.09.1.022",
        "1.09.4.015"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Edema + proteinuria 8 g + albúmina 2,0 sin hematuria: es nefrótico puro; el error es llamarlo {{c1::nefrítico}}.",
      "extra": "",
      "origen": "clase:11",
      "fuente": "Clase · Tabla de trampas",
      "repaso": false,
      "codigos": [
        "1.09.1.022",
        "1.09.4.015"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El nefrótico pierde por orina {{c1::antitrombina III}}, proteína C y proteína S: queda protrombótico.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Hipercoagulabilidad",
      "repaso": true,
      "codigos": [
        "1.09.1.022",
        "2.01.1.069"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La complicación tromboembólica más frecuente del nefrótico es la trombosis de la {{c1::vena renal}}.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Hipercoagulabilidad",
      "repaso": false,
      "codigos": [
        "1.09.1.022",
        "2.01.1.069"
      ]
    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "La trombosis de vena renal ocurre hasta en el {{c1::30 %}} de los pacientes con nefropatía membranosa.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Hipercoagulabilidad",
      "repaso": false,
      "codigos": [
        "1.09.1.022",
        "1.09.4.015"
      ]
    },
    {
      "id": "c12",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Varicocele izquierdo nuevo que no se reduce en decúbito en un nefrótico: trombosis de {{c1::vena renal izquierda}}.",
      "extra": "La vena espermática izquierda drena en la renal izquierda.",
      "origen": "clase:11",
      "fuente": "Clase · Tabla de trampas",
      "repaso": true,
      "codigos": [
        "1.09.1.022",
        "1.09.4.015"
      ]
    },
    {
      "id": "c13",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Nefrótico con disnea y dolor torácico pleurítico súbitos: {{c1::tromboembolismo pulmonar}}.",
      "extra": "Por pérdida urinaria de antitrombina III.",
      "origen": "clase:11",
      "fuente": "Clase · Tabla de trampas",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Julio 2013 · Pregunta 3"
