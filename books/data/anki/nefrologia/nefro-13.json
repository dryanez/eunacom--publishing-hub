      "codigos": [
        "1.09.1.022",
        "1.09.4.015"
      ]
    },
    {
      "id": "c14",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Nefrótico hospitalizado con derrame pleural hemorrágico, LDH 650 y disnea: es TEP; el error es pensar en {{c1::trasudado por hipoalbuminemia}}.",
      "extra": "El derrame del TEP suele ser exudado hemorrágico.",
      "origen": "clase:16",
      "fuente": "Clase · Quiz TEP",
      "repaso": false,
      "codigos": [
        "1.09.1.022",
        "1.09.4.015"
      ]
    },
