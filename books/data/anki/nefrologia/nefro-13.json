      "id": "c02",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Síndrome nefrótico: albúmina plasmática < {{c1::3,0 g/dL}}.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Diagnóstico",
