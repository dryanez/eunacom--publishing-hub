      "tipo": "Cifra",
      "texto": "Anticoagulación profiláctica en membranosa si la albúmina es < {{c1::2,0–2,5 g/dL}}.",
      "extra": "HBPM o antagonistas de vitamina K.",
      "origen": "clase:3",
      "fuente": "Clase · Hipercoagulabilidad",
      "repaso": true,
      "codigos": [
        "1.09.1.022",
