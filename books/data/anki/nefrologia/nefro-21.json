      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Cistitis: nitrofurantoína {{c1::100 mg c/6 h por 5 días}}; evitar con TFG < 30 mL/min.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Tratamiento de la cistitis",
      "repaso": true,
      "codigos": [
