    {
      "id": "c23",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La cistitis se diagnostica clínicamente; la tira muestra {{c1::leucocito esterasa y nitritos}} positivos.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Cistitis",
      "repaso": false,
      "codigos": [
        "1.09.1.011",
        "4.03.1.015"
      ]
    },
    {
      "id": "c24",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Urocultivo en cistitis solo si hay embarazo, hombre, diabetes, sonda, falla de tratamiento o {{c1::recurrencia}}.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Cistitis",
      "repaso": false,
      "codigos": [
        "1.09.1.011",
        "4.03.1.015"
      ]
    },
    {
