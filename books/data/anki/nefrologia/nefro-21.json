{
  "classId": "nefro-21",
  "cards": [
    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La cistitis compromete solo la mucosa vesical y {{c1::nunca da fiebre}}; si hay fiebre o dolor lumbar es pielonefritis.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Cistitis",
      "repaso": true,
      "codigos": [
        "1.09.1.011",
        "4.03.1.015"
      ]
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "El agente principal de PNA es {{c1::E. coli}} (75–85 %), seguido de Klebsiella y Proteus.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "codigos": [
        "1.09.1.016",
        "1.09.2.011"
      ]
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "La PNA cursa con bacteriemia en el {{c1::20–30 %}} de los casos.",
      "extra": "",
      "origen": "clase:1",
      "fuente": "Clase · De la vejiga al riñón",
      "repaso": false,
      "codigos": [
        "1.09.1.016",
        "1.09.2.011"
      ]
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Tríada de PNA: fiebre > {{c1::38,5 °C}} con calofríos, dolor lumbar con Giordano + y síntomas urinarios bajos.",
      "extra": "Los síntomas bajos pueden faltar en el anciano.",
      "origen": "clase:5",
      "fuente": "Clase · Diagnóstico",
      "repaso": true,
      "codigos": [
        "1.09.1.016",
        "1.09.2.011"
      ]
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Hallazgo del sedimento que certifica origen renal de la infección: {{c1::cilindros leucocitarios}}.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "imagen": "biblioteca/03_nefrologia/nefro-21/02_tipos-de-cilindros__cto-nefro_p34.jpg",
      "codigos": [
        "1.09.1.016",
        "1.09.2.011"
      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "PNA: leucocituria, bacteriuria, microhematuria y {{c1::cilindros leucocitarios}} en el sedimento.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Diagnóstico",
      "repaso": false,
      "imagen": "biblioteca/03_nefrologia/nefro-21/01_sedimento-con-leucocituria__cto-nefro_p33.jpg",
      "codigos": [
        "1.09.1.016",
        "4.03.1.015"
      ]
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "En PNA el urocultivo con antibiograma se toma {{c1::antes del primer antibiótico}}, sin retrasar el tratamiento empírico.",
      "extra": "",
      "origen": "clase:5",
      "fuente": "Clase · Diagnóstico",
      "repaso": true,
      "codigos": [
        "1.09.4.017",
        "1.02.4.025"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Criterio de hospitalización en PNA: {{c1::embarazo}} en cualquier trimestre.",
      "extra": "",
      "origen": "clase:6",
      "fuente": "Clase · Criterios de hospitalización",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Julio 2024 · Pregunta 8"
      ],
      "codigos": [
        "1.09.2.011",
        "1.09.1.016"
      ]
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Otros criterios de hospitalización en PNA: intolerancia oral, sepsis, falla renal u obstrucción, {{c1::inmunosupresión}} o DM descompensada.",
      "extra": "",
      "origen": "clase:6",
      "fuente": "Clase · Criterios de hospitalización",
      "repaso": false,
      "codigos": [
        "1.09.2.011",
        "1.09.1.016"
      ]
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "PNA no complicada ambulatoria: ciprofloxacino {{c1::500 mg c/12 h por 7 días}}.",
      "extra": "Control clínico a las 48–72 h.",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla esquemas PNA",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Julio 2013 · Pregunta 38"
      ],
      "codigos": [
        "1.09.2.011",
        "1.09.1.016"
      ]
    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Alternativa oral en PNA: cefadroxilo o cefixima por {{c1::10 a 14 días}}.",
      "extra": "",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla esquemas PNA",
      "repaso": false,
      "codigos": [
        "1.09.1.016",
        "1.09.2.011"
      ]
    },
    {
      "id": "c12",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "PNA hospitalizada: {{c1::ceftriaxona}} 1–2 g IV c/24 h o cefotaximo 1–2 g IV c/8 h.",
      "extra": "Pasar a oral tras 48 h afebril; total 10 a 14 días.",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla esquemas PNA",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Diciembre 2018 · Pregunta 138"
      ],
      "codigos": [
        "1.09.2.011",
        "1.09.1.016"
      ]
    },
    {
      "id": "c13",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "PNA con sospecha de BLEE o shock séptico: {{c1::ertapenem 1 g/día o meropenem}}.",
      "extra": "",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla esquemas PNA",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Julio 2013 · Pregunta 38"
      ],
      "codigos": [
        "1.09.2.011",
        "1.09.1.016"
      ]
    },
    {
      "id": "c14",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "E. coli resistente a cefalosporinas es BLEE: el tratamiento de elección es un {{c1::carbapenémico}}.",
      "extra": "La nitrofurantoína no alcanza el parénquima renal.",
      "origen": "clase:15",
      "fuente": "Clase · Quiz Jul. 2013",
      "repaso": false,
      "preguntaReal": [
        "EUNACOM Julio 2013 · Pregunta 38"
      ],
      "codigos": [
        "1.09.1.011",
        "4.03.1.015"
      ]
    },
    {
      "id": "c15",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "PNA en el embarazo: se hospitaliza {{c1::siempre}}, en cualquier semana de gestación.",
      "extra": "",
      "origen": "clase:8",
      "fuente": "Clase · PNA en la embarazada",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Julio 2024 · Pregunta 8"
      ],
      "codigos": [
        "1.09.2.011",
        "1.09.1.016"
      ]
    },
    {
      "id": "c16",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "PNA en la embarazada: {{c1::ceftriaxona 1 g/día IV}} por 10 a 14 días.",
      "extra": "Urocultivo de control a los 7 días.",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla esquemas PNA",
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Julio 2024 · Pregunta 8"
      ],
      "codigos": [
        "1.09.4.017",
        "1.02.4.025"
      ]
    },
    {
      "id": "c17",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "En el embarazo el ciprofloxacino está {{c1::contraindicado}} por toxicidad en el cartílago fetal.",
      "extra": "",
      "origen": "clase:8",
      "fuente": "Clase · PNA en la embarazada",
      "repaso": true,
      "codigos": [
        "1.09.2.011",
        "1.09.1.016"
      ]
    },
    {
      "id": "c18",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "La nitrofurantoína no sirve en PNA porque {{c1::no alcanza el parénquima renal}}; es solo para cistitis.",
      "extra": "",
      "origen": "clase:14",
      "fuente": "Clase · Quiz Jul. 2024",
      "repaso": false,
      "codigos": [
        "1.09.1.011",
        "4.03.1.015"
      ]
    },
    {
      "id": "c19",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "PNA que sigue febril a las {{c1::48–72 horas}} con antibiótico adecuado: pedir imagen.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "repaso": true,
      "codigos": [
        "1.09.2.011",
        "1.09.1.016"
      ]
    },
    {
      "id": "c20",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "PNA sin respuesta con germen sensible: pedir {{c1::TAC con contraste}} para descartar absceso u obstrucción.",
      "extra": "",
      "origen": "clase:13",
      "fuente": "Clase · Quiz caso",
      "repaso": true,
      "imagen": "biblioteca/07_nefrologia/nefro-21/05_absceso_renal_tac__nelson_p4209.jpg",
