      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "PNA con litiasis obstructiva: emergencia urológica; se {{c1::descomprime la vía}} (catéter doble J o nefrostomía).",
      "extra": "El cálculo se trata después.",
      "origen": "clase:16",
      "fuente": "Clase · Quiz Ago. 2021",
      "repaso": false,
      "imagen": "biblioteca/03_nefrologia/nefro-21/04_tac-calculos-renales__bailey-love_p1410.jpg",
