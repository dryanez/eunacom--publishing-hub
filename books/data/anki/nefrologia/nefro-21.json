    {
      "id": "c21",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "PNA sin respuesta con germen sensible: el error es {{c1::solo cambiar el antibiótico}}.",
      "extra": "",
      "origen": "clase:9",
      "fuente": "Clase · Si no responde",
