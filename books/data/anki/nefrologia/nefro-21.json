      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Cistitis: fosfomicina {{c1::3 g}} en dosis única.",
      "extra": "",
      "origen": "clase:3",
      "fuente": "Clase · Tratamiento de la cistitis",
      "repaso": true,
      "codigos": [
        "1.09.1.011",
        "4.03.1.015"
      ]
