      ]
    },
    {
      "id": "c33",
      "modelo": "cloze",
      "tipo": "GES",
      "texto": "La hiperkalemia grave se enmarca en la garantía de {{c1::Urgencia Vital}} (Ley de Urgencias).",
      "extra": "",
      "origen": "libro:sec:2",
