      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "La fractura de {{c1::Colles}} (radio distal) es la fractura por fragilidad más precoz en la posmenopáusica.",
      "extra": "Entre los 50 y 65 años.",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Fracturas",
      "repaso": false,
      "codigos": [
        "1.11.1.017",
        "1.03.1.018"
