      ]
    },
    {
      "id": "c27",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Crohn: cualquier segmento, inflamación {{c1::transmural y discontinua}}, con fístulas.",
      "extra": "Fístula perianal, aftas orales.",
