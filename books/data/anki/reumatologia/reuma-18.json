    {
      "id": "c28",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Sospechar EII en artritis o sacroilitis con diarrea de más de {{c1::4 semanas}}, con sangre y moco.",
      "extra": "También tenesmo, baja de peso, fiebre o anemia.",
