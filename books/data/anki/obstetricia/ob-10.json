      "id": "c22",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Toda paciente Rh negativa no sensibilizada con aborto recibe {{c1::inmunoglobulina anti-D}} dentro de las 72 horas.",
      "extra": "",
      "origen": "clase:2",
      "fuente": "Clase · Manejo",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": true
