      "id": "c23",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Dosis de anti-D: {{c1::300 mcg IM}}, o 120 mcg si es < 12 semanas.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Profilaxis Rh",
      "codigos": [
        "3.01.1.001"
      ],
