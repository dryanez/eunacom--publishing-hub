        "EUNACOM Julio 2019 · Pregunta 22"
      ]
    },
    {
      "id": "c11",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Criterio de aborto retenido: saco gestacional (DMSG) {{c1::≥ 25 mm}} sin embrión.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Diciembre 2019 · Pregunta 10",
        "EUNACOM Agosto 2021 · Pregunta 77",
        "EUNACOM Julio 2016 · Pregunta 106"
      ]
    },
    {
      "id": "c12",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Saco gestacional de 18 mm sin embrión (menor a 25 mm): no confirma aborto; {{c1::repetir la ecografía en 7 días}}.",
      "extra": "Puede ser un embarazo normal inicial.",
      "origen": "pregunta_real",
      "fuente": "EUNACOM Dic 2019 · P10",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Diciembre 2019 · Pregunta 10",
        "EUNACOM Agosto 2021 · Pregunta 77",
        "EUNACOM Julio 2016 · Pregunta 106"
      ]
    },
    {
      "id": "c13",
      "modelo": "cloze",
      "tipo": "Trampa",
      "texto": "Embrión de 3 mm sin latidos: aún no cumple criterio de aborto retenido; {{c1::nueva ecografía en 7 días}}.",
      "extra": "",
      "origen": "pregunta_real",
      "fuente": "EUNACOM Jul 2019 · P22",
      "codigos": [
        "3.01.1.001"
