      ]
    },
    {
      "id": "c06",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Aborto en evolución o inevitable: metrorragia con contracciones dolorosas y OCI {{c1::abierto}}.",
      "extra": "Membranas íntegras (evolución) o rotas (inevitable).",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Aborto en evolución",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": false
    },
    {
      "id": "c07",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Aborto incompleto: OCI {{c1::abierto}} con restos ovulares heterogéneos y endometrio engrosado (> 15 mm).",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": true,
      "preguntaReal": [
        "EUNACOM Julio 2024 · Pregunta 20"
      ]
    },
    {
      "id": "c08",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Aborto completo: OCI cerrado, útero contraído y línea endometrial {{c1::fina y lineal (< 8-10 mm)}}.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": false
    },
    {
      "id": "c09",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Conducta en el aborto completo: {{c1::observación ambulatoria}} y control.",
      "extra": "",
      "origen": "libro:tabla",
      "fuente": "Libro · tabla de formas de aborto",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": false
    },
    {
      "id": "c10",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Criterio de aborto retenido: LCN {{c1::≥ 7 mm}} sin latidos cardíacos.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": true,
