    {
      "id": "c01",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Aborto: interrupción del embarazo antes de las {{c1::20 semanas}} o con peso fetal menor a 500 g.",
      "extra": "",
      "origen": "libro:sec:1",
      "fuente": "Libro · ¿Por qué?",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": false
    },
    {
      "id": "c02",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Primera pista para clasificar el aborto: el estado del {{c1::orificio cervical interno (OCI)}}, cerrado o abierto.",
      "extra": "Después, la ecografía transvaginal.",
      "origen": "clase:1",
      "fuente": "Clase · El cuello es tu primera pista",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": true
    },
    {
      "id": "c03",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Amenaza de aborto: metrorragia con OCI {{c1::cerrado}} y embrión con LCF positivos en la ecografía.",
      "extra": "",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": true
    },
    {
      "id": "c04",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Manejo de la amenaza de aborto: reposo relativo, abstinencia sexual y {{c1::descartar patología infecciosa cervical o urinaria}}.",
      "extra": "No hay beneficio de progesterona de rutina.",
      "origen": "libro:sec:1",
      "fuente": "Libro §1 Amenaza de aborto",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": false
    },
    {
      "id": "c05",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Amenaza de aborto con cuello cerrado y ecografía normal (saco < 18 mm): {{c1::controlar con nueva ecografía en 7 días}}.",
      "extra": "",
      "origen": "pregunta_real",
      "fuente": "EUNACOM Dic 2017 · P159",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": false,
      "preguntaReal": [
