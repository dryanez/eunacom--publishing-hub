      ]
    },
    {
      "id": "c14",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Embrión de 9 mm sin latidos con cuello cerrado: {{c1::aborto retenido}}; se ofrece misoprostol o AMEU.",
      "extra": "",
      "origen": "clase:11",
      "fuente": "Clase · Quiz caso clínico",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": false
    },
    {
      "id": "c15",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Tratamiento médico del aborto < 12 semanas, estable: {{c1::misoprostol}}.",
      "extra": "Análogo de PGE1.",
      "origen": "clase:2",
      "fuente": "Clase · Manejo",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": true
    },
    {
      "id": "c16",
      "modelo": "cloze",
      "tipo": "Farmaco",
      "texto": "Misoprostol en el aborto: {{c1::800 mcg}} por vía vaginal o sublingual.",
      "extra": "Segunda dosis a las 24 horas si no hay expulsión.",
      "origen": "libro:puntos",
      "fuente": "Libro · Puntos clave",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": true
    },
    {
      "id": "c17",
      "modelo": "cloze",
      "tipo": "Cifra",
      "texto": "Éxito del misoprostol en el aborto: {{c1::> 85-90%}}.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Manejo farmacológico",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": false
    },
    {
      "id": "c18",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El misoprostol puede causar fiebre autolimitada {{c1::< 38°C}}, cólicos, náuseas y diarrea.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Efectos adversos",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": false
    },
    {
      "id": "c19",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Método quirúrgico de elección en embarazos ≤ 12 semanas: {{c1::AMEU}}, mejor que el legrado instrumental.",
      "extra": "Menos perforación y menos sinequias (Asherman).",
      "origen": "clase:2",
      "fuente": "Clase · Manejo",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": true
    },
    {
      "id": "c20",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "El legrado uterino instrumental se reserva para úteros {{c1::> 12 semanas}}, sangrado masivo o falta de aspiración.",
      "extra": "",
      "origen": "libro:sec:2",
      "fuente": "Libro §2 Manejo quirúrgico",
      "codigos": [
        "3.01.1.001"
      ],
      "repaso": false
    },
    {
      "id": "c21",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "Aborto con metrorragia importante, hipotensión y taquicardia: {{c1::vaciamiento uterino}} urgente.",
      "extra": "",
      "origen": "pregunta_real",
      "fuente": "EUNACOM Ene 2023 · P48",
      "codigos": [
        "3.01.1.001"
      ],
