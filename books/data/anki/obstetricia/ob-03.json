      ]
    },
    {
      "id": "c31",
      "modelo": "cloze",
      "tipo": "Concepto",
      "texto": "RBNE no reactivo con bolsillo de líquido de 1 × 1 cm en embarazo de 36 semanas con cesárea previa y Bishop 3: {{c1::interrumpir por cesárea}}.",
      "extra": "Hipoxia crónica con cuello desfavorable.",
