   "origen": "libro:puntos",
   "fuente": "Libro · Puntos clave",
   "repaso": true,
   "codigos": [
    "1.05.1.036",
    "1.05.3.003"
   ]
  },
  {
   "id": "c20",
   "modelo": "cloze",
   "tipo": "Farmaco",
   "texto": "En TBC meníngea se asocian {{c1::corticoides}} (dexametasona o prednisona) las primeras 6 a 8 semanas.",
