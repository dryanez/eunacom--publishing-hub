  {
   "id": "c07",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "El GeneXpert detecta M. tuberculosis en menos de {{c1::2 horas}}.",
   "extra": "",
   "origen": "libro:puntos",
   "fuente": "Libro · Puntos clave",
   "repaso": true,
   "codigos": [
    "1.04.4.015"
