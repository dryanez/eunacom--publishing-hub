  {
   "id": "c05",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "El tratamiento se da bajo modalidad {{c1::DOTS / TAES}} (observado) en el centro de salud.",
   "extra": "Asegura adherencia y previene resistencias.",
