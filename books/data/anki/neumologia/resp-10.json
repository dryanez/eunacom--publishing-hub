   "origen": "clase:3",
   "fuente": "Clase · Tres exámenes",
   "repaso": false,
   "codigos": [
    "1.04.4.007"
   ]
  },
  {
   "id": "c15",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Esquema primario del caso nuevo sensible: {{c1::2 RHZE + 4 RH}}.",
   "extra": "",
   "origen": "libro:puntos",
   "fuente": "Libro · Puntos clave",
   "repaso": true,
   "codigos": [
    "1.05.1.036",
    "1.05.3.003"
   ]
  },
  {
   "id": "c16",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Duración total del esquema primario en TBC pulmonar: {{c1::6 meses}}.",
   "extra": "",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Tratamiento",
   "repaso": true,
   "codigos": [
    "1.05.1.036",
    "1.05.3.003"
   ]
  },
  {
   "id": "c17",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Fase inicial: {{c1::2 meses}} (50 dosis diarias) con 4 fármacos.",
   "extra": "",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Tratamiento",
   "repaso": false,
   "codigos": [
    "1.05.1.036",
    "1.05.3.003"
   ]
  },
  {
   "id": "c18",
   "modelo": "cloze",
   "tipo": "Farmaco",
   "texto": "Fase de continuación (4 meses, 100 dosis): {{c1::rifampicina + isoniazida}}.",
   "extra": "",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Tratamiento",
   "repaso": false,
   "codigos": [
    "1.05.1.036",
    "1.05.3.003"
   ]
  },
  {
   "id": "c19",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "TBC meníngea u osteoarticular: tratamiento total de {{c1::12 meses}} (2 RHZE + 10 RH).",
