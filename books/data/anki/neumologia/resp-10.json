   ]
  },
  {
   "id": "c11",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "La baciloscopía se pide en {{c1::2 muestras}} de esputo: una inmediata y otra matinal en ayunas al día siguiente.",
   "extra": "",
   "origen": "libro:sec:2",
   "fuente": "Libro §2 Baciloscopías",
   "repaso": true,
   "codigos": [
    "1.05.4.004"
   ],
