   "fuente": "Clase · Formas especiales",
   "repaso": false,
   "codigos": [
    "1.05.1.036"
   ]
  },
  {
   "id": "c21",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "TBC pleural: {{c1::6 meses}} sin cambios de esquema; exudado linfocítico con ADA > 40.",
