  },
  {
   "id": "c02",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La TBC en Chile tiene {{c1::GES}}: diagnóstico, tratamiento y seguimiento gratuitos para todos, independiente de la previsión.",
   "extra": "",
