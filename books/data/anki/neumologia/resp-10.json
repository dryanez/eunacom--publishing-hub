  },
  {
   "id": "c06",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Método de elección inicial normado por MINSAL para diagnóstico de TBC: {{c1::GeneXpert MTB/RIF}} (PCR en tiempo real).",
   "extra": "",
   "origen": "libro:sec:2",
   "fuente": "Libro §2 Diagnóstico molecular",
