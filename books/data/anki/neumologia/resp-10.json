   ]
  },
  {
   "id": "c10",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Una baciloscopía negativa {{c1::no descarta}} TBC: se espera cultivo, TAC o broncoscopía.",
   "extra": "",
   "origen": "clase:24",
   "fuente": "Clase · Reglas de oro",
