   "fuente": "Clase · Tres exámenes",
   "repaso": true,
   "codigos": [
    "1.04.4.015"
   ]
  },
  {
   "id": "c09",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Con baciloscopías negativas y alta sospecha de TBC (hemoptisis, baja de peso), el siguiente examen es la {{c1::PCR para M. tuberculosis}}.",
   "extra": "",
   "origen": "algoritmo",
   "fuente": "Algoritmo",
   "repaso": true,
   "codigos": [
    "1.04.4.015",
