   ]
  },
  {
   "id": "c23",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Adulto fumador con disnea progresiva, baja de peso y derrame pleural: se sospecha {{c1::derrame pleural maligno}}.",
   "extra": "",
   "origen": "algoritmo",
   "fuente": "Algoritmo",
