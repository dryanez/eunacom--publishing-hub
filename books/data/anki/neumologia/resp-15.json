   "codigos": [
    "1.05.1.010"
   ]
  },
  {
   "id": "c26",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Primera medida paliativa de la disnea por derrame maligno: {{c1::toracocentesis evacuadora}} SOS.",
