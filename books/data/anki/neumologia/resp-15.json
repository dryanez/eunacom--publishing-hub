  {
   "id": "c01",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Exudado pleural con > {{c1::50%}} de linfocitos y escasas células mesoteliales: sospechar TBC o cáncer.",
   "extra": "",
   "origen": "libro:sec:1",
   "fuente": "Libro §1 Exudado linfocítico",
   "repaso": true,
   "codigos": [
    "1.05.1.013",
    "1.05.1.010"
   ]
  },
  {
   "id": "c02",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Las dos primeras sospechas del exudado linfocítico son {{c1::tuberculosis pleural y derrame neoplásico}}.",
   "extra": "",
   "origen": "clase:1",
   "fuente": "Clase · Exudado linfocítico",
   "repaso": true,
   "codigos": [
    "1.05.1.013",
    "1.05.1.010"
   ]
  },
  {
   "id": "c03",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Otras causas más lejanas de exudado linfocítico: linfoma y {{c1::pleuritis reumatoidea}}.",
   "extra": "",
   "origen": "libro:sec:1",
   "fuente": "Libro §1",
   "repaso": false,
   "codigos": [
    "1.05.1.010"
   ]
  },
  {
   "id": "c04",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La pleuritis tuberculosa ocurre por rotura de un {{c1::foco caseoso subpleural}} con hipersensibilidad retardada.",
   "extra": "",
   "origen": "libro:sec:2",
   "fuente": "Libro §2 Pleuritis TBC",
   "repaso": false,
   "codigos": [
    "1.05.1.013"
   ]
  },
  {
   "id": "c05",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Paciente típico de pleuritis TBC: adulto joven con fiebre, tos seca y {{c1::dolor pleurítico}}.",
   "extra": "",
   "origen": "libro:sec:2",
   "fuente": "Libro §2 Pleuritis TBC",
   "repaso": false,
   "codigos": [
    "1.05.1.013"
   ]
  },
  {
   "id": "c06",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "ADA en líquido pleural ≥ {{c1::40 U/L}} orienta a tuberculosis pleural.",
   "extra": "",
   "origen": "libro:puntos",
   "fuente": "Libro · Puntos clave",
   "repaso": true,
   "codigos": [
    "1.05.1.013"
   ]
  },
  {
   "id": "c07",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "El ADA ≥ 40 U/L tiene sensibilidad y especificidad > {{c1::90–95%}} para TBC pleural.",
   "extra": "",
   "origen": "libro:sec:2",
   "fuente": "Libro §2 Pleuritis TBC",
   "repaso": false,
   "codigos": [
    "1.05.1.013"
   ]
  },
  {
   "id": "c08",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La TBC pleural es una reacción {{c1::paucibacilar}} inmunológica: hay pocos bacilos.",
   "extra": "",
   "origen": "libro:sec:2",
   "fuente": "Libro §2 Pleuritis TBC",
   "repaso": false,
   "codigos": [
    "1.05.1.013"
   ]
  },
  {
   "id": "c09",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Baciloscopía directa del líquido pleural en TBC: rendimiento < {{c1::10%}}.",
   "extra": "",
   "origen": "libro:puntos",
   "fuente": "Libro · Puntos clave",
   "repaso": true,
   "codigos": [
    "1.05.1.013"
   ]
  },
  {
   "id": "c10",
   "modelo": "cloze",
   "tipo": "Trampa",
   "texto": "Una baciloscopía negativa del líquido pleural {{c1::no descarta}} TBC pleural.",
   "extra": "",
   "origen": "clase:15",
   "fuente": "Clase · Reglas de oro",
   "repaso": true,
   "codigos": [
    "1.05.1.013"
   ]
  },
  {
   "id": "c11",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Confirmación de TBC pleural: {{c1::biopsia pleural con aguja}} (Cope o Abrams).",
   "extra": "",
   "origen": "libro:sec:2",
   "fuente": "Libro §2 Pleuritis TBC",
   "repaso": true,
   "codigos": [
    "1.05.1.013",
    "1.05.5.002"
   ]
  },
  {
   "id": "c12",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La biopsia de TBC pleural muestra granulomas con {{c1::necrosis caseosa}}.",
   "extra": "",
   "origen": "libro:tabla",
   "fuente": "Libro · tabla TBC vs neoplásico",
   "repaso": true,
   "codigos": [
    "1.05.1.013",
    "1.05.5.002"
   ]
  },
  {
   "id": "c13",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "La biopsia con aguja demuestra granulomas en más del {{c1::80%}} de los casos.",
   "extra": "",
   "origen": "libro:sec:2",
   "fuente": "Libro §2 Pleuritis TBC",
   "repaso": false,
   "codigos": [
    "1.05.1.013",
    "1.05.5.002"
   ]
  },
  {
   "id": "c14",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La pleuritis tuberculosa se trata con esquema {{c1::RHZE}} habitual.",
   "extra": "",
   "origen": "libro:sec:2",
   "fuente": "Libro §2 Pleuritis TBC",
   "repaso": true,
   "codigos": [
    "1.05.1.013"
   ]
  },
  {
   "id": "c15",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Líquido de la TBC pleural: amarillo cetrino o {{c1::serofibrinoso}}.",
   "extra": "",
   "origen": "libro:tabla",
   "fuente": "Libro · tabla TBC vs neoplásico",
   "repaso": false,
   "codigos": [
    "1.05.1.013"
   ]
  },
  {
   "id": "c16",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Líquido del derrame neoplásico: {{c1::serohemático o hemorrágico}}.",
   "extra": "",
   "origen": "libro:tabla",
   "fuente": "Libro · tabla TBC vs neoplásico",
   "repaso": true,
   "codigos": [
    "1.05.1.010"
   ]
  },
  {
   "id": "c17",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Derrame neoplásico: adulto mayor de {{c1::50–60 años}}, ADA bajo.",
   "extra": "",
   "origen": "clase:8",
   "fuente": "Clase · Tabla de trampas",
   "repaso": true,
   "codigos": [
    "1.05.1.010"
   ],
