  },
  {
   "id": "c18",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "ADA bajo en derrame neoplásico: < {{c1::40 U/L}}.",
   "extra": "Excepción rara: linfomas.",
   "origen": "clase:8",
   "fuente": "Clase · Tabla de trampas",
   "repaso": true,
   "codigos": [
    "1.05.1.010"
   ]
  },
  {
   "id": "c19",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Causa más común de derrame maligno: {{c1::adenocarcinoma de pulmón}}; también mama, linfoma y mesotelioma.",
   "extra": "",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Derrame maligno",
   "repaso": true,
   "codigos": [
    "1.05.1.010"
   ],
   "preguntaReal": [
    "EUNACOM Julio 2013 · Pregunta 120",
    "EUNACOM Julio 2019 · Pregunta 116"
   ]
  },
  {
   "id": "c20",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "La citología del líquido pleural diagnostica el {{c1::60%}} de los derrames malignos en la primera muestra.",
   "extra": "",
   "origen": "libro:puntos",
   "fuente": "Libro · Puntos clave",
   "repaso": true,
   "codigos": [
    "1.05.1.010"
   ]
  },
  {
   "id": "c21",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "Con una segunda muestra de citología la sensibilidad sube a {{c1::80–85%}}.",
   "extra": "",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Derrame maligno",
   "repaso": false,
   "codigos": [
    "1.05.1.010"
   ]
  },
  {
   "id": "c22",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Citología negativa y sospecha persistente: biopsia pleural por {{c1::videotoracoscopía (VATS)}}.",
   "extra": "Gold standard definitivo.",
   "origen": "libro:sec:3",
   "fuente": "Libro §3 Derrame maligno",
