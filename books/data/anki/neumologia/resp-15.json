   ]
  },
  {
   "id": "c28",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Alternativa a la pleurodesis: catéter pleural tunelizado ({{c1::PleurX}}) con drenaje domiciliario.",
