   ]
  },
  {
   "id": "c24",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Derrame linfocítico con pH normal y mononucleares en fumador de 68 años: lo más probable es {{c1::cáncer bronquial}}.",
   "extra": "",
   "origen": "algoritmo",
   "fuente": "Algoritmo",
