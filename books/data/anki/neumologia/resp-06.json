  {
   "id": "c01",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "NAC es la infección aguda del parénquima adquirida fuera del hospital o en las primeras {{c1::48 horas}} del ingreso.",
   "extra": "",
   "origen": "clase:1",
   "fuente": "Clase · Definición",
   "repaso": true,
   "codigos": [
    "1.05.1.027"
   ]
  },
  {
   "id": "c02",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La NAC es la primera causa de {{c1::muerte infecciosa}} en adultos mayores en Chile.",
   "extra": "",
   "origen": "clase:1",
   "fuente": "Clase · Por qué importa",
   "repaso": false,
   "codigos": [
    "1.05.1.027"
   ]
  },
  {
   "id": "c03",
   "modelo": "cloze",
   "tipo": "GES",
   "texto": "GES de NAC: personas de {{c1::65 años y más}}, con confirmación radiológica.",
   "extra": "",
   "origen": "clase:1",
   "fuente": "Clase · GES",
   "repaso": true,
   "codigos": [
    "1.05.1.027"
   ]
  },
  {
   "id": "c04",
   "modelo": "cloze",
   "tipo": "GES",
   "texto": "GES de NAC: antibiótico en menos de {{c1::24 horas}} desde el ingreso.",
   "extra": "",
   "origen": "clase:1",
   "fuente": "Clase · GES",
   "repaso": true,
   "codigos": [
    "1.05.1.027"
   ]
  },
  {
   "id": "c05",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La bronquitis aguda es casi siempre {{c1::viral}}, con tos < 3 semanas y radiografía normal.",
   "extra": "",
   "origen": "clase:2",
   "fuente": "Clase · Bronquitis aguda",
   "repaso": true,
   "codigos": [
    "1.05.1.005"
   ],
   "preguntaReal": [
    "EUNACOM Agosto 2021 · Pregunta 153"
   ]
  },
  {
   "id": "c06",
   "modelo": "cloze",
   "tipo": "Trampa",
   "texto": "En la bronquitis aguda los antibióticos {{c1::no están indicados}}: no acortan la enfermedad.",
   "extra": "",
   "origen": "clase:2",
   "fuente": "Clase · Bronquitis aguda",
   "repaso": true,
   "codigos": [
    "1.05.1.005"
   ]
  },
  {
   "id": "c07",
   "modelo": "cloze",
   "tipo": "Trampa",
   "texto": "Flema purulenta en bronquitis aguda {{c1::no significa infección bacteriana}}.",
   "extra": "",
   "origen": "clase:2",
   "fuente": "Clase · Bronquitis aguda",
   "repaso": false,
   "codigos": [
    "1.05.1.005"
   ]
  },
  {
   "id": "c08",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "La NAC se separa de la bronquitis por taquicardia, taquipnea, fiebre y signos de {{c1::condensación}}.",
   "extra": "",
   "origen": "clase:2",
   "fuente": "Clase · Cómo se separa de la NAC",
   "repaso": false,
   "codigos": [
    "1.05.1.005"
   ]
  },
  {
   "id": "c09",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Bronquitis con tos > 3 semanas: se reevalúa por tos ferina, asma o {{c1::reflujo}}.",
   "extra": "",
   "origen": "clase:2",
   "fuente": "Clase · Bronquitis aguda",
   "repaso": false,
   "codigos": [
    "1.05.1.005"
   ]
  },
  {
   "id": "c10",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "El germen bacteriano más frecuente de NAC en todas las edades es el {{c1::Streptococcus pneumoniae}}.",
   "extra": "",
   "origen": "clase:3",
   "fuente": "Clase · Etiología",
   "repaso": true,
   "codigos": [
    "1.05.1.027"
   ],
   "preguntaReal": [
    "EUNACOM Julio 2017 · Pregunta 52"
   ]
  },
  {
   "id": "c11",
   "modelo": "cloze",
   "tipo": "Cifra",
   "texto": "El neumococo causa más del {{c1::50%}} de las neumonías bacterianas.",
   "extra": "",
   "origen": "clase:3",
   "fuente": "Clase · Etiología",
   "repaso": false,
   "codigos": [
    "1.05.1.027"
   ]
  },
  {
   "id": "c12",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "En el joven sano destacan {{c1::Mycoplasma}} y los virus respiratorios.",
   "extra": "",
   "origen": "clase:3",
   "fuente": "Clase · Etiología",
   "repaso": true,
   "codigos": [
    "1.05.1.027"
   ],
