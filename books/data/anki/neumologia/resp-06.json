   "origen": "clase:3",
   "fuente": "Clase · Etiología",
   "repaso": true,
   "codigos": [
    "1.05.1.027"
   ]
  },
  {
   "id": "c15",
   "modelo": "cloze",
   "tipo": "Trampa",
   "texto": "Sin radiografía no hay NAC: se exige {{c1::infiltrado nuevo}} (condensación, broncograma aéreo o intersticial).",
