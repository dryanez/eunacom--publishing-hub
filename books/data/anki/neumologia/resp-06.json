    "EUNACOM Agosto 2021 · Pregunta 153",
    "EUNACOM Julio 2013 · Pregunta 107",
    "EUNACOM Diciembre 2017 · Pregunta 15"
   ]
  },
  {
   "id": "c13",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "En el mayor, fumador o EPOC se asocian {{c1::H. influenzae y Moraxella}}.",
   "extra": "",
   "origen": "clase:3",
   "fuente": "Clase · Etiología",
   "repaso": true,
   "codigos": [
    "1.05.1.027"
   ],
   "preguntaReal": [
    "EUNACOM Julio 2019 · Pregunta 105",
    "EUNACOM Julio 2015 · Pregunta 139",
    "EUNACOM Julio 2017 · Pregunta 153"
   ]
  },
  {
   "id": "c14",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "Con demencia o trastorno deglutorio se sospecha neumonía {{c1::aspirativa}} (anaerobios y gramnegativos).",
