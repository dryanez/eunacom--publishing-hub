  {
   "id": "c01",
   "modelo": "cloze",
   "tipo": "Concepto",
   "texto": "El asma es una enfermedad inflamatoria crónica con síntomas variables y limitación {{c1::variable}} del flujo aéreo espiratorio.",
   "extra": "",
